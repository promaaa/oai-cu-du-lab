 /*! \brief Set frequencies (TX/RX). Spawns a thread to handle the frequency change to not block the calling thread
  * \param device the hardware to use
  * \param openair0_cfg RF frontend parameters set by application
@@ -852,6 +853,52 @@ int trx_usrp_set_freq(openair0_device_t *device, openair0_config_t *openair0_cfg
   return(0);
 }
 
+/* Soft stream reset: stop RX/TX streaming, retune, restart.
+ * Does NOT destroy or recreate the UHD device.
+ * Call this instead of trx_usrp_end + trx_usrp_start when only
+ * a frequency change is needed.
+ */
+int trx_usrp_soft_reset(openair0_device_t *device, openair0_config_t *openair0_cfg)
+{
+   usrp_state_t *s = (usrp_state_t *)device->priv;
+  AssertFatal(s != NULL, "%s() called on uninitialized USRP\n", __func__);
+         
+if (usrp_tx_thread != 0) {
+    openair0_thread_t *wt = &device->write_thread;
+    int waited = 0;
+    pthread_mutex_lock(&wt->mutex_write);
+    while (wt->count_write > 0 && waited < 100) {
+      pthread_mutex_unlock(&wt->mutex_write);
+      usleep(1000);
+      waited++;
+      pthread_mutex_lock(&wt->mutex_write);
+    }
+    pthread_mutex_unlock(&wt->mutex_write);
+  }
+  
+  // Step 1: Stop streaming
+  trx_usrp_send_end_of_burst(s);
+  trx_usrp_finish_rx(s);
+  usleep(10000); 
+
+  // Step 2: Retune TX and RX
+  trx_usrp_set_freq(device, openair0_cfg);
+
+  // Step 3: Another short settle — wait for LO lock after retune
+  usleep(10000);
+
+  // Step 4: Reset internal stream state counters
+  s->rx_count = 0;
+  s->tx_count = 0;
+  s->rx_timestamp = 0;
+  s->wait_for_first_pps = 1;
+
+
+  // // Step 5: Restart RX streaming
+
+  return trx_usrp_start(device);
+}
