+static void nr_rrc_sib8_conclude(NR_UE_RRC_INST_t *rrc, bool verified)
+{
+  sib8_verification_t *ccv = &rrc->sib8_verif;
+  NR_UE_RRC_SI_INFO *SI_info = &rrc->perNB[0].SInfo;
+
+  
+  nr_mac_rrc_message_t rrc_msg = {0};
+  rrc_msg.payload_type = NR_MAC_RRC_SIB8_SCAN_STOP;
+  rrc_msg.payload.sib8_scan_stop.excl = verified ? -1 : (int32_t)ccv->serving_Nid_cell;
+  nr_rrc_send_msg_to_mac(rrc, &rrc_msg);
+
+  nr_rrc_going_to_IDLE(rrc, OTHER, NULL);
+  ccv->active = false;
+  if (verified) {
+    LOG_A(NR_RRC, "SIB8 alert accepted as legitimate.\n");
+    SI_info->sib8_validity = true;
+    nr_timer_start(&SI_info->sib8_timer);  
+  } else {
+    LOG_A(NR_RRC, "SIB8 alert flagged as potentially spoofed.\n");
+  }
+}
+
+static void nr_rrc_sib8_evaluate(NR_UE_RRC_INST_t *rrc)
+{
+  sib8_verification_t *ccv = &rrc->sib8_verif;
+
+  int matches = 0;
+  for (int i = 0; i < ccv->cells_scanned; i++) {
+    if (ccv->cells[i].result == SIB8_CELL_PRESENT &&
+        memcmp(ccv->cells[i].hash, ccv->serving_hash, SIB8_HASH_LEN) == 0) {
+      matches++;
+    }
+  }
+
+  bool enough_cells  = (ccv->cells_scanned >= SIB8_MAX_SCAN_CELLS);
+  bool enough_match  = (matches >= SIB8_TARGET_CELLS);
+
+  if (enough_match) {
+    LOG_A(NR_RRC,
+          "SIB8 VERIFIED: %d/%d neighbor cells confirm the same SIB8 content.\n",
+          matches, ccv->cells_scanned);
+    nr_rrc_sib8_conclude(rrc, true);
+    return;
+  } else if (enough_cells || ccv->timer_expired) {
+    LOG_A(NR_RRC,
+          "SIB8 UNVERIFIED (possible spoofing): %d/%d matching cells.\n",
+          matches, ccv->cells_scanned);
+    nr_rrc_sib8_conclude(rrc, false);
+    return;
+  }
+
+  uint8_t  n_excl = 0;
+  uint16_t excl[SIB8_MAX_SCAN_CELLS + 1];
+  excl[n_excl++] = ccv->serving_Nid_cell;
+  for (int i = 0; i < ccv->cells_scanned; i++) {
+    excl[n_excl++] = ccv->cells[i].Nid_cell;
+  }
+
+  nr_mac_rrc_message_t rrc_msg = {0};
+  rrc_msg.payload_type = NR_MAC_RRC_SIB8_SCAN_NEXT;
+  rrc_msg.payload.sib8_scan_next.n_excl = n_excl;
+  memcpy(rrc_msg.payload.sib8_scan_next.excl, excl, n_excl * sizeof(uint16_t));
+  nr_rrc_send_msg_to_mac(rrc, &rrc_msg);
+
+}
+
+static void nr_rrc_sib8_record_cell(NR_UE_RRC_INST_t *rrc,
+                                    NR_SIB8_t *sib8,
+                                    bool sib8_present)
+{
+  sib8_verification_t *ccv = &rrc->sib8_verif;
+  if (!ccv->active) return;
+  if (ccv->cells_scanned >= SIB8_MAX_SCAN_CELLS) return;
+
+  uint16_t cell_pci = rrc->phyCellID;
+
+  if (cell_pci == ccv->serving_Nid_cell) return;
+
+  sib8_cell_entry_t *entry = &ccv->cells[ccv->cells_scanned];
+  entry->Nid_cell = cell_pci;
+
+  if (!sib8_present) {
+    entry->result = SIB8_CELL_ABSENT;
+    LOG_I(NR_RRC, "SIB8 scan: cell PCI=%u has no SIB8\n", cell_pci);
+  } else {
+    uint8_t buf[512];
+    asn_enc_rval_t enc = uper_encode_to_buffer(&asn_DEF_NR_SIB8,
+                                               NULL, sib8, buf, sizeof(buf));
+    AssertFatal(enc.encoded > 0, "SIB8 message hashing failed!\n");
+    SHA256(buf, (enc.encoded + 7) / 8, entry->hash);
+    entry->result = SIB8_CELL_PRESENT;
+    LOG_I(NR_RRC, "SIB8 scan: cell PCI=%u has SIB8 (hash recorded)\n", cell_pci);
+  }
+
+  ccv->cells_scanned++;
+  nr_rrc_sib8_evaluate(rrc);
+}
+
+static void nr_rrc_sib8_start_verification(NR_UE_RRC_INST_t *rrc,
+                                           NR_SIB8_t *sib8)
+{
+  sib8_verification_t *ccv = &rrc->sib8_verif;
+
+  if (ccv->active) {
+    LOG_W(NR_RRC, "SIB8 verification already in progress\n");
+    return;
+  }
+
+  uint8_t buf[512];
+  asn_enc_rval_t enc = uper_encode_to_buffer(&asn_DEF_NR_SIB8,
+                                              NULL, sib8, buf, sizeof(buf));
+  if (enc.encoded < 0) {
+    LOG_E(NR_RRC, "SIB8 encoding for hash failed\n");
+    return;
+  }
+  SHA256(buf, (enc.encoded + 7) / 8, ccv->serving_hash);
+
+  clock_gettime(CLOCK_MONOTONIC, &ccv->start_time);
+
+  ccv->serving_Nid_cell = rrc->phyCellID;
+  ccv->active            = true;
+  ccv->timer_expired = false;
+  ccv->cells_scanned     = 0; 
+  memset(ccv->cells, 0, sizeof(ccv->cells));
+
+  LOG_A(NR_RRC, "SIB8 received: Starting neighbor verification scan "
+        "(serving PCI=%u, need %d matching cells out of max %d)\n",
+        ccv->serving_Nid_cell, SIB8_TARGET_CELLS, SIB8_MAX_SCAN_CELLS);
+
+  uint8_t  n_excl = 0;
+  uint16_t excl[1];
+  excl[n_excl++] = ccv->serving_Nid_cell;
+  
+  
+  nr_mac_rrc_message_t rrc_msg = {0};
+  rrc_msg.payload_type = NR_MAC_RRC_SIB8_SCAN_NEXT;
+  rrc_msg.payload.sib8_scan_next.n_excl = n_excl;
+  memcpy(rrc_msg.payload.sib8_scan_next.excl, excl, n_excl * sizeof(uint16_t));
+  nr_rrc_send_msg_to_mac(rrc, &rrc_msg);
+}
