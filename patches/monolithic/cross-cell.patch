+
+static void ccv_apply_carrier(NR_UE_MAC_INST_t *mac, const ccv_carrier_entry_t *c)
+{
+    fapi_nr_config_request_t *cfg = &mac->phy_config.config_req;
+    fapi_nr_ue_carrier_config_t *cc = &cfg->carrier_config;
+
+    frequency_range_t freq_range = get_freq_range_from_band(c->band);
+
+    mac->nr_band        = c->band;
+    mac->numerology     = c->scs;
+    mac->frequency_range = freq_range;
+
+    cc->dl_frequency = c->dl_frequency; // kHz
+    int bw_idx = get_supported_band_index(c->scs, freq_range, c->N_RB_DL);
+    cc->dl_bandwidth = get_supported_bw_mhz(freq_range, bw_idx);
+    for (int i = 0; i < 5; i++) {
+        cc->dl_grid_size[i] = (i == c->scs) ? c->N_RB_DL : 0;
+        cc->dl_k0[i]        = 0;
+    }
+
+    cc->uplink_frequency = c->dl_frequency;
+    int ul_bw_idx = get_supported_band_index(c->scs, freq_range, c->N_RB_DL);
+    cc->uplink_bandwidth = get_supported_bw_mhz(freq_range, ul_bw_idx);
+    for (int i = 0; i < 5; i++) {
+        cc->ul_grid_size[i] = (i == c->scs) ? c->N_RB_DL : 0;
+        cc->ul_k0[i]        = 0;
+    }
+
+    LOG_I(NR_MAC, "[CCV] Switching to band %d, dl_freq=%u kHz, N_RB=%d\n",
+          c->band, cc->dl_frequency, c->N_RB_DL);
+}
+
+void nr_rrc_mac_stop_sib8_scan(module_id_t module_id, int32_t excl)
+{
+  LOG_I(NR_MAC, "[CCV] nr_rrc_mac_stop_sib8_scan\n");
+  nr_rrc_mac_config_req_reset(module_id, GO_TO_IDLE);
+  NR_UE_MAC_INST_t *mac = get_mac_inst(module_id);
+  
+  ccv_apply_carrier(mac, &mac->saved_carrier);
+
+  mac->ccv_active = false;
+  // mac->state = UE_NOT_SYNC;
+
+  mac->synch_request.Mod_id  = mac->ue_id;
+  fapi_nr_synch_request_t *req = &mac->synch_request.synch_req;
+  req->target_Nid_cell        = -1;  
+  req->ssb_bw_scan            = true;
+  
+  
+  req->n_excl = excl > 0 ? 1 : 0;
+  req->exclude_Nid_cell[0] = (uint16_t)excl;
+  
+
+
+  mac->if_module->synch_request(&mac->synch_request);
+  mac->if_module->phy_config_request(&mac->phy_config); 
+
+  LOG_A(NR_MAC, "SIB8 scan mode deactivated, restarting normal camping\n");
+}
+
+void nr_rrc_mac_sib8_scan_next(module_id_t module_id,
+                                uint16_t *excl,
+                                uint8_t n_excl)
+{
+  NR_UE_MAC_INST_t *mac = get_mac_inst(module_id);
+
+  if(!mac->ccv_active){
+    LOG_A(NR_MAC, "SIB8 scan mode activated.\n");
+    mac->ccv_active        = true;
+    mac->ccv_carrier_idx = -1;
+
+    fapi_nr_ue_carrier_config_t *cfg = &mac->phy_config.config_req.carrier_config;
+
+    mac->saved_carrier.band = mac->nr_band;
+    mac->saved_carrier.scs = mac->numerology;
+    mac->saved_carrier.N_RB_DL = cfg->dl_grid_size[mac->numerology];
+
+    mac->saved_carrier.dl_frequency = cfg->dl_frequency;   
+    LOG_W(MAC, "[CCV] Saved carrier: band=%d scs=%d N_RB_DL=%d dl_freq=%lu\n",
+                mac->saved_carrier.band,
+                mac->saved_carrier.scs,
+                mac->saved_carrier.N_RB_DL,
+                (unsigned long)mac->saved_carrier.dl_frequency);  
+  }
+  nr_rrc_mac_config_req_reset(module_id, GO_TO_IDLE);
+  mac = get_mac_inst(module_id);
+  
+  if(mac->ccv_carrier_idx == CCV_CARRIERS_NUM - 1)
+    mac->ccv_carrier_idx = -1;
+  const ccv_carrier_entry_t *c = &ccv_carrier_table[++mac->ccv_carrier_idx];
+  ccv_apply_carrier(mac, c);
+  mac->if_module->phy_config_request(&mac->phy_config); 
+  
+  /* Issue a synch_request like handle_reconfiguration_with_sync does,
+     but with target_Nid_cell=-1 (blind), and ccv_active is true so MAC will NOT start RACH. */
+  mac->synch_request.Mod_id  = mac->ue_id;
+  fapi_nr_synch_request_t *req = &mac->synch_request.synch_req;
+  req->target_Nid_cell        = -1;  
+  req->ssb_bw_scan            = true;
+  req->n_excl                 = n_excl;
+  memcpy(req->exclude_Nid_cell, excl, n_excl * sizeof(uint16_t));
+
+  mac->if_module->synch_request(&mac->synch_request);
