# Copy to conf/local/lab.env and edit for your machines. The TUI also accepts
# a root .env file or --env=/absolute/path/to/lab.env.
# conf/local/ is ignored by Git.

# SSH assumes key-based auth or an already configured SSH agent.
LAB_SSH_OPTS=-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=8
LAB_SUDO=sudo -n

# Monolithic reference.
MONO_HOST=serber@10.76.170.38
MONO_CN_DIR=/home/serber/monolithic/oai-cn5g
MONO_OAI_DIR=/home/serber/monolithic/openairinterface5g
MONO_GNB_CONF=/home/serber/monolithic/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb.sa.band78.fr1.106PRB.usrpb210.conf
MONO_GNB_RUNTIME_CONF=/tmp/oai-tui-monolithic-b210-runtime.conf
MONO_SIB8_CONF=/home/serber/monolithic/openairinterface5g/sib8.conf
MONO_LOG=/tmp/oai-mono-gnb.log

# Ethernet CU/DU + SIB8 rollback baseline.
CU_HOST=serber@10.76.170.38
DU_HOST=serber@10.76.170.40
DU_LABEL=serber-minipc
MINIPC_HOST=serber@10.76.170.40
JETSON_HOST=serber@10.76.170.8
DU_CONF_NAME=gnb-minipc.conf
DU_ETHERNET_RUNTIME_CONF=/tmp/oai-tui-gnb-minipc-ethernet-runtime.conf
CU_CN_DIR=/home/serber/cu-du-minipc/oai-cn5g-minipc
CU_CN_COMPOSE=docker-compose-minipc.yaml
CU_OAI_DIR=/home/serber/cu-du-minipc-backhaul/source/openairinterface5g
DU_OAI_DIR=/home/serber/cu-du/source/openairinterface5g
CU_ETH_CONF=/home/serber/cu-du-minipc-backhaul/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-cu-minipc.conf
DU_ETH_CONF=/home/serber/cu-du/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-minipc.conf
# Optional per-DU overrides used when switching configurations in one session.
MINIPC_DU_ETH_CONF=/home/serber/cu-du/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-minipc.conf
PI_DU_ETH_CONF=/home/serber/cu-du/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-pi.conf
JETSON_DU_ETH_CONF=/home/serber/cu-du/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-jetson.conf
CU_SIB8_CONF=/home/serber/cu-du-minipc-backhaul/source/openairinterface5g/sib8.conf
DU_SIB8_CONF=/home/serber/cu-du/source/openairinterface5g/sib8.conf
CU_LOG=/tmp/oai-cu-ethernet.log
DU_LOG=/tmp/oai-du-ethernet.log

# Additional DU and test targets.
PI_HOST=serber@10.76.170.18
OAI_PC_HOST=oai-pc
NRUE_HOST=serber@10.76.170.40
NRUE_OAI_DIR=/home/serber/nrue/openairinterface5g
NRUE_CONF=
NRUE_LOG=/tmp/oai-nrue.log

# Wi-Fi GRE overlay parameters for the verified wireless baseline.
GRE_NAME=test-gre
GRE_CU_IP=10.76.170.38
GRE_DU_IP=10.76.170.40
GRE_DU_WIFI_IP=10.85.168.144
GRE_DU_WIFI_GW=10.85.175.254
GRE_CU_INNER_IP=10.255.0.1
GRE_DU_INNER_IP=10.255.0.2
GRE_PREFIX=30
# For Raspberry Pi Wi-Fi benchmarks, set this to the Pi Wi-Fi address if it
# differs from the historical minipc Wi-Fi value above.
PI_WIFI_IP=

# Quectel/WireGuard target. The only supported donor is the firecell monolithic donor gNB.
QUECTEL_IFACE=wwan0
QUECTEL_AT_PORT=
QUECTEL_APN=oai
QUECTEL_REJECT_PLMN_MCC=001
QUECTEL_REJECT_PLMN_MNC=01
QUECTEL_EXPECTED_DONOR_PCI=1
QUECTEL_EXPECTED_DONOR_TAC=2
QUECTEL_TEST_IP=1.1.1.1
# Fixed lab subscriber roles. The TUI auto-detects the phone subscriber from
# the active core DB by suffix and seeds the default lab phone subscriber if
# needed. PHONE_IMSI remains an ignored local override only.
LAB_PHONE_IMSI_SUFFIX=9449
LAB_QUECTEL_IMSI_SUFFIX=9451
PHONE_IMSI=
WG_IF=wg-quectel-f1
WG_CU_IP=10.250.0.1
WG_DU_IP=10.250.0.2
CU_QUECTEL_CONF=/home/serber/cu-du-minipc-backhaul/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-cu-minipc-quectel-backhaul.conf
DU_QUECTEL_CONF=/home/serber/cu-du/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-minipc-quectel-backhaul.conf
MINIPC_DU_QUECTEL_CONF=/home/serber/cu-du/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-minipc-quectel-backhaul.conf
PI_DU_QUECTEL_CONF=/home/serber/cu-du/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-pi-quectel-backhaul.conf
JETSON_DU_QUECTEL_CONF=/home/serber/cu-du/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-jetson-quectel-backhaul.conf
FIRECELL_DONOR_PROD_CONF=/home/serber/monolithic/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-firecell-donor-single-core-51prb.conf
CU_QUECTEL_LOG=/tmp/oai-cu-quectel.log
DU_QUECTEL_LOG=/tmp/oai-du-quectel.log
FIRECELL_DONOR_GNB_LOG=/tmp/oai-firecell-donor-monolithic.log
FIRECELL_DONOR_ATT_TX=24

# Access DU identity. Keep distinct from the donor gNB cell.
ACCESS_GNB_ID=0xe00
ACCESS_DU_ID=0xe01
ACCESS_NR_CELL_ID=12345678
ACCESS_PCI=0
ACCESS_TAC=1
# B210 serials are discovered live on each host. Leave these empty unless an
# individual host has multiple B210 radios and the choice would be ambiguous.
DU_B210_SERIAL_OVERRIDE=
FIRECELL_B210_SERIAL_OVERRIDE=
DONOR_GNB_ID=0xe10
DONOR_NR_CELL_ID=22345678
DONOR_PCI=1
DONOR_TAC=2

# Keep this disabled unless the Quectel modem reaches the CU through the
# firecell monolithic donor gNB, PCI=1/TAC=2. Do not use the minipc access DU.
QUECTEL_INDEPENDENT_DONOR=0

# Match the known-working monolithic/Ethernet access-cell RF profile for the phone.
# The donor runtime is attenuated separately so the caged phone prefers access PCI=0/TAC=1.
ACCESS_ATT_TX=3
ACCESS_ATT_RX=12
ACCESS_ARFCN_SSB=641280
ACCESS_ARFCN_POINTA=640008
