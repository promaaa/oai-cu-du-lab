# Copy to conf/local/lab.env and edit for your machines.
# conf/local/ is ignored by Git.

# SSH assumes key-based auth or an already configured SSH agent.
LAB_SSH_OPTS=-o BatchMode=yes -o ConnectTimeout=8
LAB_SUDO=sudo -n

# Monolithic reference.
MONO_HOST=serber@10.76.170.38
MONO_CN_DIR=/home/serber/monolithic/oai-cn5g
MONO_OAI_DIR=/home/serber/monolithic/openairinterface5g
MONO_GNB_CONF=/home/serber/monolithic/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb.sa.band78.fr1.106PRB.usrpb210.conf
MONO_SIB8_CONF=/home/serber/monolithic/openairinterface5g/sib8.conf
MONO_LOG=/tmp/oai-mono-gnb.log

# Ethernet CU/DU + SIB8 rollback baseline.
CU_HOST=serber@10.76.170.38
DU_HOST=serber@10.76.170.100
CU_CN_DIR=/home/serber/cu-du-minipc/oai-cn5g-minipc
CU_CN_COMPOSE=docker-compose-minipc.yaml
CU_OAI_DIR=/home/serber/cu-du-minipc-backhaul/source/openairinterface5g
DU_OAI_DIR=/home/serber/cu-du/source/openairinterface5g
CU_ETH_CONF=/home/serber/cu-du-minipc-backhaul/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-cu-minipc.conf
DU_ETH_CONF=/home/serber/cu-du/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-minipc.conf
CU_SIB8_CONF=/home/serber/cu-du-minipc-backhaul/source/openairinterface5g/sib8.conf
DU_SIB8_CONF=/home/serber/cu-du/source/openairinterface5g/sib8.conf
CU_LOG=/tmp/oai-cu-ethernet.log
DU_LOG=/tmp/oai-du-ethernet.log

# Discovery-only targets. Starts stay disabled until evidence is recorded.
PI_HOST=serber-pi
OAI_PC_HOST=oai-pc
NRUE_HOST=serber@10.76.170.100
NRUE_OAI_DIR=/home/serber/nrue/openairinterface5g
NRUE_CONF=
NRUE_LOG=/tmp/oai-nrue.log

# Wi-Fi GRE overlay parameters for the verified wireless baseline.
GRE_NAME=test-gre
GRE_CU_IP=10.76.170.38
GRE_DU_IP=10.76.170.100
GRE_DU_WIFI_IP=10.85.168.144
GRE_DU_WIFI_GW=10.85.175.254

# Quectel/WireGuard target. The only supported donor is the firecell donor DU.
QUECTEL_IFACE=wwan0
QUECTEL_AT_PORT=
QUECTEL_APN=internet
QUECTEL_REJECT_PLMN_MCC=001
QUECTEL_REJECT_PLMN_MNC=01
QUECTEL_EXPECTED_DONOR_PCI=1
QUECTEL_EXPECTED_DONOR_TAC=2
QUECTEL_TEST_IP=1.1.1.1
WG_IF=wg-quectel-f1
WG_CU_IP=10.250.0.1
WG_DU_IP=10.250.0.2
CU_QUECTEL_CONF=/home/serber/cu-du-minipc-backhaul/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-cu-minipc-quectel-backhaul.conf
DU_QUECTEL_CONF=/home/serber/cu-du/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-minipc-quectel-backhaul.conf
FIRECELL_DONOR_PROD_CONF=/home/serber/monolithic/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-firecell-donor-single-core-51prb.conf
FIRECELL_DONOR_DU_CONF=/home/serber/cu-du-minipc-backhaul/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/gnb-du-firecell-donor-local-f1.conf
CU_QUECTEL_LOG=/tmp/oai-cu-quectel.log
DU_QUECTEL_LOG=/tmp/oai-du-quectel.log
FIRECELL_DONOR_DU_LOG=/tmp/oai-du-firecell-donor-local-f1.log

# Single-CU identity split. Do not duplicate these between DUs.
ACCESS_GNB_ID=0xe00
ACCESS_DU_ID=0xe01
ACCESS_NR_CELL_ID=12345678
ACCESS_PCI=0
ACCESS_TAC=1
ACCESS_B210_SERIAL=8002816
DONOR_GNB_ID=0xe10
DONOR_DU_ID=0xe11
DONOR_NR_CELL_ID=22345678
DONOR_PCI=1
DONOR_TAC=2
LOCAL_DONOR_F1_CU_IP=127.0.0.1
LOCAL_DONOR_F1_DU_IP=127.0.0.2

# Keep this disabled unless the Quectel modem reaches the CU through the
# firecell donor DU, PCI=1/TAC=2. Do not use the minipc access DU or a
# monolithic donor for Quectel backhaul.
QUECTEL_INDEPENDENT_DONOR=0
