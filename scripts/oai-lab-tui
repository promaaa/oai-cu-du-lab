def parse_env_file(path: Path) -> dict[str, str]:
    data: dict[str, str] = {}
    if not path.exists():
        return data
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        data[key.strip()] = value.strip().strip('"').strip("'")
    return data


def load_config() -> dict[str, str]:
    cfg = dict(DEFAULTS)
    cfg.update(parse_env_file(LOCAL_ENV))
    for key in list(cfg):
        if key in os.environ:
            cfg[key] = os.environ[key]
    return cfg


def q(value: str) -> str:
    return shlex.quote(str(value))


def rel(path: Path) -> str:
    try:
        return str(path.relative_to(REPO))
    except ValueError:
        return str(path)


@dataclass
class CommandResult:
    title: str
    host: str
    command: str
    rc: int
    output: str

    def render(self) -> str:
        status = "OK" if self.rc == 0 else f"FAILED rc={self.rc}"
        return f"## {self.title} [{status}]\nHost: {self.host}\nCommand: {self.command}\n\n{self.output.strip()}\n"


class Runner:
    def __init__(self, cfg: dict[str, str], dry_run: bool = False):
        self.cfg = cfg
        self.dry_run = dry_run

    def is_local(self, host: str) -> bool:
        return host in {"", "local", "localhost", "127.0.0.1", os.uname().nodename}

    def host_cmd(self, host: str, cmd: str) -> list[str]:
        if self.is_local(host):
            return ["bash", "-lc", cmd]
        return ["ssh", *shlex.split(self.cfg["LAB_SSH_OPTS"]), host, cmd]

    def run(self, title: str, host: str, cmd: str, timeout: int = 60) -> CommandResult:
        printable = " ".join(shlex.quote(part) for part in self.host_cmd(host, cmd))
        if self.dry_run:
            return CommandResult(title, host, printable, 0, "dry-run: command not executed\n")
        proc = subprocess.run(
            self.host_cmd(host, cmd),
            cwd=REPO,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
        )
        return CommandResult(title, host, printable, proc.returncode, proc.stdout)

    def step(self, results: list[CommandResult], title: str, host: str, cmd: str, timeout: int = 60, required: bool = True) -> bool:
        res = self.run(title, host, cmd, timeout)
        results.append(res)
        return res.rc == 0 or not required


def sudo(cfg: dict[str, str]) -> str:
    return cfg["LAB_SUDO"]


def oai_build_dir(oai_dir: str) -> str:
    return f"{oai_dir}/cmake_targets/ran_build/build"


def docker_compose_cmd(directory: str, compose_file: str | None, action: str) -> str:
    compose = f"-f {q(compose_file)} " if compose_file else ""
    return f"cd {q(directory)} && docker compose {compose}{action}"


def detect_usrp_cmd(cfg: dict[str, str]) -> str:
    s = sudo(cfg)
    return (
        "set -e; "
        "if command -v uhd_find_devices >/dev/null 2>&1; then "
        f"(uhd_find_devices || {s} uhd_find_devices); "
        "else lsusb | grep -Ei 'ettus|usrp|b210|national instruments|ni'; fi"
    )


def reset_usrp_cmd(cfg: dict[str, str]) -> str:
    s = sudo(cfg)
    return (
        "if command -v b2xx_fx3_utils >/dev/null 2>&1; then "
        f"{s} b2xx_fx3_utils -U || true; "
        "elif [ -x /usr/local/lib/uhd/utils/b2xx_fx3_utils ]; then "
        f"{s} /usr/local/lib/uhd/utils/b2xx_fx3_utils -U || true; "
        "fi; sleep 2"
    )


def start_softmodem_cmd(cfg: dict[str, str], oai_dir: str, conf: str, log: str, extra: str = "") -> str:
    build = oai_build_dir(oai_dir)
    s = sudo(cfg)
    inner = f"nohup ./nr-softmodem -O {q(conf)} {extra} > {q(log)} 2>&1 < /dev/null &"
    return (
        "set -e; "
        f"test -x {q(build + '/nr-softmodem')}; test -f {q(conf)}; "
        f"cd {q(build)}; "
        f"{s} pkill -9 -x nr-softmodem 2>/dev/null || true; "
        f"cd {q(build)} && {s} bash -lc {q(inner)}; "
        "sleep 2; pgrep -a nr-softmodem || "
        f"(echo 'nr-softmodem did not start; recent log:'; tail -80 {q(log)} 2>/dev/null; false)"
    )


def stop_softmodem_cmd(cfg: dict[str, str]) -> str:
    return f"{sudo(cfg)} pkill -9 -x nr-softmodem 2>/dev/null || true; pgrep -a nr-softmodem || true"


def status_cmd(cn_dir: str | None = None, compose: str | None = None, log: str | None = None) -> str:
    parts = [
        "hostname",
        "pgrep -a nr-softmodem || true",
        "ip -br addr | sed -n '1,12p'",
    ]
    if cn_dir:
        parts.append(docker_compose_cmd(cn_dir, compose, "ps") + " || true")
    if log:
        parts.append(f"tail -40 {q(log)} 2>/dev/null || true")
    return "; ".join(parts)


def start_monolithic(r: Runner) -> list[CommandResult]:
    c = r.cfg
    host = c["MONO_HOST"]
    results: list[CommandResult] = []
    r.step(results, "Detect USRP", host, detect_usrp_cmd(c), 25)
    r.step(results, "Reset USRP", host, reset_usrp_cmd(c), 20, required=False)
    r.step(results, "Start core", host, docker_compose_cmd(c["MONO_CN_DIR"], None, "up -d"), 90)
    r.step(results, "Start monolithic gNB", host, start_softmodem_cmd(c, c["MONO_OAI_DIR"], c["MONO_GNB_CONF"], c["MONO_LOG"], "-E --continuous-tx"), 35)
    r.step(results, "Status", host, status_cmd(c["MONO_CN_DIR"], None, c["MONO_LOG"]), 25, required=False)
    return results


def stop_monolithic(r: Runner) -> list[CommandResult]:
    c = r.cfg
    host = c["MONO_HOST"]
    results: list[CommandResult] = []
    r.step(results, "Stop monolithic gNB", host, stop_softmodem_cmd(c), 20, required=False)
    r.step(results, "Stop monolithic core", host, docker_compose_cmd(c["MONO_CN_DIR"], None, "down"), 60, required=False)
    return results


def start_ethernet(r: Runner) -> list[CommandResult]:
    c = r.cfg
    results: list[CommandResult] = []
    r.step(results, "Check CU SSH", c["CU_HOST"], "echo connected && hostname", 15)
    r.step(results, "Check DU SSH", c["DU_HOST"], "echo connected && hostname", 15)
    r.step(results, "Detect DU USRP", c["DU_HOST"], detect_usrp_cmd(c), 25)
    r.step(results, "Reset DU USRP", c["DU_HOST"], reset_usrp_cmd(c), 20, required=False)
    r.step(results, "Start core on CU host", c["CU_HOST"], docker_compose_cmd(c["CU_CN_DIR"], c["CU_CN_COMPOSE"], "up -d"), 90)
    r.step(results, "Start CU", c["CU_HOST"], start_softmodem_cmd(c, c["CU_OAI_DIR"], c["CU_ETH_CONF"], c["CU_LOG"], "--log_config.global_log_level info"), 35)
    r.step(results, "Start DU", c["DU_HOST"], start_softmodem_cmd(c, c["DU_OAI_DIR"], c["DU_ETH_CONF"], c["DU_LOG"], "--log_config.global_log_level info -E"), 35)
    r.step(results, "CU status", c["CU_HOST"], status_cmd(c["CU_CN_DIR"], c["CU_CN_COMPOSE"], c["CU_LOG"]), 30, required=False)
    r.step(results, "DU status", c["DU_HOST"], status_cmd(log=c["DU_LOG"]), 30, required=False)
    return results


def stop_ethernet(r: Runner) -> list[CommandResult]:
    c = r.cfg
    results: list[CommandResult] = []
    r.step(results, "Stop DU", c["DU_HOST"], stop_softmodem_cmd(c), 20, required=False)
    r.step(results, "Stop CU", c["CU_HOST"], stop_softmodem_cmd(c), 20, required=False)
    return results


def start_wifi_gre(r: Runner) -> list[CommandResult]:
    c = r.cfg
    s = sudo(c)
    name = q(c["GRE_NAME"])
    cu_ip = q(c["GRE_CU_IP"])
    du_ip = q(c["GRE_DU_IP"])
    du_wifi = q(c["GRE_DU_WIFI_IP"])
    du_gw = q(c["GRE_DU_WIFI_GW"])
    results: list[CommandResult] = []
    cu_cmd = (
        f"{s} ip tunnel del {name} 2>/dev/null || true; "
        f"{s} ip tunnel add {name} mode gre remote {du_wifi} local {cu_ip} ttl 255; "
        f"{s} ip addr add 10.255.0.1/30 dev {name}; {s} ip link set {name} up; "
        f"{s} sysctl -w net.ipv4.conf.{c['GRE_NAME']}.rp_filter=0 >/dev/null; "
        f"{s} ip rule del from {cu_ip} lookup 100 2>/dev/null || true; "
        f"{s} ip route del {du_ip}/32 dev {name} table 100 2>/dev/null || true; "
        f"{s} ip rule add from {cu_ip} lookup 100; {s} ip route add {du_ip}/32 dev {name} table 100; "
        f"ip -s link show {name}"
    )
    du_cmd = (
        f"{s} ip tunnel del {name} 2>/dev/null || true; "
        f"{s} ip tunnel add {name} mode gre remote {cu_ip} local {du_wifi} ttl 255; "
        f"{s} ip addr add 10.255.0.2/30 dev {name}; {s} ip link set {name} up; "
        f"{s} sysctl -w net.ipv4.conf.all.rp_filter=0 >/dev/null; "
        f"{s} sysctl -w net.ipv4.conf.{c['GRE_NAME']}.rp_filter=0 >/dev/null; "
        f"{s} ip route del {cu_ip}/32 via {du_gw} dev wlp3s0 2>/dev/null || true; "
        f"{s} ip route add {cu_ip}/32 via {du_gw} dev wlp3s0; "
        f"{s} ip rule del from {du_ip} lookup 100 2>/dev/null || true; "
        f"{s} ip route del {cu_ip}/32 dev {name} table 100 2>/dev/null || true; "
        f"{s} ip rule add from {du_ip} lookup 100; {s} ip route add {cu_ip}/32 dev {name} table 100; "
        f"ip -s link show {name}"
    )
    r.step(results, "Start GRE on CU host", c["CU_HOST"], cu_cmd, 30)
    r.step(results, "Start GRE on DU host", c["DU_HOST"], du_cmd, 30)
    return results


def stop_wifi_gre(r: Runner) -> list[CommandResult]:
    c = r.cfg
    s = sudo(c)
    name = q(c["GRE_NAME"])
    cu_ip = q(c["GRE_CU_IP"])
    du_ip = q(c["GRE_DU_IP"])
    results: list[CommandResult] = []
    cu_cmd = f"{s} ip rule del from {cu_ip} lookup 100 2>/dev/null || true; {s} ip tunnel del {name} 2>/dev/null || true"
    du_cmd = f"{s} ip rule del from {du_ip} lookup 100 2>/dev/null || true; {s} ip tunnel del {name} 2>/dev/null || true"
    r.step(results, "Stop GRE on DU host", c["DU_HOST"], du_cmd, 20, required=False)
    r.step(results, "Stop GRE on CU host", c["CU_HOST"], cu_cmd, 20, required=False)
    return results


def quectel_preflight(r: Runner) -> list[CommandResult]:
    c = r.cfg
    iface = q(c["QUECTEL_IFACE"])
    wg = q(c["WG_IF"])
    cmd = (
        "hostname; "
        "lsusb | grep -Ei 'quectel|qualcomm|5g|lte|wwan|modem' || true; "
        f"ip -br addr show dev {iface} || true; "
        f"ip route get {q(c['CU_HOST'])} 2>/dev/null || true; "
        f"{sudo(c)} wg show {wg} 2>/dev/null || true"
    )
    results: list[CommandResult] = []
    r.step(results, "Quectel preflight on DU", c["DU_HOST"], cmd, 25, required=False)
    return results


def start_quectel(r: Runner) -> list[CommandResult]:
    c = r.cfg
    results: list[CommandResult] = []
    if c.get("QUECTEL_INDEPENDENT_DONOR") != "1":
        results.append(CommandResult(
            "Quectel safety gate",
            "local",
            "QUECTEL_INDEPENDENT_DONOR=1",
            1,
            "Refusing to start full Quectel F1: the same-cell path is known to be circular. Set QUECTEL_INDEPENDENT_DONOR=1 in conf/local/lab.env only after the modem has an independent donor path.",
        ))
        return results
    results.extend(quectel_preflight(r))
    r.step(results, "Start core on CU host", c["CU_HOST"], docker_compose_cmd(c["CU_CN_DIR"], c["CU_CN_COMPOSE"], "up -d"), 90)
    r.step(results, "Start CU over Quectel/WireGuard", c["CU_HOST"], start_softmodem_cmd(c, c["CU_OAI_DIR"], c["CU_QUECTEL_CONF"], c["CU_QUECTEL_LOG"], "--log_config.global_log_level info"), 35)
    r.step(results, "Start DU over Quectel/WireGuard", c["DU_HOST"], start_softmodem_cmd(c, c["DU_OAI_DIR"], c["DU_QUECTEL_CONF"], c["DU_QUECTEL_LOG"], "--log_config.global_log_level info -E"), 35)
    return results


def lab_status(r: Runner) -> list[CommandResult]:
    c = r.cfg
    results: list[CommandResult] = []
    for label, host, cmd in [
        ("Monolithic host status", c["MONO_HOST"], status_cmd(c["MONO_CN_DIR"], None, c["MONO_LOG"])),
        ("CU host status", c["CU_HOST"], status_cmd(c["CU_CN_DIR"], c["CU_CN_COMPOSE"], c["CU_LOG"])),
        ("DU host status", c["DU_HOST"], status_cmd(log=c["DU_LOG"])),
        ("DU USRP detect", c["DU_HOST"], detect_usrp_cmd(c)),
    ]:
        r.step(results, label, host, cmd, 25, required=False)
    return results


def render_results(results: list[CommandResult]) -> str:
    return "\n\n".join(res.render() for res in results) + "\n"


def read(path: str) -> str:
    p = REPO / path
    return p.read_text(encoding="utf-8") if p.exists() else f"Missing file: {path}\n"


def wrap_block(text: str, width: int = WIDTH) -> str:
    out: list[str] = []
    for line in text.splitlines():
        if not line.strip() or line.startswith((" ", "\t", "|", "#", "-", "*", "```")):
            out.append(line)
        else:
            out.extend(textwrap.wrap(line, width=width, replace_whitespace=False) or [""])
    return "\n".join(out)


def init_local_config(overwrite: bool = False) -> Path:
    LOCAL_ENV.parent.mkdir(parents=True, exist_ok=True)
    if LOCAL_ENV.exists() and not overwrite:
        return LOCAL_ENV
    shutil.copyfile(EXAMPLE_ENV, LOCAL_ENV)
    os.chmod(LOCAL_ENV, 0o600)
    return LOCAL_ENV


def repo_check() -> str:
    checks: list[str] = []
    for cmd, title in [
        (["git", "status", "--short", "--branch"], "Git status"),
        (["git", "diff", "--check"], "Whitespace check"),
    ]:
        proc = subprocess.run(cmd, cwd=REPO, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        checks.append(f"## {title}\n" + ("OK" if proc.returncode == 0 and not proc.stdout else proc.stdout.strip()))
    pattern = "|".join(f"(?:{p})" for p in secret_patterns())
    proc = subprocess.run(["rg", "-n", "-i", "--hidden", "--glob", "!/.git/**", pattern, "."], cwd=REPO, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    checks.append("## Secret-pattern check\n" + ("OK" if proc.returncode == 1 else proc.stdout.strip()))
    return "\n\n".join(checks) + "\n"


def dashboard() -> str:
    cfg = load_config()
    profile = rel(LOCAL_ENV) if LOCAL_ENV.exists() else "missing; run Init local profile"
    return f"""# OAI Lab Operator

This TUI launches the deployed lab modes from one place.

Local profile: {profile}
Sudo mode: {cfg['LAB_SUDO']}
SSH opts: {cfg['LAB_SSH_OPTS']}

Available launch modes:
- Monolithic reference: starts Core + gNB on {cfg['MONO_HOST']} and detects the local USRP.
- Ethernet CU/DU: starts Core/CU on {cfg['CU_HOST']} and DU/USRP on {cfg['DU_HOST']}.
- Wi-Fi GRE overlay: creates the verified GRE/policy-route backhaul, then use Ethernet CU/DU start.
- Quectel/WireGuard F1: safety-gated until an independent donor is configured.

Credentials are not stored in Git. Put local machine overrides in conf/local/lab.env.
"""


def make_experiment(slug: str) -> Path:
    clean = re.sub(r"[^A-Za-z0-9_.-]+", "-", slug.strip()).strip("-").lower() or "experiment"
    today = dt.date.today().isoformat()
    path = REPO / f"experiments/{today}-{clean}.md"
    if path.exists():
        raise FileExistsError(path)
    template = read("experiments/TEMPLATE.md")
    body = template.replace("# Experiment Report", f"# Experiment Report: {clean}")
    body = body.replace("## Date\n", f"## Date\n\n{today}\n")
    path.write_text(body, encoding="utf-8")
    return path


Action = Callable[[Runner], list[CommandResult]]


class Tui:
    def __init__(self, stdscr: curses.window):
        self.stdscr = stdscr
        self.cfg = load_config()
        self.dry_run = False
        self.items: list[tuple[str, Callable[[], str]]] = [
            ("Dashboard", dashboard),
            ("Init local profile", self.init_profile),
            ("Toggle dry-run", self.toggle_dry_run),
            ("Lab status", self.action(lab_status)),
            ("Start monolithic Core + gNB", self.confirmed("start monolithic", start_monolithic)),
            ("Stop monolithic", self.confirmed("stop monolithic", stop_monolithic)),
            ("Start Ethernet CU/DU + SIB8", self.confirmed("start Ethernet CU/DU", start_ethernet)),
            ("Stop Ethernet CU/DU", self.confirmed("stop Ethernet CU/DU", stop_ethernet)),
            ("Start Wi-Fi GRE overlay", self.confirmed("start Wi-Fi GRE overlay", start_wifi_gre)),
            ("Stop Wi-Fi GRE overlay", self.confirmed("stop Wi-Fi GRE overlay", stop_wifi_gre)),
            ("Quectel preflight", self.action(quectel_preflight)),
            ("Start Quectel/WireGuard F1", self.confirmed("start Quectel/WireGuard F1", start_quectel)),
            ("Create experiment report", self.create_experiment_screen),
            ("Repo checks", repo_check),
            ("Baselines", lambda: read("docs/BASELINES.md")),
            ("Config profile example", lambda: read("conf/lab.env.example")),
        ]
        self.pos = 0

    def runner(self) -> Runner:
        self.cfg = load_config()
        return Runner(self.cfg, self.dry_run)

    def action(self, fn: Action) -> Callable[[], str]:
        return lambda: render_results(fn(self.runner()))

    def confirmed(self, label: str, fn: Action) -> Callable[[], str]:
        def inner() -> str:
            if not self.ask_yes_no(f"Run action: {label}?"):
                return "Cancelled.\n"
            return render_results(fn(self.runner()))
        return inner

    def run(self) -> None:
        curses.curs_set(0)
        self.stdscr.keypad(True)
        while True:
            key = self.draw_menu()
            if key in (ord("q"), 27):
                return
            if key in (curses.KEY_UP, ord("k")):
                self.pos = (self.pos - 1) % len(self.items)
            elif key in (curses.KEY_DOWN, ord("j")):
                self.pos = (self.pos + 1) % len(self.items)
            elif key in (curses.KEY_ENTER, 10, 13):
                title, fn = self.items[self.pos]
                try:
                    self.show_text(title, fn())
                except SystemExit:
                    raise
                except Exception as exc:  # noqa: BLE001
                    self.show_text(title, f"Error: {exc}\n")

    def draw_menu(self) -> int:
        self.stdscr.erase()
        h, w = self.stdscr.getmaxyx()
        mode = "DRY-RUN" if self.dry_run else "LIVE"
        self.stdscr.addstr(0, 0, f" OAI Lab Operator [{mode}] "[: w - 1], curses.A_REVERSE)
        self.stdscr.addstr(1, 0, "j/k or arrows, Enter to open, q to quit. Configure conf/local/lab.env first."[: w - 1])
        for idx, (label, _) in enumerate(self.items):
            y = idx + 3
            if y >= h - 1:
                break
            attr = curses.A_REVERSE if idx == self.pos else curses.A_NORMAL
            self.stdscr.addstr(y, 2, label[: w - 4], attr)
        self.stdscr.refresh()
        return self.stdscr.getch()

    def show_text(self, title: str, text: str) -> None:
        lines = wrap_block(text, max(40, self.stdscr.getmaxyx()[1] - 4)).splitlines()
        top = 0
        while True:
            self.stdscr.erase()
            h, w = self.stdscr.getmaxyx()
            self.stdscr.addstr(0, 0, f" {title} "[: w - 1], curses.A_REVERSE)
            self.stdscr.addstr(1, 0, "j/k scroll, PgUp/PgDn jump, b back, q quit"[: w - 1])
            visible = h - 3
            for i, line in enumerate(lines[top : top + visible]):
                self.stdscr.addstr(i + 2, 0, line[: w - 1])
            self.stdscr.refresh()
            key = self.stdscr.getch()
            if key in (ord("q"), 27):
                raise SystemExit
            if key == ord("b"):
                return
            if key in (curses.KEY_DOWN, ord("j")):
                top = min(max(0, len(lines) - visible), top + 1)
            elif key in (curses.KEY_UP, ord("k")):
                top = max(0, top - 1)
            elif key == curses.KEY_NPAGE:
                top = min(max(0, len(lines) - visible), top + visible)
            elif key == curses.KEY_PPAGE:
                top = max(0, top - visible)

    def prompt(self, prompt_text: str) -> str:
        curses.echo()
        curses.curs_set(1)
        self.stdscr.erase()
        self.stdscr.addstr(0, 0, prompt_text)
        self.stdscr.addstr(2, 0, "> ")
        value = self.stdscr.getstr(2, 2, 100).decode("utf-8", "replace")
        curses.noecho()
        curses.curs_set(0)
        return value

    def ask_yes_no(self, prompt_text: str) -> bool:
        value = self.prompt(prompt_text + " Type yes to continue.")
        return value.strip().lower() == "yes"

    def init_profile(self) -> str:
        path = init_local_config()
        return f"Local profile ready: {rel(path)}\nEdit it for your host paths, SSH options, and sudo mode.\n"

    def toggle_dry_run(self) -> str:
        self.dry_run = not self.dry_run
        return f"Dry-run is now {'ON' if self.dry_run else 'OFF'}.\n"

    def create_experiment_screen(self) -> str:
        slug = self.prompt("Experiment name, e.g. ethernet-baseline-validation")
        path = make_experiment(slug)
        return f"Created {rel(path)}\n"


def self_test() -> int:
    failures: list[str] = []
    for path in ["conf/lab.env.example", "scripts/oai-lab-tui", "docs/BASELINES.md"]:
        if not (REPO / path).exists():
            failures.append(f"missing {path}")
    proc = subprocess.run([sys.executable, "-m", "py_compile", str(REPO / "scripts/oai-lab-tui")], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if proc.returncode:
        failures.append(proc.stdout)
    proc = subprocess.run(["git", "diff", "--check"], cwd=REPO, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if proc.returncode:
        failures.append(proc.stdout)
    pattern = "|".join(f"(?:{p})" for p in secret_patterns())
    proc = subprocess.run(["rg", "-n", "-i", "--hidden", "--glob", "!/.git/**", pattern, "."], cwd=REPO, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if proc.returncode != 1:
        failures.append("secret-pattern scan matched:\n" + proc.stdout)
    if failures:
        print("\n\n".join(failures))
        return 1
    print("OK")
    return 0


CLI_ACTIONS: dict[str, Action] = {
    "status": lab_status,
    "start-monolithic": start_monolithic,
    "stop-monolithic": stop_monolithic,
    "start-ethernet": start_ethernet,
    "stop-ethernet": stop_ethernet,
    "start-wifi-gre": start_wifi_gre,
    "stop-wifi-gre": stop_wifi_gre,
    "quectel-preflight": quectel_preflight,
    "start-quectel": start_quectel,
}


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Operator TUI for the OAI CU/DU lab")
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--init-local-config", action="store_true")
    parser.add_argument("--dashboard", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--action", choices=sorted(CLI_ACTIONS))
    parser.add_argument("--make-experiment")
    args = parser.parse_args(argv)

    if args.self_test:
        return self_test()
    if args.init_local_config:
        print(rel(init_local_config()))
        return 0
    if args.dashboard:
        print(dashboard())
        return 0
    if args.make_experiment:
        print(rel(make_experiment(args.make_experiment)))
        return 0
    if args.action:
        runner = Runner(load_config(), dry_run=args.dry_run)
        print(render_results(CLI_ACTIONS[args.action](runner)))
        return 0

    curses.wrapper(lambda stdscr: Tui(stdscr).run())
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
