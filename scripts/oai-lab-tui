import curses
import datetime as dt
import os
import re
import shlex
import shutil
import subprocess
import sys
import textwrap
from dataclasses import dataclass
from pathlib import Path
from typing import Callable


REPO = Path(__file__).resolve().parents[1]
LOCAL_ENV = REPO / "conf/local/lab.env"
EXAMPLE_ENV = REPO / "conf/lab.env.example"
WIDTH = 92


