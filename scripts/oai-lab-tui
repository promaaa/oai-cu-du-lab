  }
}
let scriptedInputIndex = 0;
const rl = createInterface({ input, output });

function sleep(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

function printHeader(title) {
  const width = 70;
  const plain = title.replace(/\x1b\[[0-9;]*m/g, '');
  const pad = Math.max(0, Math.floor((width - plain.length) / 2));
  console.log('\n');
  console.log('  ╔' + '═'.repeat(width) + '╗');
  console.log('  ║' + ' '.repeat(width) + '║');
  console.log('  ║' + ' '.repeat(pad) + BOLD + title + RESET + ' '.repeat(width - pad - plain.length) + '║');
  console.log('  ║' + ' '.repeat(width) + '║');
  console.log('  ╚' + '═'.repeat(width) + '╝');
}

function printStep(step, total, title) {
  console.log(`\n  ${GRAY}[Step ${step}/${total}]${RESET} ${BOLD}${title}${RESET}`);
}

function stripAnsi(text) {
  return String(text || '').replace(/\x1b\[[0-9;]*m/g, '');
}

function printSuccess(msg) {
  console.log(`  ${GREEN}✓ ${msg}${RESET}`);
}

function printError(msg) {
  console.log(`  ${RED}✗ ${msg}${RESET}`);
}

function printInfo(msg) {
  console.log(`  ${CYAN}ℹ ${msg}${RESET}`);
}

function printWarn(msg) {
  console.log(`  ${YELLOW}⚠ ${msg}${RESET}`);
}

function quoteForSsh(cmd) {
  return `'${cmd.replaceAll("'", "'\\''")}'`;
}

function shellQuote(value) {
  return `'${String(value).replaceAll("'", "'\\''")}'`;
}

function execLocal(cmd, timeout = 60000) {
  return new Promise(resolve => {
    exec(cmd, { timeout }, (err, stdout, stderr) => {
      resolve({
        ok: !err,
        code: err?.code ?? 0,
        combined: ((stdout || '') + (stderr || '')).replace(/Warning: Permanently added.*$/gm, '').trim()
      });
    });
  });
}

async function ssh(host, cmd, timeout = 60000) {
  const full = `ssh -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=8 ${host} ${quoteForSsh(cmd)}`;
  const res = await execLocal(full, timeout);
  if (!res.ok) throw new Error(res.combined || `command failed rc=${res.code}`);
  return res.combined;
}

async function sshChecked(host, cmd, timeout = 60000) {
  const res = await sshLoose(host, cmd, timeout);
  if (!res.ok) {
    throw new Error(res.combined || `command failed rc=${res.code}`);
  }
  return res.combined;
}

async function sshLoose(host, cmd, timeout = 60000) {
  const full = `ssh -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=8 ${host} ${quoteForSsh(cmd)}`;
  return await execLocal(full, timeout);
}

async function prompt(message, def = '') {
  const suffix = def ? ` (${def})` : '';
  if (scriptedInput) {
    const answer = scriptedInputIndex < scriptedInput.length ? scriptedInput[scriptedInputIndex++] : null;
    if (answer === null || answer === undefined) return def || null;
    return answer.trim() || def;
  }
  try {
    const answer = await rl.question(`  ${message}${suffix}: `);
    return answer.trim() || def;
  } catch {
    return def || null;
  }
}

async function confirm(message, def = true) {
  const answer = await prompt(`${message} ${def ? '[Y/n]' : '[y/N]'}`);
  if (answer === null) return def;
  if (!answer) return def;
  return ['y', 'yes'].includes(answer.toLowerCase());
}

async function choose(message, choices) {
  console.log(`\n  ${BOLD}${message}${RESET}\n`);
  choices.forEach((choice, idx) => console.log(`  ${idx + 1}. ${choice.name}`));
  while (true) {
    const answer = await prompt('\n  Select option');
    if (answer === null) return choices[choices.length - 1].value;
    if (scriptedInput && !answer) return choices[choices.length - 1].value;
    const idx = Number(answer) - 1;
    if (idx >= 0 && idx < choices.length) return choices[idx].value;
    printError('Invalid selection');
  }
}

function runDir(slug) {
  const now = new Date();
  const stamp = now.toISOString().replace(/[-:]/g, '').replace(/\..*/, '').replace('T', '_');
  const dir = path.join(REPO, 'experiments', `${stamp}_${slug}`);
  mkdirSync(path.join(dir, 'logs'), { recursive: true });
  mkdirSync(path.join(dir, 'measurements'), { recursive: true });
  mkdirSync(path.join(dir, 'system-status'), { recursive: true });
  writeFileSync(path.join(dir, 'notes.md'), `# ${slug}\n\nStarted: ${now.toISOString()}\n\n`);
  return dir;
}

function appendEvidence(dir, name, content) {
  writeFileSync(path.join(dir, name), sanitizeCapture(content) + '\n');
}

function startSoftmodemCmd(workdir, conf, log, extra = '') {
  return [
    `cd ${workdir}`,
    'rm -f /tmp/oai-tui-start.err',
    `sudo -n setsid ./nr-softmodem -O ${conf} ${extra} > ${log} 2>/tmp/oai-tui-start.err < /dev/null &`,
    'sleep 1',
    'cat /tmp/oai-tui-start.err 2>/dev/null || true',
    "pgrep -a nr-softmodem | tail -5 || true",
  ].join('\n');
}

function stopSoftmodemByConfigCmd(conf) {
  return [
    `pids="$(ps -eo pid=,comm=,args= | awk -v conf=${shellQuote(conf)} '$2 == "nr-softmodem" && index($0, conf) > 0 { print $1 }')"`,
    'if [ -n "$pids" ]; then echo "$pids" | xargs -r sudo -n kill -9 2>/dev/null || true; fi',
    'sleep 1',
    `ps -eo pid=,comm=,args= | awk -v conf=${shellQuote(conf)} '$2 == "nr-softmodem" && index($0, conf) > 0' || true`,
  ].join('\n');
}

function stopSoftmodemsByConfigsCmd(configs) {
  return configs.map(conf => stopSoftmodemByConfigCmd(conf)).join('\n');
}

async function waitForRemoteLogMilestones(host, log, grepPattern, checks, timeoutMs = 60000, pollMs = 3000) {
  const deadline = Date.now() + timeoutMs;
  let latest = '';

  while (Date.now() < deadline) {
    latest = await sshChecked(host, `tail -n 320 ${log} 2>/dev/null | grep -Ei ${shellQuote(grepPattern)} || true`, 15000);
    if (checks.every(check => check.test(latest))) return latest;
    await sleep(pollMs);
  }

  latest = await sshChecked(host, `tail -n 320 ${log} 2>/dev/null | grep -Ei ${shellQuote(grepPattern)} || true`, 15000);
  return latest;
}

function maskIpv4ToPrefix(mask) {
  if (!mask) return '32';
  const parts = mask.trim().split('.').map(Number);
  if (parts.length !== 4 || parts.some(n => Number.isNaN(n))) return '32';
  return String(parts.reduce((bits, octet) => bits + octet.toString(2).replace(/0/g, '').length, 0));
}

function parseQmiSettings(text) {
  const ip = text.match(/IPv4 address:\s*([0-9.]+)/i)?.[1] || '';
  const gateway = text.match(/IPv4 gateway address:\s*([0-9.]+)/i)?.[1] || '';
  const mask = text.match(/IPv4 subnet mask:\s*([0-9.]+)/i)?.[1] || '';
  const mtu = text.match(/MTU:\s*([0-9]+)/i)?.[1] || '';
  return { ip, gateway, prefix: maskIpv4ToPrefix(mask), mtu };
}

function parseRouteDevSrc(text) {
  return {
    dev: text.match(/\bdev\s+(\S+)/)?.[1] || '',
    src: text.match(/\bsrc\s+([0-9.]+)/)?.[1] || '',
  };
}

function hasPacketLines(text) {
  return stripAnsi(text).split('\n').some(line => /\b(IP|SCTP|UDP|sctp|udp)\b| > /.test(line));
}

function sanitizeCapture(text) {
  return stripAnsi(text).replace(/([A-Fa-f0-9]{12,}|imsi-[0-9]+|[0-9]{14,})/g, '<redacted>');
}

async function enforcePerformanceGovernors(host, label) {
  const cmd = [
    'set -euo pipefail',
    'before="$(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 2>/dev/null | sort | uniq -c || true)"',
    'if ls /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1; then',
    '  for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance | sudo -n tee "$gov" >/dev/null || true; done',
    'fi',
    'after="$(cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 2>/dev/null | sort | uniq -c || true)"',
    'printf "before:\\n%s\\nafter:\\n%s\\n" "$before" "$after"',
  ].join('\n');
  const out = await sshLoose(host, cmd, 15000);
  if (out.combined) await showLines(`${label} CPU governors\n${out.combined}`);
  if (!/performance/i.test(out.combined || '')) {
    printWarn(`${label}: CPU governor evidence did not show performance; attach reliability may be degraded`);
  }
  return out.combined || '';
}

async function capturePacketGate(host, iface, filter, seconds = 20, lines = 20) {
  const cmd = `sudo -n timeout ${seconds} tcpdump -l -nni ${iface} '${filter}' 2>/dev/null | head -n ${lines} || true`;
  const out = await sshLoose(host, cmd, (seconds + 8) * 1000);
  return sanitizeCapture(out.combined || '');
}

async function discoverMinipcTarget() {
  const discoveryCmd = [
    'set -e',
    'echo "hostname=$(hostname)"',
    `echo "route_to_firecell=$(ip route get ${FIRECELL.split('@').pop()} 2>/dev/null || true)"`,
    'echo "--- ip -4 -o addr ---"',
    'ip -4 -o addr show scope global',
  ].join('\n');

  for (const candidate of MINIPC_DYNAMIC_CANDIDATES) {
    const out = await sshLoose(candidate, discoveryCmd, 12000);
    if (!out.ok || !/hostname=.*minipc|serber-minipc/i.test(out.combined)) continue;
    const route = out.combined.match(/route_to_firecell=(.*)/)?.[1] || '';
    const { dev, src } = parseRouteDevSrc(route);
    return {
      host: candidate,
      discoveredVia: candidate,
      hostname: out.combined.match(/hostname=(.*)/)?.[1]?.trim() || 'serber-minipc',
      mgmtIface: dev,
      mgmtIp: src,
      raw: out.combined,
    };
  }

  const manual = await prompt('serber-minipc SSH target was not auto-discovered; enter SSH target');
  if (!manual) throw new Error('serber-minipc SSH target is required for the caged Quectel scenario');
  const out = await sshChecked(manual, discoveryCmd, 12000);
  const route = out.match(/route_to_firecell=(.*)/)?.[1] || '';
  const { dev, src } = parseRouteDevSrc(route);
  return {
    host: manual,
    hostname: out.match(/hostname=(.*)/)?.[1]?.trim() || 'serber-minipc',
    mgmtIface: dev,
    mgmtIp: src,
    raw: out,
  };
}

async function discoverQuectel(minipcHost, apn) {
  const cmd = [
    'set -euo pipefail',
    'iface=""',
    'for dev in wwan0 usb0 rmnet_data0; do if ip link show "$dev" >/dev/null 2>&1; then iface="$dev"; break; fi; done',
    'if [ -z "$iface" ]; then for path in /sys/class/net/enx* /sys/class/net/wwan* /sys/class/net/rmnet* /sys/class/net/usb*; do [ -e "$path" ] || continue; iface="$(basename "$path")"; break; done; fi',
    'qmi="$(ls /dev/cdc-wdm* 2>/dev/null | head -1 || true)"',
    'echo "iface=$iface"',
    'echo "qmi=$qmi"',
    'ls -l /dev/cdc-wdm* /dev/ttyUSB* 2>/dev/null || true',
    'if [ -z "$iface" ]; then exit 10; fi',
    'sudo -n pkill -x qmicli 2>/dev/null || true',
    'sudo -n pkill -x qmi-proxy 2>/dev/null || true',
    'sleep 1',
    'sudo -n ip link set "$iface" down 2>/dev/null || true',
    'if [ -e "/sys/class/net/$iface/qmi/raw_ip" ]; then printf Y | sudo -n tee "/sys/class/net/$iface/qmi/raw_ip" >/dev/null 2>&1 || true; fi',
    'sudo -n ip link set "$iface" up || true',
    'if [ -n "$qmi" ]; then',
    '  timeout -k 3s 12s sudo -n qmicli -d "$qmi" --device-open-proxy --wds-get-packet-service-status 2>/dev/null || true',
    `  start_out="$(timeout -k 5s 25s sudo -n qmicli -d "$qmi" --device-open-proxy --wds-start-network=${shellQuote(`apn=${apn},ip-type=4`)} --client-no-release-cid 2>/dev/null || true)"`,
    '  printf "%s\\n" "$start_out"',
    '  cid="$(printf "%s\\n" "$start_out" | awk -F: \'/CID:/ { gsub(/[^0-9]/, "", $2); print $2; exit }\')"',
    '  settings_out=""',
    '  for _try in 1 2 3 4 5 6 7 8; do',
    '    sleep 1',
    '    timeout -k 3s 12s sudo -n qmicli -d "$qmi" --device-open-proxy --wds-get-packet-service-status 2>/dev/null || true',
    '    if [ -n "$cid" ]; then',
    '      settings_out="$(timeout -k 3s 12s sudo -n qmicli -d "$qmi" --device-open-proxy --client-cid="$cid" --wds-get-current-settings 2>/dev/null || true)"',
    '    fi',
    '    if ! printf "%s\\n" "$settings_out" | grep -q "IPv4 address"; then',
    '      settings_out="$(timeout -k 3s 12s sudo -n qmicli -d "$qmi" --device-open-proxy --wds-get-current-settings 2>/dev/null || true)"',
    '    fi',
    '    printf "%s\\n" "$settings_out"',
    '    printf "%s\\n" "$settings_out" | grep -q "IPv4 address" && break',
    '  done',
    '  qmi_ip="$(printf "%s\\n" "$settings_out" | awk -F: \'/IPv4 address/ { gsub(/^[ \\t]+/, "", $2); print $2; exit }\')"',
    '  qmi_gw="$(printf "%s\\n" "$settings_out" | awk -F: \'/IPv4 gateway address/ { gsub(/^[ \\t]+/, "", $2); print $2; exit }\')"',
    '  qmi_mask="$(printf "%s\\n" "$settings_out" | awk -F: \'/IPv4 subnet mask/ { gsub(/^[ \\t]+/, "", $2); print $2; exit }\')"',
    '  mask_to_prefix() { case "$1" in 255.255.255.252) echo 30;; 255.255.255.248) echo 29;; 255.255.255.240) echo 28;; 255.255.255.0) echo 24;; *) echo 30;; esac; }',
    '  if [ -n "$qmi_ip" ]; then',
    '    qmi_prefix="$(mask_to_prefix "$qmi_mask")"',
    '    if [ -z "$qmi_gw" ] && [ "$qmi_ip" = "10.0.0.2" ]; then qmi_gw="10.0.0.1"; fi',
    '    if [ -z "$qmi_gw" ] && [ "$qmi_ip" = "10.0.0.3" ]; then qmi_gw="10.0.0.4"; fi',
    '    sudo -n ip addr flush dev "$iface" || true',
    '    sudo -n ip addr add "$qmi_ip/$qmi_prefix" dev "$iface" || true',
    '    sudo -n ip link set "$iface" up || true',
    '    if [ -n "$qmi_gw" ]; then sudo -n ip route replace "$qmi_gw" dev "$iface" src "$qmi_ip" || true; fi',
    '  fi',
    'fi',
    'if ! ip -4 -o addr show dev "$iface" 2>/dev/null | grep -q " inet "; then',
    '  if command -v udhcpc >/dev/null 2>&1; then timeout -k 3s 12s sudo -n udhcpc -q -n -i "$iface" 2>/dev/null || true; fi',
    '  if command -v dhclient >/dev/null 2>&1; then timeout -k 3s 12s sudo -n dhclient -1 "$iface" 2>/dev/null || true; fi',
    'fi',
    'ip -4 -o addr show dev "$iface" 2>/dev/null || true',
  ].join('\n');
  const out = await sshChecked(minipcHost, cmd, 40000);
  const iface = out.match(/^iface=(\S+)/m)?.[1] || '';
  const qmi = out.match(/^qmi=(\S+)/m)?.[1] || '';
  const settings = parseQmiSettings(out);
  const currentCidr = out.match(/\binet\s+([0-9.]+)\/([0-9]+)/)?.slice(1, 3) || [];
  if (!settings.ip && currentCidr[0]) {
    settings.ip = currentCidr[0];
    settings.prefix = currentCidr[1] || settings.prefix;
  }
  if (settings.ip === '10.0.0.2' && !settings.gateway) {
    settings.gateway = '10.0.0.1';
    settings.prefix = settings.prefix || '30';
  }
  return { iface, qmi, settings, raw: out };
}

async function readQuectelModemImsi(minipcHost) {
  const cmd = [
    'set -euo pipefail',
    'sudo -n python3 - <<\'PY\'',
    'import os, re, select, time',
    'ports = ["/dev/ttyUSB3", "/dev/ttyUSB4", "/dev/ttyUSB2", "/dev/ttyUSB1", "/dev/ttyUSB0"]',
    'def at(port, cmd, timeout=8):',
    '    fd = os.open(port, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)',
    '    try:',
    '        end = time.time() + 0.5',
    '        while time.time() < end:',
    '            r, _, _ = select.select([fd], [], [], 0.05)',
    '            if fd not in r:',
    '                break',
    '            os.read(fd, 4096)',
    '        os.write(fd, (cmd + "\\r").encode())',
    '        end = time.time() + timeout',
    '        buf = b""',
    '        while time.time() < end:',
    '            r, _, _ = select.select([fd], [], [], 0.3)',
    '            if fd in r:',
    '                buf += os.read(fd, 4096)',
    '                if b"OK" in buf or b"ERROR" in buf or b"+CME ERROR" in buf:',
    '                    break',
    '        return buf.decode(errors="replace")',
    '    finally:',
    '        os.close(fd)',
    'for port in ports:',
    '    if not os.path.exists(port):',
    '        continue',
    '    out = at(port, "AT+CIMI")',
    '    m = re.search(r"\\b(\\d{14,16})\\b", out)',
    '    if m:',
    '        print("imsi=" + m.group(1))',
    '        print("at_port=" + port)',
    '        raise SystemExit(0)',
    'raise SystemExit(20)',
    'PY',
  ].join('\n');
  let last = null;
  for (let attempt = 1; attempt <= 3; attempt++) {
    const out = await sshLoose(minipcHost, cmd, 20000);
    last = out;
    if (out.ok) {
      const imsi = out.combined.match(/^imsi=([0-9]{14,16})$/m)?.[1] || '';
      const atPort = out.combined.match(/^at_port=(\S+)$/m)?.[1] || '';
      if (imsi) return { imsi, atPort, attempts: attempt };
    }
    await sleep(2000);
  }
  throw new Error(last?.combined || `modem IMSI discovery failed rc=${last?.code ?? 'unknown'}`);
}

async function provisionQuectelSubscriber(imsi) {
  if (!/^[0-9]{14,16}$/.test(imsi || '')) {
    throw new Error('Quectel IMSI must be supplied through QUECTEL_IMSI or the TUI prompt');
  }
  const cmd = [
    'set -euo pipefail',
    `test -f ${FIRECELL_SEED_SUBSCRIBER}`,
    'for i in $(seq 1 40); do',
    '  if docker exec oai-cn5g-minipc-mysql-1 sh -lc \'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -N -e "use oai_db; select 1;"\' >/dev/null 2>&1; then break; fi',
    '  sleep 2',
    '  if [ "$i" = 40 ]; then echo "mysql not ready"; exit 30; fi',
    'done',
    'tmp=/tmp/oai-tui-seed-subscriber-minipc.sh',
    `cp ${FIRECELL_SEED_SUBSCRIBER} "$tmp"`,
    'perl -0pi -e "s/docker exec -i mysql/docker exec -i oai-cn5g-minipc-mysql-1/g; s/docker exec mysql/docker exec oai-cn5g-minipc-mysql-1/g" "$tmp"',
    `IMSI=${shellQuote(imsi)} bash "$tmp" >/tmp/oai-tui-seed-quectel.log 2>&1`,
    'sed -E "s/[0-9]{10,}/<redacted>/g; s/[A-Fa-f0-9]{24,}/<redacted>/g; s/(encPermanentKey|encOpcKey|mysql -u root -p)[^[:space:]]*/<redacted>/Ig" /tmp/oai-tui-seed-quectel.log | tail -60',
    `docker exec oai-cn5g-minipc-mysql-1 sh -lc 'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -N -D oai_db -e "SELECT \\"auth_rows\\", COUNT(*), SUM(encPermanentKey IS NOT NULL AND encPermanentKey <> \\"\\"), SUM(encOpcKey IS NOT NULL AND encOpcKey <> \\"\\"), SUM(sequenceNumber IS NOT NULL AND sequenceNumber <> \\"\\") FROM AuthenticationSubscription WHERE supi=${shellQuote(imsi)}; SELECT \\"session_rows\\", COUNT(*) FROM SessionManagementSubscriptionData WHERE ueid=${shellQuote(imsi)} AND JSON_EXTRACT(dnnConfigurations, \\"$.oai.staticIpAddress[0].ipv4Addr\\") IS NOT NULL;"'`,
  ].join('\n');
  const out = await sshChecked(FIRECELL, cmd, 30000);
  if (!/Done|ueid|servingPlmnid/i.test(out)) throw new Error('Quectel subscriber seed did not show expected sanitized DB evidence');
  if (!/auth_rows\s+1\s+1\s+1\s+1/i.test(out) || !/session_rows\s+1/i.test(out)) {
    throw new Error('Quectel subscriber seed did not prove complete auth and session subscription rows');
  }
  return out;
}

async function provisionLabPhoneSubscriber(dir) {
  const phoneImsi = process.env.PHONE_IMSI || '';
  const evidencePath = 'system-status/phone-subscriber-seed.log';
  if (phoneImsi && !/^[0-9]{14,16}$/.test(phoneImsi)) {
    throw new Error('PHONE_IMSI is configured but is not a valid IMSI length');
  }
  printInfo(`Ensuring lab phone subscriber ending ${LAB_PHONE_IMSI_SUFFIX} exists in split core database...`);
  const cmd = [
    'set -euo pipefail',
    `test -f ${FIRECELL_SEED_SUBSCRIBER}`,
    `PHONE_IMSI=${shellQuote(phoneImsi)}`,
    `PHONE_SUFFIX=${shellQuote(LAB_PHONE_IMSI_SUFFIX)}`,
    `QUECTEL_SUFFIX=${shellQuote(LAB_QUECTEL_IMSI_SUFFIX)}`,
    'if [ "$PHONE_SUFFIX" = "$QUECTEL_SUFFIX" ]; then echo "phone suffix collides with Quectel suffix"; exit 41; fi',
    'for i in $(seq 1 40); do',
    '  if docker exec oai-cn5g-minipc-mysql-1 sh -lc \'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -N -e "use oai_db; select 1;"\' >/dev/null 2>&1; then break; fi',
    '  sleep 2',
    '  if [ "$i" = 40 ]; then echo "mysql not ready"; exit 30; fi',
    'done',
    'phone_status() {',
    '  docker exec -i oai-cn5g-minipc-mysql-1 sh -lc \'mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -N -D oai_db\' <<SQL',
    "SELECT COUNT(*), SUM(encPermanentKey IS NOT NULL AND encPermanentKey <> \"\"), SUM(encOpcKey IS NOT NULL AND encOpcKey <> \"\"), SUM(sequenceNumber IS NOT NULL AND sequenceNumber <> \"\") FROM AuthenticationSubscription WHERE RIGHT(supi,4)='$PHONE_SUFFIX';",
    "SELECT COUNT(*) FROM SessionManagementSubscriptionData WHERE RIGHT(ueid,4)='$PHONE_SUFFIX' AND JSON_EXTRACT(dnnConfigurations, \"$.oai.staticIpAddress[0].ipv4Addr\") IS NOT NULL;",
    'SQL',
    '}',
    'status="$(phone_status)"',
    'auth_line="$(printf "%s\\n" "$status" | sed -n "1p")"',
    'session_line="$(printf "%s\\n" "$status" | sed -n "2p")"',
    'if printf "%s\\n" "$auth_line" | grep -Eq "^1[[:space:]]+1[[:space:]]+1[[:space:]]+1$" && [ "$session_line" = "1" ]; then',
    '  echo "phone_subscriber_source=existing_db"',
    '  echo "phone_subscriber_suffix=$PHONE_SUFFIX"',
    '  echo "phone_auth_rows=$auth_line"',
    '  echo "phone_session_rows=$session_line"',
    '  exit 0',
    'fi',
    'tmp=/tmp/oai-tui-seed-subscriber-phone.sh',
    `cp ${FIRECELL_SEED_SUBSCRIBER} "$tmp"`,
    'perl -0pi -e "s/docker exec -i mysql/docker exec -i oai-cn5g-minipc-mysql-1/g; s/docker exec mysql/docker exec oai-cn5g-minipc-mysql-1/g" "$tmp"',
    'if [ -n "$PHONE_IMSI" ]; then IMSI="$PHONE_IMSI" bash "$tmp" >/tmp/oai-tui-seed-phone.log 2>&1; else bash "$tmp" >/tmp/oai-tui-seed-phone.log 2>&1; fi',
    'sed -E "s/[0-9]{10,}/<redacted>/g; s/[A-Fa-f0-9]{24,}/<redacted>/g; s/(encPermanentKey|encOpcKey|mysql -u root -p)[^[:space:]]*/<redacted>/Ig" /tmp/oai-tui-seed-phone.log | tail -60',
    'status="$(phone_status)"',
    'auth_line="$(printf "%s\\n" "$status" | sed -n "1p")"',
    'session_line="$(printf "%s\\n" "$status" | sed -n "2p")"',
    'echo "phone_subscriber_source=seeded_or_refreshed"',
    'echo "phone_subscriber_suffix=$PHONE_SUFFIX"',
    'echo "phone_auth_rows=$auth_line"',
    'echo "phone_session_rows=$session_line"',
    'if ! printf "%s\\n" "$auth_line" | grep -Eq "^1[[:space:]]+1[[:space:]]+1[[:space:]]+1$" || [ "$session_line" != "1" ]; then exit 42; fi',
  ].join('\n');
  const out = await sshChecked(FIRECELL, cmd, 30000);
  const evidence = `configured_phone_imsi_present=${Boolean(phoneImsi)}\nexpected_phone_suffix=${LAB_PHONE_IMSI_SUFFIX}\n${out}`;
  appendEvidence(dir, evidencePath, evidence);
  if (!/phone_auth_rows=1\s+1\s+1\s+1/i.test(evidence) || !/phone_session_rows=1/i.test(evidence)) {
    throw new Error('Phone subscriber was not proven in the active split core database');
  }
  return evidence;
}

async function resetQuectelRegistration(minipcHost) {
  const cmd = [
    'set -euo pipefail',
    'qmi="$(ls /dev/cdc-wdm* 2>/dev/null | head -1 || true)"',
    'if [ -n "$qmi" ]; then timeout -k 3s 12s sudo -n qmicli -d "$qmi" --dms-set-operating-mode=reset 2>/dev/null || true; fi',
    'sleep 20',
    'at_port=""',
    'for attempt in $(seq 1 40); do',
    '  for port in /dev/ttyUSB3 /dev/ttyUSB4 /dev/ttyUSB2 /dev/ttyUSB1 /dev/ttyUSB0; do',
    '    [ -e "$port" ] || continue',
    '    if printf "AT\\r" | timeout 6 sudo -n socat -T 3 - "$port",raw,echo=0,b115200 2>/dev/null | grep -q OK; then at_port="$port"; break 2; fi',
    '  done',
    '  sleep 3',
    'done',
    'echo "at_port=$at_port"',
    'if [ -z "$at_port" ]; then exit 20; fi',
    'send_at() { printf "%s\\r" "$1" | timeout 16 sudo -n socat -T 6 - "$at_port",raw,echo=0,b115200 2>/dev/null || true; }',
    'send_at "AT+CMEE=2" || true',
    'send_at "AT+CEREG=2" || true',
    'send_at "AT+C5GREG=2" || true',
    'send_at "AT+CFUN=1" || true',
    'sleep 2',
    'send_at "AT+QNWLOCK=\\"common/5g\\",1,641280,30,78" || true',
    'send_at "AT+QNWPREFCFG=\\"mode_pref\\",NR5G" || true',
    'send_at "AT+QNWPREFCFG=\\"nr5g_band\\",78" || true',
    'send_at "AT+CFUN=1" || true',
    'sleep 5',
    'send_at "AT+COPS=0" || true',
    'sleep 8',
    'for i in $(seq 1 15); do',
    '  echo "--- registration poll $i ---"',
    '  cereg="$(send_at "AT+CEREG?" | tee /tmp/oai-tui-cereg.txt || true)"',
    '  printf "%s\\n" "$cereg" | sed -E "s/([0-9]{7,}|[A-Fa-f0-9]{10,})/<redacted>/g"',
    '  c5greg="$(send_at "AT+C5GREG?" | tee /tmp/oai-tui-c5greg.txt || true)"',
    '  printf "%s\\n" "$c5greg" | sed -E "s/([0-9]{7,}|[A-Fa-f0-9]{10,})/<redacted>/g"',
    '  attach="$(send_at "AT+CGATT?" | tee /tmp/oai-tui-cgatt.txt || true)"',
    '  printf "%s\\n" "$attach" | sed -E "s/([0-9]{7,}|[A-Fa-f0-9]{10,})/<redacted>/g"',
    '  nw="$(send_at "AT+QNWINFO" | tee /tmp/oai-tui-qnwinfo.txt || true)"',
    '  printf "%s\\n" "$nw" | sed -E "s/([0-9]{7,}|[A-Fa-f0-9]{10,})/<redacted>/g"',
    '  scell="$(send_at "AT+QENG=\\"servingcell\\"" | tee /tmp/oai-tui-servingcell.txt || true)"',
    '  printf "%s\\n" "$scell" | sed -E "s/([0-9]{7,}|[A-Fa-f0-9]{10,})/<redacted>/g"',
    '  if { grep -Eq "\\+CEREG: [0-9]+,[15]" /tmp/oai-tui-cereg.txt || grep -Eq "\\+C5GREG: [0-9]+,[15]" /tmp/oai-tui-c5greg.txt; } && grep -q "+CGATT: 1" /tmp/oai-tui-cgatt.txt && grep -q "NR5G" /tmp/oai-tui-qnwinfo.txt && grep -Eq "00154F7CE,\\s*1,\\s*2,\\s*641280|,\\s*1,\\s*2,\\s*641280" /tmp/oai-tui-servingcell.txt; then',
    '    echo "Successfully registered on firecell donor cell (PCI=1, TAC=2)"',
    '    exit 0',
    '  fi',
    '  sleep 8',
    'done',
    'echo "Error: Failed to register or camp on expected donor cell (PCI=1, TAC=2)"',
    'exit 21',
  ].join('\n');
  const out = await sshLoose(minipcHost, cmd, 300000);
  if (!out.ok) {
    const err = new Error('Quectel donor registration failed before PDU setup; modem did not report NR5G packet attach on donor PCI=1/TAC=2');
    err.evidence = out.combined || '';
    throw err;
  }
  return out.combined;
}

async function discoverMgmtInterfaces(host, exclude = []) {
  const cmd = [
    'for path in /sys/class/net/*; do',
    '  iface="$(basename "$path")"',
    '  case "$iface" in lo|docker*|br-*|veth*|wg*|oai-cn5g*|uesimtun*) continue ;; esac',
    '  if ip -4 -o addr show dev "$iface" scope global >/dev/null 2>&1; then echo "$iface"; fi',
    'done',
  ].join('\n');
  const out = await sshLoose(host, cmd, 10000);
  return [...new Set(stripAnsi(out.combined).split(/\s+/).filter(Boolean).filter(iface => !exclude.includes(iface)))];
}

async function ensurePduRoutes(minipcHost, quectel) {
  const { iface, settings } = quectel;
  if (!iface || !settings.ip || !settings.gateway) {
    throw new Error('Quectel QMI settings did not include a live interface, IPv4 address, and gateway');
  }
  const minipcCmd = [
    `sudo -n ip addr flush dev ${iface}`,
    `sudo -n ip addr add ${settings.ip}/${settings.prefix} dev ${iface}`,
    `sudo -n ip link set ${iface} up`,
    `sudo -n ip route replace ${settings.gateway} dev ${iface} src ${settings.ip}`,
    `sudo -n ip route replace ${FIRECELL_WG_ENDPOINT_IP}/32 via ${settings.gateway} dev ${iface} src ${settings.ip}`,
    `ip route get ${FIRECELL_WG_ENDPOINT_IP}`,
  ].join('\n');
  const minipcOut = await sshChecked(minipcHost, minipcCmd, 20000);
  const firecellCmd = [
    `sudo -n ip route replace ${settings.ip}/32 via ${OAI_UPF_IP} dev ${OAI_CN5G_BRIDGE_IF}`,
    `ip route get ${settings.ip}`,
  ].join('\n');
  const firecellOut = await sshChecked(FIRECELL, firecellCmd, 20000);
  if (!minipcOut.includes(`dev ${iface}`)) {
    throw new Error('Route to WireGuard endpoint does not go over Quectel interface');
  }
  return { minipcOut, firecellOut };
}

async function ensureWireGuard(minipcHost, quectel = null) {
  if (quectel?.iface && quectel?.settings?.ip && quectel?.settings?.gateway) {
    const preUpCmd = `PreUp = ip route replace ${FIRECELL_WG_ENDPOINT_IP}/32 via ${quectel.settings.gateway} dev ${quectel.iface} src ${quectel.settings.ip}`;
    const postDownCmd = `PostDown = ip route del ${FIRECELL_WG_ENDPOINT_IP}/32 dev ${quectel.iface} 2>/dev/null || true`;

    await sshChecked(minipcHost, [
      'set -euo pipefail',
      `sudo -n cp /etc/wireguard/${WG_IF}.conf /etc/wireguard/${WG_IF}.conf.bak-oai-tui 2>/dev/null || true`,
      `sudo -n perl -0pi -e ${shellQuote(`s#^PreUp\\s*=.*\\n##mg; s#^PostDown\\s*=.*${FIRECELL_WG_ENDPOINT_IP}.*\\n##mg; s#(\\[Interface\\])#\\[Interface\\]\\n${preUpCmd}\\n${postDownCmd}#g`)} /etc/wireguard/${WG_IF}.conf`,
      `sudo -n perl -0pi -e ${shellQuote(`s#^AllowedIPs\\s*=.*#AllowedIPs = ${WG_CU_IP}/32#m`)} /etc/wireguard/${WG_IF}.conf`,
      `sudo -n grep -E '^(PreUp|PostDown) = ' /etc/wireguard/${WG_IF}.conf`,
      `sudo -n grep -E '^AllowedIPs = ' /etc/wireguard/${WG_IF}.conf`,
    ].join('\n'), 15000);

    const postUpCmd = `PostUp = ip route replace ${quectel.settings.ip}/32 via ${OAI_UPF_IP} dev ${OAI_CN5G_BRIDGE_IF}`;
    const preDownCmd = `PreDown = ip route del ${quectel.settings.ip}/32 via ${OAI_UPF_IP} dev ${OAI_CN5G_BRIDGE_IF} 2>/dev/null || true`;

    await sshChecked(FIRECELL, [
      'set -euo pipefail',
      `sudo -n cp /etc/wireguard/${WG_IF}.conf /etc/wireguard/${WG_IF}.conf.bak-oai-tui 2>/dev/null || true`,
      `sudo -n perl -0pi -e ${shellQuote(`s#^PostUp\\s*=.*${OAI_CN5G_BRIDGE_IF}.*\\n##mg; s#^PreDown\\s*=.*${OAI_CN5G_BRIDGE_IF}.*\\n##mg; s#(\\[Interface\\])#\\[Interface\\]\\n${postUpCmd}\\n${preDownCmd}#g`)} /etc/wireguard/${WG_IF}.conf`,
      `sudo -n grep -E '^(PostUp|PreDown) = ' /etc/wireguard/${WG_IF}.conf`,
    ].join('\n'), 15000);
  }
  const firecellStart = await sshLoose(FIRECELL, [
    `sudo -n systemctl restart wg-quick@${WG_IF}`,
    'sleep 2',
    `sudo -n wg show ${WG_IF}`,
  ].join('\n'), 30000);
  const minipcStart = await sshLoose(minipcHost, [
    `sudo -n systemctl restart wg-quick@${WG_IF}`,
    'sleep 2',
    `sudo -n wg show ${WG_IF}`,
  ].join('\n'), 30000);
  const [minipcRun, firecellRun] = await Promise.all([
    sshLoose(minipcHost, [
    `sudo -n wg show ${WG_IF}`,
    `ping -c 4 -W 2 ${WG_CU_IP}`,
    ].join('\n'), 30000),
    sshLoose(FIRECELL, [
    `sudo -n wg show ${WG_IF}`,
    `ping -c 4 -W 2 ${WG_DU_IP}`,
    ].join('\n'), 30000),
  ]);
  const evidence = [
    '=== firecell restart/show ===', firecellStart.combined,
    '=== minipc restart/show ===', minipcStart.combined,
    '=== minipc wg ping ===', minipcRun.combined,
    '=== firecell wg ping ===', firecellRun.combined,
  ].join('\n');
  const fail = message => {
    const err = new Error(message);
    err.evidence = evidence;
    err.evidenceFile = 'system-status/wireguard.txt';
    throw err;
  };
  if (!firecellStart.ok || !minipcStart.ok || !minipcRun.ok || !firecellRun.ok) fail('WireGuard command or tunnel ping failed');
  if (!/latest handshake|transfer:/i.test(evidence)) fail('WireGuard did not report a peer handshake');
  if (!/0% packet loss/.test(minipcRun.combined) || !/0% packet loss/.test(firecellRun.combined)) fail('WireGuard tunnel ping did not pass both directions');
  return { minipc: minipcRun.combined, firecell: firecellRun.combined };
}

async function prepareCagedSplitConfigs(minipcHost) {
  printInfo('Generating configs via 05_generate_quectel_f1_configs.sh...');
  const envPrefix = `CU_HOST=${shellQuote(FIRECELL)} DU_HOST=${shellQuote(minipcHost)}`;
  const res = await execLocal(`${envPrefix} bash ${shellQuote(path.join(QUECTEL_SCRIPT_DIR, '05_generate_quectel_f1_configs.sh'))}`, 40000);
  if (!res.ok) throw new Error(`Config generation script failed: ${res.combined}`);
  const firecell = await sshChecked(FIRECELL, `grep -En 'gNB_ID|gNB_DU_ID|gNB_name|tracking_area_code|physCellId|nr_cellid|local_s_address|remote_s_address|local_n_address|remote_n_address|local_n_if_name' ${CU_QUECTEL_CONF} | head -80 || true`, 20000);
  const minipc = await sshChecked(minipcHost, `grep -En 'gNB_ID|gNB_DU_ID|tracking_area_code|physCellId|nr_cellid|sdr_addrs|att_tx|att_rx|absoluteFrequencySSB|dl_absoluteFrequencyPointA|local_s_address|remote_s_address|local_n_address|remote_n_address|local_n_if_name' ${DU_QUECTEL_CONF} | head -80 || true`, 20000);
  return { firecell, minipc };
}

async function prepareMonolithicDonorRuntimeConfig(dir) {
  const cmd = [
    'set -euo pipefail',
    `test -f ${FIRECELL_DONOR_PROD_CONF}`,
    `sudo -n cp ${FIRECELL_DONOR_PROD_CONF} ${FIRECELL_DONOR_GNB_RUNTIME_CONF}`,
    `sudo -n perl -0pi -e 's/(prach_dtx_threshold\\s*=\\s*)\\d+/$1 . "100"/ge; s/(att_tx\\s*=\\s*)\\d+/$1 . "${FIRECELL_DONOR_ATT_TX}"/ge; s/(att_rx\\s*=\\s*)\\d+/$1 . "0"/ge;' ${FIRECELL_DONOR_GNB_RUNTIME_CONF}`,
    `grep -En 'gNB_ID|gNB_name|tracking_area_code|physCellId|nr_cellid|GNB_IPV4_ADDRESS_FOR_NG|prach_dtx_threshold|att_tx|att_rx|sdr_addrs' ${FIRECELL_DONOR_GNB_RUNTIME_CONF} | head -80 || true`,
  ].join('\n');
  const out = await sshChecked(FIRECELL, cmd, 20000);
  appendEvidence(dir, 'system-status/firecell-monolithic-donor-runtime-config.txt', out);
  if (!/physCellId\s*=\s*1|tracking_area_code\s*=\s*2|22345678/i.test(out)) {
    throw new Error('Firecell monolithic donor runtime config did not show expected donor PCI/TAC/cell evidence');
  }
  return out;
}

async function validateMonolithicDonorInService(dir) {
  const status = await sshChecked(FIRECELL, [
    `ps -eo pid=,comm=,args= | awk -v prod=${shellQuote(FIRECELL_DONOR_PROD_CONF)} -v run=${shellQuote(FIRECELL_DONOR_GNB_RUNTIME_CONF)} '$2 == "nr-softmodem" && (index($0, prod) > 0 || index($0, run) > 0)' || true`,
    `grep -Ei "NGSetup|in service|Cell ID|physCellId|UHD|B200|B210|got sync" ${FIRECELL_DONOR_GNB_LOG} 2>/dev/null | head -80 || true`,
    `grep -Ei "NGSetup|in service|Cell ID|physCellId|UHD|B200|B210|got sync|PRACH|RNTI|UE |BLER|SNR|error|fail|assert" ${FIRECELL_DONOR_GNB_LOG} 2>/dev/null | tail -120 || true`,
  ].join('\n'), 20000);
  appendEvidence(dir, 'logs/firecell-monolithic-donor-gnb.log', status);
  await showLines(status);
  if (!/nr-softmodem/i.test(status)) throw new Error('Firecell monolithic donor gNB process is not running');
  if (/failed to bind|Failed to create|Cannot assign requested address|assert/i.test(status)) {
    throw new Error('Firecell monolithic donor gNB log shows bind/listener errors; check oai-cn5g-minipc bridge aliases before resetting Quectel');
  }
  if (!/NGSetup|in service|Cell ID/i.test(status)) throw new Error('Firecell monolithic donor gNB did not show NG setup or in-service evidence');
  if (!/B210|UHD|got sync/i.test(status)) throw new Error('Firecell monolithic donor gNB did not show radio evidence');
  return status;
}

async function validateCagedPacketPlacement(dir, minipcHost, quectel) {
  const minipcMgmtIfaces = await discoverMgmtInterfaces(minipcHost, [quectel.iface, WG_IF]);
  const firecellMgmtIfaces = await discoverMgmtInterfaces(FIRECELL, [WG_IF]);
  const mgmtJobs = [
    ...minipcMgmtIfaces.map(iface => ({ host: minipcHost, label: 'minipc', iface })),
    ...firecellMgmtIfaces.map(iface => ({ host: FIRECELL, label: 'firecell', iface })),
  ];
  const [wgF1c, outer, ...mgmtCaps] = await Promise.all([
    capturePacketGate(minipcHost, WG_IF, 'sctp', 45, 30),
    capturePacketGate(minipcHost, quectel.iface, `udp port ${WG_PORT} or udp port 40016`, 25, 20),
    ...mgmtJobs.map(item => capturePacketGate(item.host, item.iface, 'sctp or udp port 2153', 12, 5)),
  ]);
  const mgmtCaptures = mgmtJobs.map((item, idx) => ({ ...item, cap: mgmtCaps[idx] || '' }));
  appendEvidence(dir, 'measurements/packet-validation.txt', [
    '=== wg F1-C ===', wgF1c,
    '=== Quectel outer WireGuard ===', outer,
    '=== management no-F1 captures ===',
    ...mgmtCaptures.map(item => `--- ${item.label} ${item.iface} ---\n${item.cap || '<no packets>'}`),
  ].join('\n'));
  console.log(`\n  ${BOLD}wg F1-C${RESET}`);
  await showLines(wgF1c || '<no packets>');
  console.log(`\n  ${BOLD}Quectel outer UDP${RESET}`);
  await showLines(outer || '<no packets>');
  const f1cOk = hasPacketLines(wgF1c) && /sctp/i.test(wgF1c);
  const outerOk = hasPacketLines(outer) && /udp/i.test(outer);
  const mgmtOk = mgmtCaptures.every(item => !hasPacketLines(item.cap));
  if (!f1cOk || !outerOk || !mgmtOk) throw new Error('Packet gate failed: required F1/WireGuard placement was not proven');
  return { wgF1c, outer, mgmtCaptures };
}

async function validateCagedAccessSourceIdentity(dir, minipcHost) {
  const [firecellProc, minipcProc, duConfig, donorConfig] = await Promise.all([
    sshChecked(FIRECELL, `ps -eo pid=,comm=,args= | awk '$2 == "nr-softmodem" { print }' || true`, 10000),
    sshChecked(minipcHost, `ps -eo pid=,comm=,args= | awk '$2 == "nr-softmodem" { print }' || true`, 10000),
    sshChecked(minipcHost, `grep -En 'gNB_DU_ID|tracking_area_code|physCellId|nr_cellid|sdr_addrs|att_tx|att_rx|absoluteFrequencySSB|dl_absoluteFrequencyPointA|local_n_address|remote_n_address|local_n_if_name' ${DU_QUECTEL_CONF} | head -80 || true`, 10000),
    sshChecked(FIRECELL, `grep -En 'gNB_ID|gNB_name|tracking_area_code|physCellId|nr_cellid|sdr_addrs|att_tx|att_rx|absoluteFrequencySSB|dl_absoluteFrequencyPointA' ${FIRECELL_DONOR_GNB_RUNTIME_CONF} 2>/dev/null | head -80 || true`, 10000),
  ]);
  const evidence = sanitizeCapture([
    '=== firecell nr-softmodem processes ===',
    firecellProc,
    '=== minipc nr-softmodem processes ===',
    minipcProc,
    '=== minipc access DU config identity ===',
    duConfig,
    '=== firecell donor gNB config identity ===',
    donorConfig,
  ].join('\n'));
  appendEvidence(dir, 'system-status/source-identity.txt', evidence);
  const firecellHasCu = firecellProc.includes(CU_QUECTEL_CONF);
  const firecellHasDonor = firecellProc.includes(FIRECELL_DONOR_GNB_RUNTIME_CONF) || firecellProc.includes(FIRECELL_DONOR_PROD_CONF);
  const minipcHasAccessDu = minipcProc.includes(DU_QUECTEL_CONF);
  const accessIdentityOk =
    /physCellId\s*=\s*0\b/i.test(duConfig) &&
    /tracking_area_code\s*=\s*1\b/i.test(duConfig) &&
    new RegExp(`nr_cellid\\s*=\\s*${ACCESS_NR_CELL_ID}\\b`, 'i').test(duConfig) &&
    duConfig.includes(ACCESS_B210_SERIAL) &&
    duConfig.includes(WG_DU_IP) &&
    duConfig.includes(WG_CU_IP);
  const donorIdentityOk =
    /physCellId\s*=\s*1\b/i.test(donorConfig) &&
    /tracking_area_code\s*=\s*2\b/i.test(donorConfig);
  if (!firecellHasCu || !firecellHasDonor || !minipcHasAccessDu || !accessIdentityOk || !donorIdentityOk) {
    throw new Error('Source identity gate failed: running processes/configs do not prove firecell CU + firecell donor + minipc access DU PCI=0/TAC=1 over wg-quectel-f1.');
  }
  return evidence;
}

async function validateCagedF1u(dir, minipcHost, attempts = 3) {
  let f1uMinipc = '';
  let f1uFirecell = '';
  const f1uEvidence = [];
  for (let attempt = 1; attempt <= attempts; attempt += 1) {
    const marker = `OAI_TUI_PHONE_SOURCE_PROOF_${Date.now()}_${attempt}`;
    await writeSourceProofMarkers(minipcHost, marker);
    console.log(`\n    Start phone traffic from the caged Nothing Phone now. Attempt ${attempt}/${attempts}.`);
    console.log('    The TUI will wait for UDP/2153 on the WireGuard tunnel and collect fresh post-marker CU/DU evidence.');
    await prompt('Press Enter once phone traffic is running');
    [f1uMinipc, f1uFirecell] = await Promise.all([
      capturePacketGate(minipcHost, WG_IF, 'udp port 2153', 90, 40),
      capturePacketGate(FIRECELL, WG_IF, 'udp port 2153', 90, 40),
    ]);
    const sourceDiag = await collectCagedSourceProofDiagnostics(minipcHost, marker);
    f1uEvidence.push(`=== attempt ${attempt} marker ===\n${marker}\n\n=== attempt ${attempt} minipc wg UDP/2153 ===\n${f1uMinipc || '<no packets>'}\n\n=== attempt ${attempt} firecell wg UDP/2153 ===\n${f1uFirecell || '<no packets>'}\n\n${sourceDiag}`);
    appendEvidence(dir, 'measurements/f1u-validation.txt', f1uEvidence.join('\n\n'));
    await showLines(f1uMinipc || f1uFirecell || '<no F1-U packets>');
    if (hasPacketLines(f1uMinipc)) {
      return { f1uMinipc, f1uFirecell, sourceDiag };
    }
    if (hasPacketLines(f1uFirecell)) {
      throw new Error('Phone-source gate failed: F1-U was visible only from the firecell side. The TUI did not capture phone traffic on serber-minipc wg-quectel-f1, so do not attribute the throughput to the minipc access DU.');
    }
    if (attempt < attempts) printWarn('No F1-U packets yet. Toggle phone airplane mode, confirm APN/DNN "oai", start traffic, then retry.');
  }
  const diag = await collectCagedUeDiagnostics(minipcHost);
  appendEvidence(dir, 'measurements/f1u-diagnostics.txt', diag);
  await showLines(diag);
  const hasAccessAttach = /Msg[1234]\s+scheduled|RA\s+RNTI|RA\s+failed|RNTI\s+[0-9a-f]+|RRCSetupComplete|InitialUEMessage|PDU Session Resource|DRB/i.test(diag);
  if (!hasAccessAttach) {
    throw new Error('UE/F1-U gate failed: no access-cell RACH/UE attach evidence was observed, so UDP/2153 could not appear on wg-quectel-f1');
  }
  throw new Error('UE/F1-U gate failed: access UE activity was observed, but UDP/2153 was not visible on wg-quectel-f1');
}

async function writeSourceProofMarkers(minipcHost, marker) {
  const quotedMarker = shellQuote(`=== ${marker} ===`);
  await Promise.all([
    sshLoose(minipcHost, `printf '\\n%s\\n' ${quotedMarker} | sudo -n tee -a ${DU_QUECTEL_LOG} >/dev/null 2>&1 || true`, 10000),
    sshLoose(FIRECELL, `printf '\\n%s\\n' ${quotedMarker} | sudo -n tee -a ${CU_QUECTEL_LOG} ${FIRECELL_DONOR_GNB_LOG} >/dev/null 2>&1 || true`, 10000),
  ]);
}

async function collectLogAfterMarker(host, file, marker, grepPattern) {
  const cmd = [
    `awk -v marker=${shellQuote(marker)} 'index($0, marker) { seen=1; next } seen { print }' ${file} 2>/dev/null`,
    `| grep -Ei ${shellQuote(grepPattern)} | tail -140 || true`,
  ].join(' ');
  return sshLoose(host, cmd, 20000);
}

async function collectCagedSourceProofDiagnostics(minipcHost, marker) {
  const [du, cu, donor, wg] = await Promise.all([
    collectLogAfterMarker(minipcHost, DU_QUECTEL_LOG, marker, 'RACH|Msg[1234]|RA-|RNTI|RRC|Initial|PDU|DRB|UE |F1|GTPU|2153|MCS|BLER|SNR|overflow|underflow|problem receiving|ERROR_CODE'),
    collectLogAfterMarker(FIRECELL, CU_QUECTEL_LOG, marker, 'UE|RNTI|RRC|Initial|PDU|NAS|DRB|GTPU|F1|2153|error|fail'),
    collectLogAfterMarker(FIRECELL, FIRECELL_DONOR_GNB_LOG, marker, 'UE|RNTI|RRC|Initial|PDU|DRB|GTPU|PRACH|RACH|Cell ID|physCellId|error|fail'),
    Promise.all([
      sshLoose(minipcHost, `ip -s link show ${WG_IF} 2>/dev/null || true; sudo -n wg show ${WG_IF} transfer 2>/dev/null || true`, 10000),
      sshLoose(FIRECELL, `ip -s link show ${WG_IF} 2>/dev/null || true; sudo -n wg show ${WG_IF} transfer 2>/dev/null || true`, 10000),
    ]),
  ]);
  return sanitizeCapture([
    '=== phone-source proof marker ===',
    marker,
    '=== fresh minipc access DU after marker ===',
    du.combined || '<no fresh minipc access DU lines>',
    '=== fresh firecell CU after marker ===',
    cu.combined || '<no fresh firecell CU lines>',
    '=== fresh firecell donor gNB after marker ===',
    donor.combined || '<no fresh donor lines>',
    '=== WireGuard counters after marker ===',
    `--- minipc ${WG_IF} ---\n${wg[0].combined || '<no minipc wg counters>'}`,
    `--- firecell ${WG_IF} ---\n${wg[1].combined || '<no firecell wg counters>'}`,
  ].join('\n'));
}

async function collectCagedUeDiagnostics(minipcHost) {
  const du = await sshLoose(minipcHost, `grep -Ei "RACH|Msg[1234]|RA-|RNTI|RRC|Initial|PDU|DRB|UE |overflow|underflow|problem receiving|ERROR_CODE" ${DU_QUECTEL_LOG} 2>/dev/null | tail -160 || true`, 20000);
  const cu = await sshLoose(FIRECELL, `grep -Ei "UE|RNTI|RRC|Initial|PDU|NAS|DRB|GTP|F1-U|error|fail" ${CU_QUECTEL_LOG} 2>/dev/null | tail -160 || true`, 20000);
  const amf = await sshLoose(FIRECELL, 'docker logs --tail=160 oai-cn5g-minipc-oai-amf-1 2>&1 | grep -Ei "5GMM|UE|registration|Initial|PDU|reject|fail|error" | tail -120 || true', 20000);
  const smf = await sshLoose(FIRECELL, 'docker logs --tail=160 oai-cn5g-minipc-oai-smf-1 2>&1 | grep -Ei "PDU|session|DNN|subscription|UPF|context|reject|fail|error" | tail -120 || true', 20000);
  return sanitizeCapture([
    '=== access DU UE/RACH diagnostics ===',
    du.combined || '<no access DU UE/RACH lines>',
    '=== CU UE/session diagnostics ===',
    cu.combined || '<no CU UE/session lines>',
    '=== AMF UE diagnostics ===',
    amf.combined || '<no AMF UE lines>',
    '=== SMF/PDU diagnostics ===',
    smf.combined || '<no SMF/PDU lines>',
  ].join('\n'));
}

async function prepareEthernetDuConfig(minipc) {
  if (!minipc?.mgmtIp) throw new Error('Live minipc management IP is required for Ethernet DU runtime config');
  const cmd = [
    'set -euo pipefail',
    `test -f ${DU_CONF}`,
    `cp ${DU_CONF} ${DU_ETHERNET_RUNTIME_CONF}`,
    `perl -0pi -e ${shellQuote(`s/local_n_address\\s*=\\s*"[^"]+"/local_n_address = "${minipc.mgmtIp}"/; s/remote_n_address\\s*=\\s*"[^"]+"/remote_n_address = "${FIRECELL.split('@').pop()}"/;`)} ${DU_ETHERNET_RUNTIME_CONF}`,
    `grep -En 'local_n_address|remote_n_address|sdr_addrs' ${DU_ETHERNET_RUNTIME_CONF}`,
  ].join('\n');
  return await sshChecked(minipc.host, cmd, 15000);
}

async function validateEthernetPacketPlacement(dir, minipc) {
  if (!minipc?.host || !minipc?.mgmtIface) throw new Error('Live minipc Ethernet interface is required for packet validation');
  const firecellRoute = await sshChecked(FIRECELL, `ip route get ${minipc.mgmtIp}`, 10000);
  const firecellEth = parseRouteDevSrc(firecellRoute).dev || 'enp6s0';
  const minipcNonEthernet = await discoverMgmtInterfaces(minipc.host, [minipc.mgmtIface]);
  const firecellNonEthernet = await discoverMgmtInterfaces(FIRECELL, [firecellEth]);
  const extraJobs = [
    ...minipcNonEthernet.map(iface => ({ host: minipc.host, label: 'minipc', iface })),
    ...firecellNonEthernet.map(iface => ({ host: FIRECELL, label: 'firecell', iface })),
    { host: minipc.host, label: 'minipc', iface: WG_IF },
    { host: FIRECELL, label: 'firecell', iface: WG_IF },
  ];
  const [minipcF1, firecellF1, ...extraCaps] = await Promise.all([
    capturePacketGate(minipc.host, minipc.mgmtIface, `host ${FIRECELL.split('@').pop()} and sctp`, 45, 30),
    capturePacketGate(FIRECELL, firecellEth, `host ${minipc.mgmtIp} and sctp`, 45, 30),
    ...extraJobs.map(item => capturePacketGate(item.host, item.iface, 'sctp or udp port 2153', 12, 5)),
  ]);
  const extraCaptures = extraJobs.map((item, idx) => ({ ...item, cap: extraCaps[idx] || '' }));
  appendEvidence(dir, 'measurements/ethernet-packet-validation.txt', [
    `=== minipc ${minipc.mgmtIface} F1-C ===`, minipcF1,
    `=== firecell ${firecellEth} F1-C ===`, firecellF1,
    '=== non-Ethernet no-F1 captures ===',
    ...extraCaptures.map(item => `--- ${item.label} ${item.iface} ---\n${item.cap || '<no packets>'}`),
  ].join('\n'));
  console.log(`\n  ${BOLD}minipc ${minipc.mgmtIface} F1-C${RESET}`);
  await showLines(minipcF1 || '<no packets>');
  console.log(`\n  ${BOLD}firecell ${firecellEth} F1-C${RESET}`);
  await showLines(firecellF1 || '<no packets>');
  const f1cOk = (hasPacketLines(minipcF1) || hasPacketLines(firecellF1)) && /sctp/i.test(minipcF1 + firecellF1);
  const isolatedOk = extraCaptures.every(item => !hasPacketLines(item.cap));
  if (!f1cOk || !isolatedOk) throw new Error('Ethernet packet gate failed: F1-C was not proven on Ethernet or leaked to a non-Ethernet interface');
  return { minipcF1, firecellF1, extraCaptures, firecellEth };
}

function restartSplitCoreCmd() {
  return [
    `cd ${CU_CN_DIR}`,
    `(docker compose -f ${CU_CN_COMPOSE} down || docker-compose -f ${CU_CN_COMPOSE} down || true)`,
    `(docker compose -f ${CU_CN_COMPOSE} up -d || docker-compose -f ${CU_CN_COMPOSE} up -d)`,
  ].join('\n');
}

async function showLines(text, indent = '    ') {
  stripAnsi(text).split('\n').filter(Boolean).slice(-20).forEach(line => console.log(`${indent}${GRAY}${line}${RESET}`));
}

async function checkSsh(host, label) {
  try {
    const out = await ssh(host, 'hostname', 10000);
    printSuccess(`${label}: ${out}`);
    return true;
  } catch (err) {
    printError(`${label}: ${err.message}`);
    return false;
  }
}

async function hardStopSplit(minipcHost = MINIPC) {
  printInfo('Stopping known CU/donor softmodems on serber-firecell by config path...');
  await sshLoose(FIRECELL, stopSoftmodemsByConfigsCmd([CU_CONF, CU_QUECTEL_CONF, FIRECELL_DONOR_DU_CONF, FIRECELL_DONOR_GNB_RUNTIME_CONF, FIRECELL_DONOR_PROD_CONF, MONO_CONF]), 15000);
  printInfo('Stopping known DU softmodems on serber-minipc by config path...');
  await sshLoose(minipcHost, stopSoftmodemsByConfigsCmd([DU_CONF, DU_ETHERNET_RUNTIME_CONF, DU_QUECTEL_CONF]), 15000);
  printSuccess('Known softmodem processes stopped');
}

async function blockOaiPcF1ForMinipcDemo() {
  printInfo('Temporarily blocking competing oai-pc F1 peer on serber-firecell...');
  const rule = `-s ${OAI_PC_IP} -p sctp --dport 38472 -j DROP`;
  const cmd = `sudo -n iptables -C INPUT ${rule} 2>/dev/null || sudo -n iptables -I INPUT 1 ${rule}`;
  const out = await sshLoose(FIRECELL, cmd, 10000);
  if (out.ok) printSuccess('oai-pc F1 peer isolated for minipc rollback demo');
  else printWarn(`Could not add oai-pc F1 block: ${out.combined || 'unknown error'}`);
}

async function unblockOaiPcF1() {
  printInfo('Removing temporary oai-pc F1 block if present...');
  const rule = `-s ${OAI_PC_IP} -p sctp --dport 38472 -j DROP`;
  await sshLoose(FIRECELL, `while sudo -n iptables -C INPUT ${rule} 2>/dev/null; do sudo -n iptables -D INPUT ${rule}; done`, 10000);
}

async function stopMonolithicOnly() {
  printInfo('Stopping monolithic nr-softmodem on serber-firecell by config path...');
  await sshLoose(MONO_HOST, stopSoftmodemByConfigCmd(MONO_CONF), 15000);
  printInfo('Stopping monolithic core containers...');
  await sshLoose(MONO_HOST, `cd ${MONO_CN} && docker compose down 2>/dev/null || docker-compose down 2>/dev/null || true`, 60000);
  printSuccess('Monolithic stack stopped');
}

async function stopMonolithicCoreForSplit() {
  printInfo('Stopping firecell monolithic core containers to avoid split-core conflicts...');
  const out = await sshLoose(FIRECELL, `cd ${MONO_CN} && docker compose down 2>/dev/null || docker-compose down 2>/dev/null || true`, 60000);
  if (out.combined) await showLines(out.combined);
  printSuccess('Firecell monolithic core is down for Ethernet split startup');
}

async function stopSplitCoreForMonolithic() {
  printInfo('Stopping firecell split-core containers to avoid monolithic conflicts...');
  const out = await sshLoose(FIRECELL, `cd ${CU_CN_DIR} && (docker compose -f ${CU_CN_COMPOSE} down || docker-compose -f ${CU_CN_COMPOSE} down || true)`, 60000);
  if (out.combined) await showLines(out.combined);
  printSuccess('Firecell split core is down for monolithic startup');
}

async function showSplitCoreHealth(dir) {
  const cmd = [
    'echo "--- AMF UE/gNB state ---"',
    'docker logs oai-cn5g-minipc-oai-amf-1 --tail 100 2>&1 | grep -Ei "gNB|UEs|REGISTERED|DEREGISTERED|reject|fail|error|Initial Context" || true',
    'echo "--- SMF PDU state ---"',
    'docker logs oai-cn5g-minipc-oai-smf-1 --tail 120 2>&1 | grep -Ei "PDU|session|DNN|subscription|reject|fail|error|UPF|context" || true',
    'echo "--- UPF state ---"',
    'docker logs oai-cn5g-minipc-oai-upf-1 --tail 80 2>&1 | grep -Ei "session|PDR|FAR|TEID|error|fail|warn" || true',
  ].join('\n');
  const out = await sshLoose(FIRECELL, cmd, 25000);
  if (out.combined) {
    await showLines(out.combined);
    appendEvidence(dir, 'logs/core-health.log', out.combined);
  }
  if (/DNN subscription not found|smf_context not found|reject|fail|error/i.test(out.combined)) {
    printWarn('Core health shows a PDU/session warning. Check phone APN/DNN is set to "oai" and retry airplane mode.');
  }
}

async function validateMonolithicIsolation(dir, minipc) {
  const firecellEth = parseRouteDevSrc(await sshChecked(FIRECELL, `ip route get ${minipc.mgmtIp}`, 10000)).dev || 'enp6s0';
  const minipcDu = await sshChecked(minipc.host, 'ps -eo pid=,comm=,args= | awk \'$2 == "nr-softmodem" { print }\' || true', 10000);
  const splitCore = await sshChecked(FIRECELL, 'docker ps --format "{{.Names}}" | grep "^oai-cn5g-minipc" || true', 10000);
  const [firecellF1, minipcF1, firecellWg, minipcWg] = await Promise.all([
    capturePacketGate(FIRECELL, firecellEth, `host ${minipc.mgmtIp} and (sctp or udp port 2153)`, 12, 5),
    capturePacketGate(minipc.host, minipc.mgmtIface, `host ${FIRECELL.split('@').pop()} and (sctp or udp port 2153)`, 12, 5),
    capturePacketGate(FIRECELL, WG_IF, 'sctp or udp port 2153', 12, 5),
    capturePacketGate(minipc.host, WG_IF, 'sctp or udp port 2153', 12, 5),
  ]);
  appendEvidence(dir, 'measurements/monolithic-isolation.txt', [
    '=== live minipc nr-softmodem processes ===', minipcDu || '<none>',
    '=== split core containers ===', splitCore || '<none>',
    `=== firecell ${firecellEth} split-F1 capture ===`, firecellF1 || '<no packets>',
    `=== minipc ${minipc.mgmtIface} split-F1 capture ===`, minipcF1 || '<no packets>',
    `=== firecell ${WG_IF} F1 capture ===`, firecellWg || '<no packets>',
    `=== minipc ${WG_IF} F1 capture ===`, minipcWg || '<no packets>',
  ].join('\n'));
  await showLines(`minipc DU processes:\n${minipcDu || '<none>'}\nsplit core containers:\n${splitCore || '<none>'}`);
  const noMinipcDu = !/nr-softmodem/.test(minipcDu);
  const noSplitCore = !/oai-cn5g-minipc/.test(splitCore);
  const noSplitF1 = [firecellF1, minipcF1, firecellWg, minipcWg].every(cap => !hasPacketLines(cap));
  if (!noMinipcDu || !noSplitCore || !noSplitF1) throw new Error('Monolithic isolation failed: split DU/core or split F1 traffic is still visible');
  return { firecellEth };
}

async function startEthernetRollback() {
  console.clear();
  printHeader('Ethernet CU/DU Rollback Startup');
  const dir = runDir('ethernet_cu_du_rollback_start');
  printInfo(`Evidence directory: ${dir}`);
  const gate = {};
  let minipc = null;

  try {
    printStep(1, 12, 'Connect to lab hosts and discover live minipc');
    if (!await checkSsh(FIRECELL, 'serber-firecell')) throw new Error('serber-firecell SSH failed');
    minipc = await discoverMinipcTarget();
    printSuccess(`serber-minipc via ${minipc.host}${minipc.mgmtIface ? ` (${minipc.mgmtIface} ${minipc.mgmtIp})` : ''}`);
    appendEvidence(dir, 'system-status/minipc-discovery.txt', minipc.raw);
    const governors = await Promise.all([
      enforcePerformanceGovernors(FIRECELL, 'serber-firecell'),
      enforcePerformanceGovernors(minipc.host, 'serber-minipc'),
    ]);
    appendEvidence(dir, 'system-status/cpu-governors.txt', governors.join('\n\n'));
    gate.hosts = true;

    printStep(2, 12, 'Stop previous OAI softmodems for this demo');
    await hardStopSplit(minipc.host);
    gate.stopped = true;

    printStep(3, 12, 'Stop conflicting monolithic core on serber-firecell');
    await stopMonolithicCoreForSplit();
    gate.monolithicCoreStopped = true;

    printStep(4, 12, 'Isolate minipc rollback from competing oai-pc DU');
    await blockOaiPcF1ForMinipcDemo();
    gate.oaiPcIsolated = true;

    printStep(5, 12, 'Detect DU USRP B210');
    const usrp = await ssh(minipc.host, 'uhd_find_devices 2>&1 || sudo -n uhd_find_devices 2>&1 || lsusb | grep -Ei "ettus|usrp|b210|national"', 25000);
    await showLines(usrp);
    appendEvidence(dir, 'system-status/du-usrp.txt', usrp);
    if (!/B210|b200|type|serial/i.test(usrp)) throw new Error('DU USRP B210 was not clearly detected');
    printSuccess('DU USRP detected');
    gate.usrp = true;

    printStep(6, 12, 'Start split 5G Core on serber-firecell');
    const core = await ssh(FIRECELL, restartSplitCoreCmd(), 120000);
    if (core) await showLines(core);
    appendEvidence(dir, 'logs/core-start.log', core);
    printSuccess('Core start command completed');
    await sleep(5000);

    await provisionLabPhoneSubscriber(dir);
    gate.core = true;

    printStep(7, 12, 'Prepare DU runtime config from live Ethernet address');
    const duRuntime = await prepareEthernetDuConfig(minipc);
    await showLines(duRuntime);
    appendEvidence(dir, 'system-status/du-runtime-config.txt', duRuntime);
    gate.duConfig = true;

    printStep(8, 12, 'Start CU on serber-firecell');
    const cuStart = await sshChecked(FIRECELL, startSoftmodemCmd(`${CU_OAI}/cmake_targets/ran_build/build`, CU_CONF, CU_LOG, '--log_config.global_log_level info'), 20000);
    if (cuStart) await showLines(cuStart);
    await sleep(5000);
    const cuProc = await ssh(FIRECELL, 'pgrep -a nr-softmodem || true');
    console.log(`    ${GRAY}${cuProc || 'no CU process found yet'}${RESET}`);
    if (!cuProc.includes('nr-softmodem')) throw new Error('CU process did not remain running');
    gate.cu = true;

    printStep(9, 12, 'Start DU on serber-minipc');
    const duStart = await sshChecked(minipc.host, [
      stopSoftmodemByConfigCmd(DU_CONF),
      stopSoftmodemByConfigCmd(DU_ETHERNET_RUNTIME_CONF),
      startSoftmodemCmd(`${DU_OAI}/cmake_targets/ran_build/build`, DU_ETHERNET_RUNTIME_CONF, DU_LOG, '--log_config.global_log_level info -E'),
    ].join('\n'), 20000);
    if (duStart) await showLines(duStart);
    await sleep(7000);
    const duProc = await ssh(minipc.host, 'pgrep -a nr-softmodem || true');
    console.log(`    ${GRAY}${duProc || 'no DU process found yet'}${RESET}`);
    if (!duProc.includes('nr-softmodem')) throw new Error('DU process did not remain running');
    gate.du = true;

    printStep(10, 12, 'Validate F1/PWS milestones');
    const cuLog = await sshLoose(FIRECELL, `grep -Ei "F1|connected|PWS|SIB8|UE|error|assert" ${CU_LOG} 2>/dev/null | tail -25 || tail -25 ${CU_LOG} 2>/dev/null || true`);
    const duLog = await sshLoose(minipc.host, `grep -Ei "F1|connected|PWS|SIB8|MCS|BLER|SNR|UHD|B210|sync|error|assert" ${DU_LOG} 2>/dev/null | tail -60 || tail -60 ${DU_LOG} 2>/dev/null || true`);
    console.log(`\n  ${BOLD}CU log${RESET}`);
    await showLines(cuLog.combined);
    console.log(`\n  ${BOLD}DU log${RESET}`);
    await showLines(duLog.combined);
    appendEvidence(dir, 'logs/cu-milestones.log', cuLog.combined);
    appendEvidence(dir, 'logs/du-milestones.log', duLog.combined);
    const cuOk = /F1AP_CU_SCTP_REQ|CU_handle_F1_SETUP_REQUEST|F1 Setup Request/i.test(cuLog.combined);
    const duOk = /DU_handle_F1_SETUP_RESPONSE|received F1 Setup Response/i.test(duLog.combined);
    const radioOk = /got sync|B210|Found USRP/i.test(duLog.combined);
    if (!cuOk || !duOk || !radioOk) throw new Error('Ethernet CU/DU logs did not show F1 setup and radio sync evidence');
    gate.f1Logs = true;

    printStep(11, 12, 'Packet validation: F1-C on Ethernet, no F1 on WiFi/Quectel/WireGuard');
    await validateEthernetPacketPlacement(dir, minipc);
    gate.packet = true;

    printStep(12, 12, 'Phone demo prompt and core health');
    console.log('\n    Bring the Nothing Phone near the demo area.');
    console.log('    Confirm the phone APN/DNN is "oai".');
    console.log('    Toggle airplane mode, wait for 5G, then observe PWS/SIB8 and run throughput.');
    await showSplitCoreHealth(dir);
    gate.coreHealth = true;
    appendEvidence(dir, 'measurements/gates.json', JSON.stringify(gate, null, 2));
    printSuccess('PASS: Ethernet CU/DU is running with F1-C on Ethernet, DU radio sync, and no F1 on WiFi/Quectel/WireGuard');
  } catch (err) {
    appendEvidence(dir, 'measurements/gates.json', JSON.stringify(gate, null, 2));
    printError(err.message);
    printWarn('Evidence was still written where available. Use Logs view for details.');
  }

  await prompt('Press Enter to continue');
}

// stopEthernet has been combined into stopAllConfigs

async function startMonolithic() {
  console.clear();
  printHeader('Monolithic Reference Startup');
  const dir = runDir('monolithic_reference_start');
  printInfo(`Evidence directory: ${dir}`);
  const gate = {};
  let minipc = null;
  try {
    printStep(1, 8, 'Connect to firecell and discover live minipc');
    if (!await checkSsh(MONO_HOST, 'serber-firecell')) throw new Error('serber-firecell SSH failed');
    minipc = await discoverMinipcTarget();
    printSuccess(`serber-minipc via ${minipc.host}${minipc.mgmtIface ? ` (${minipc.mgmtIface} ${minipc.mgmtIp})` : ''}`);
    appendEvidence(dir, 'system-status/minipc-discovery.txt', minipc.raw);
    gate.hosts = true;

    printStep(2, 8, 'Stop split/old gNB processes before monolithic demo');
    await hardStopSplit(minipc.host);
    await unblockOaiPcF1();
    gate.softmodemsStopped = true;

    printStep(3, 8, 'Stop split core before monolithic core startup');
    await stopSplitCoreForMonolithic();
    gate.splitCoreStopped = true;

    printStep(4, 8, 'Detect firecell USRP B210');
    const monoUsrp = await sshLoose(MONO_HOST, 'uhd_find_devices 2>&1 || true', 25000);
    if (!/B210|b200|type|serial/i.test(monoUsrp.combined)) throw new Error('serber-firecell cannot see the B210 USRP for monolithic startup');
    await showLines(monoUsrp.combined);
    appendEvidence(dir, 'system-status/firecell-usrp.txt', monoUsrp.combined);
    printSuccess('Firecell USRP detected');
    gate.usrp = true;

    printStep(5, 8, 'Start monolithic Core');
    const core = await ssh(MONO_HOST, `cd ${MONO_CN} && (docker compose up -d || docker-compose up -d)`, 90000);
    appendEvidence(dir, 'logs/core-start.log', core);
    await sleep(8000);
    printSuccess('Core containers started');
    gate.core = true;

    printStep(6, 8, 'Start monolithic gNB');
    const start = await sshChecked(MONO_HOST, startSoftmodemCmd(`${MONO_OAI}/cmake_targets/ran_build/build`, MONO_CONF, MONO_LOG, '-E --continuous-tx'), 20000);
    if (start) await showLines(start);
    appendEvidence(dir, 'logs/monolithic-start.log', start);
    await sleep(7000);
    const proc = await ssh(MONO_HOST, 'pgrep -a nr-softmodem || true');
    console.log(`    ${GRAY}${proc || 'no gNB process found yet'}${RESET}`);
    if (!proc.includes('nr-softmodem')) throw new Error('monolithic gNB process did not remain running');
    gate.gnb = true;

    printStep(7, 8, 'Validate monolithic AMF/gNB/SIB8/radio milestones');
    const logs = await sshLoose(MONO_HOST, `docker logs oai-amf 2>&1 | grep -Ei "gnb|register|UEs|NGSetup|attach|fail|error" | tail -50; grep -Ei "NGSetup|in service|SIB8|PWS|UHD|B210|got sync|error|assert|fail" ${MONO_LOG} 2>/dev/null | tail -80 || true`, 20000);
    await showLines(logs.combined);
    appendEvidence(dir, 'logs/monolithic-status.log', logs.combined);
    const amfOk = /gNB.*attached|A new gNB has been successfully added|NGSetup/i.test(logs.combined);
    const sib8Ok = /SIB8|PWS/i.test(logs.combined);
    const radioOk = /B210|got sync/i.test(logs.combined);
    if (!amfOk || !sib8Ok || !radioOk) throw new Error('Monolithic logs did not show AMF attach, SIB8, and radio sync evidence');
    gate.milestones = true;

    printStep(8, 8, 'Validate monolithic isolation from split CU/DU');
    await validateMonolithicIsolation(dir, minipc);
    gate.isolation = true;

    console.log('\n    Toggle airplane mode on the phone, wait for registration, then show data/PWS.');
    appendEvidence(dir, 'measurements/gates.json', JSON.stringify(gate, null, 2));
    printSuccess('PASS: Monolithic firecell gNB/core is running with AMF attach, SIB8, radio sync, and no split CU/DU traffic');
  } catch (err) {
    appendEvidence(dir, 'measurements/gates.json', JSON.stringify(gate, null, 2));
    printError(err.message);
    printWarn('No PASS claimed. Evidence was still written where available.');
  }
  await prompt('Press Enter to continue');
}

async function statusView() {
  console.clear();
  printHeader('Lab Status');
  const minipc = await discoverMinipcTarget();
  const checks = [
    ['serber-firecell host', FIRECELL, 'hostname; ip -br addr | sed -n "1,12p"; pgrep -a nr-softmodem || true; docker ps --format "{{.Names}}: {{.Status}}" | head -15'],
    [`serber-minipc host (${minipc.host})`, minipc.host, 'hostname; ip -br addr | sed -n "1,12p"; pgrep -a nr-softmodem || true; if pgrep -x nr-softmodem >/dev/null; then echo "USRP check: skipped because nr-softmodem is running and may own the B210"; else uhd_find_devices 2>&1 | tail -20 || true; fi'],
  ];
  for (const [label, host, cmd] of checks) {
    console.log(`\n  ${BOLD}${label}${RESET}`);
    console.log('  ' + '─'.repeat(54));
    const out = await sshLoose(host, cmd, 25000);
    if (out.ok) await showLines(out.combined);
    else printError(out.combined);
  }
  await prompt('Press Enter to continue');
}

