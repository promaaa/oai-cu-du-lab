async function stopAllConfigs(minipcHost = null) {
  console.clear();
  printHeader('Stop Running Configuration');
  printInfo('This action stops every possible running configuration (monolithic, Ethernet split, Quectel split).');

  let target = MINIPC;
  let minipc = null;
  try {
    minipc = await discoverMinipcTarget();
    target = minipc.host;
    printSuccess(`Discovered minipc: ${target}`);
  } catch (err) {
    printWarn('Minipc target not auto-discovered; using default host address for stop commands.');
  }

  const fullStop = await confirm('Stop split 5GC core on firecell as well?', false);
  const totalSteps = fullStop ? 7 : 6;

  // Step 1: Stop monolithic nr-softmodem and containers
  printStep(1, totalSteps, 'Stopping monolithic stack');
  await sshLoose(MONO_HOST, stopSoftmodemByConfigCmd(MONO_CONF), 15000);
  await sshLoose(MONO_HOST, `cd ${MONO_CN} && docker compose down 2>/dev/null || docker-compose down 2>/dev/null || true`, 60000);
  printSuccess('Monolithic stack stopped');

  // Step 2: Stop split softmodems (Ethernet, Quectel)
  printStep(2, totalSteps, 'Stopping all CU/DU/donor DU softmodem processes');
  await hardStopSplit(target);
  printSuccess('All softmodem processes stopped');

  // Step 3: Remove temporary oai-pc F1 block rule if present
  printStep(3, totalSteps, 'Removing F1 blocking rules');
  await unblockOaiPcF1();
  printSuccess('F1 blocking rules removed');

  // Step 4: Query Quectel IP
  let settingsIp = '';
  try {
    const quectel = await discoverQuectel(target, 'oai');
    if (quectel?.settings?.ip) {
      settingsIp = quectel.settings.ip;
    }
  } catch (err) {
    // Ignore discovery errors during stop
  }

  // Step 5: Stop WireGuard and clean Quectel routes/rules
  printStep(4, totalSteps, 'Stopping WireGuard and cleaning Quectel routes');
  await sshLoose(target, `sudo -n systemctl stop wg-quick@${WG_IF} || true`, 15000);
  await sshLoose(FIRECELL, `sudo -n systemctl stop wg-quick@${WG_IF} || true`, 15000);

  const cleanRoutesCmd = [
    'for dev in wwan0 usb0 rmnet_data0; do',
    `  sudo -n ip route del ${FIRECELL_WG_ENDPOINT_IP}/32 dev "$dev" 2>/dev/null || true`,
    'done',
    `sudo -n ip rule del from ${WG_DU_IP} lookup 250 priority 250 2>/dev/null || true`,
    `sudo -n ip rule del from all to ${WG_DU_IP} lookup 9999 2>/dev/null || true`,
    `sudo -n ip rule del from ${WG_DU_IP} lookup 9999 2>/dev/null || true`,
  ].join('\n');
  await sshLoose(target, cleanRoutesCmd, 15000);

  if (settingsIp) {
    await sshLoose(FIRECELL, `sudo -n ip route del ${settingsIp}/32 via ${OAI_UPF_IP} dev ${OAI_CN5G_BRIDGE_IF} 2>/dev/null || true`, 15000);
  }
  printSuccess('WireGuard stopped and Quectel routes cleaned');

  let currentStep = 5;
  if (fullStop) {
    printStep(currentStep, totalSteps, 'Stopping split 5GC core on serber-firecell');
    const stopCoreCmd = `cd ${CU_CN_DIR} && (docker compose -f ${CU_CN_COMPOSE} down || docker-compose -f ${CU_CN_COMPOSE} down || true)`;
    const stopCoreOut = await sshLoose(FIRECELL, stopCoreCmd, 60000);
    if (stopCoreOut.combined) await showLines(stopCoreOut.combined);
    printSuccess('Split 5GC core stopped');
    currentStep++;
  }

  // Step 7: Confirm management access
  printStep(currentStep, totalSteps, 'Confirming management access');
  await checkSsh(FIRECELL, 'serber-firecell');
  await checkSsh(target, 'serber-minipc');
  await prompt('Press Enter to continue');
}

async function launchSingleCuQuectelBackhaul() {
  console.clear();
  printHeader('Launch Single-CU Quectel Backhaul');
  const dir = runDir('caged_quectel_f1_backhaul_start');
  printInfo(`Evidence directory: ${dir}`);
  printWarn('This scenario uses one 5GC and one CU on firecell, with a local donor DU for Quectel and a caged minipc access DU over WireGuard. PASS is packet-gated.');

  const gate = {};
  let minipc = null;
  let quectel = null;
  const apn = await prompt('Quectel APN for firecell donor DU', 'oai');
  const quectelImsi = process.env.QUECTEL_IMSI || await prompt('Quectel IMSI for local core provisioning', '');

  try {
    printStep(1, 14, 'Hardware preflight and live minipc discovery');
    minipc = await discoverMinipcTarget();
    printSuccess(`serber-minipc via ${minipc.host}${minipc.mgmtIface ? ` (${minipc.mgmtIface} ${minipc.mgmtIp})` : ''}`);
    appendEvidence(dir, 'system-status/minipc-discovery.txt', minipc.raw);
    await checkSsh(FIRECELL, 'serber-firecell');
    const hw = await sshChecked(minipc.host, [
      'hostname',
      'ip -br link',
      'ip -4 -br addr',
      'ls -l /dev/cdc-wdm* /dev/ttyUSB* 2>/dev/null || true',
      `if pgrep -x nr-softmodem >/dev/null; then echo "USRP check skipped: nr-softmodem owns the radio"; else uhd_find_devices --args serial=${ACCESS_B210_SERIAL} 2>&1 || sudo -n uhd_find_devices --args serial=${ACCESS_B210_SERIAL} 2>&1 || true; fi`,
      'pgrep -a nr-softmodem || true',
    ].join('\n'), 30000);
    await showLines(hw);
    appendEvidence(dir, 'system-status/hardware-preflight.txt', hw);
    if (!/\/dev\/cdc-wdm|\/dev\/ttyUSB/i.test(hw)) throw new Error('Quectel control devices were not visible on minipc');
    if (!/B210|USRP check skipped/i.test(hw)) throw new Error('B210 serial 8002816 was not visible and no running softmodem explained radio ownership');
    gate.hardware = true;

    printStep(2, 14, 'Firecell split core');
    const core = await sshChecked(FIRECELL, [
      restartSplitCoreCmd(),
      'sleep 5',
      `ip -4 addr show dev ${OAI_CN5G_BRIDGE_IF} | grep -q '192.168.71.140/26' || sudo -n ip addr add 192.168.71.140/26 dev ${OAI_CN5G_BRIDGE_IF}`,
      `ip -4 addr show dev ${OAI_CN5G_BRIDGE_IF}`,
      'docker ps --format "{{.Names}} {{.Status}}" | grep oai-cn5g-minipc || true',
    ].join('\n'), 120000);
    await showLines(core);
    appendEvidence(dir, 'logs/core-start.log', core);
    if (!/192\.168\.71\.129/i.test(core) || !/192\.168\.71\.140/i.test(core) || !/healthy|Up/i.test(core)) {
      throw new Error('Firecell split core did not show expected bridge/container evidence');
    }
    gate.core = true;

    printStep(3, 14, 'Provision Quectel subscriber in active split core');
    const seed = await provisionQuectelSubscriber(quectelImsi);
    await showLines(seed);
    appendEvidence(dir, 'system-status/quectel-subscriber-seed.log', seed);
    gate.subscriber = true;

    printStep(4, 14, 'Generate shared-CU, donor-DU, and access-DU configs');
    const configs = await prepareCagedSplitConfigs(minipc.host);
    await showLines(configs.firecell);
    await showLines(configs.minipc);
    appendEvidence(dir, 'system-status/generated-caged-configs.txt', `${configs.firecell}\n\n${configs.minipc}`);
    if (!configs.firecell.includes(DONOR_DU_ID) || !configs.minipc.includes(ACCESS_DU_ID)) {
      throw new Error('Generated config evidence did not show distinct donor/access DU IDs');
    }
    gate.configs = true;

    printStep(5, 14, 'Start shared CU before both DUs');
    const cuStart = await sshChecked(FIRECELL, [
      `test -f ${CU_QUECTEL_CONF}`,
      stopSoftmodemByConfigCmd(CU_QUECTEL_CONF),
      startSoftmodemCmd(`${CU_OAI}/cmake_targets/ran_build/build`, CU_QUECTEL_CONF, CU_QUECTEL_LOG, '--log_config.global_log_level info'),
      'sleep 8',
      'pgrep -a nr-softmodem || true',
      `tail -n 180 ${CU_QUECTEL_LOG} 2>/dev/null | grep -Ei "NGSetup|F1|SCTP|GTP|2153|38472|error|fail" || true`,
    ].join('\n'), 45000);
    await showLines(cuStart);
    appendEvidence(dir, 'logs/cu-quectel.log', cuStart);
    const cuHasSctp = /F1AP_CU_SCTP_REQ|SCTP/i.test(cuStart);
    const cuHasGtpu = /Initializing UDP|GTP|2153/i.test(cuStart);
    if (!cuHasSctp || !cuHasGtpu) throw new Error('CU log did not show both F1 SCTP and GTP-U binding evidence');
    gate.cu = true;

    printStep(6, 14, 'Start firecell donor DU locally');
    const donorStart = await sshChecked(FIRECELL, [
      `test -f ${FIRECELL_DONOR_DU_CONF}`,
      stopSoftmodemByConfigCmd(FIRECELL_DONOR_DU_CONF),
      startSoftmodemCmd(`${CU_OAI}/cmake_targets/ran_build/build`, FIRECELL_DONOR_DU_CONF, FIRECELL_DONOR_DU_LOG, '--log_config.global_log_level info -E'),
      'sleep 12',
      'pgrep -a nr-softmodem || true',
      `tail -n 220 ${FIRECELL_DONOR_DU_LOG} 2>/dev/null | grep -Ei "F1|SCTP|GTP|UHD|B200|B210|in service|PCI|PRACH|RNTI|error|fail|assert|Setup|sync" || true`,
    ].join('\n'), 60000);
    await showLines(donorStart);
    appendEvidence(dir, 'logs/firecell-donor-du.log', donorStart);
    if (!/F1 Setup Response|DU_handle_F1_SETUP_RESPONSE|received F1 Setup Response/i.test(donorStart)) throw new Error('Firecell donor DU did not show F1 setup response');
    if (!/got sync|B210|Detected Device|Found USRP/i.test(donorStart)) throw new Error('Firecell donor DU did not show donor radio evidence');
    await validateDonorLocalF1(dir);
    gate.donorDu = true;

    printStep(7, 14, 'Quectel donor registration reset through firecell donor DU');
    const registration = await resetQuectelRegistration(minipc.host);
    await showLines(registration);
    appendEvidence(dir, 'system-status/quectel-registration.log', registration);
    gate.registration = true;

    printStep(8, 14, 'Quectel QMI/PDU session on minipc');
    quectel = await discoverQuectel(minipc.host, apn);
    await showLines(quectel.raw);
    appendEvidence(dir, 'system-status/quectel-qmi.txt', quectel.raw);
    if (!quectel.iface || !quectel.settings.ip || !quectel.settings.gateway) {
      throw new Error('Quectel PDU IP/gateway were not discovered from live QMI settings');
    }
    printSuccess(`Quectel PDU: ${quectel.iface} ${quectel.settings.ip}/${quectel.settings.prefix} via ${quectel.settings.gateway}`);
    gate.quectel = true;

    printStep(9, 14, 'Routes over live Quectel PDU');
    const routes = await ensurePduRoutes(minipc.host, quectel);
    await showLines(routes.minipcOut);
    await showLines(routes.firecellOut);
    appendEvidence(dir, 'system-status/quectel-routes.txt', `${routes.minipcOut}\n\n${routes.firecellOut}`);
    if (!routes.minipcOut.includes(quectel.iface) || !routes.firecellOut.includes(quectel.settings.ip)) throw new Error('Route evidence did not match the live Quectel path');
    gate.routes = true;

    printStep(10, 14, 'WireGuard tunnel');
    const wg = await ensureWireGuard(minipc.host, quectel);
    await showLines(wg.minipc);
    await showLines(wg.firecell);
    appendEvidence(dir, 'system-status/wireguard.txt', `${wg.minipc}\n\n${wg.firecell}`);
    gate.wireguard = true;

    printStep(11, 14, 'Validate independent donor path via AT commands and ping');
    const donorVal = await execLocal('bash ./scripts/quectel-f1-backhaul/02_validate_independent_donor.sh', 40000);
    await showLines(donorVal.combined);
    if (!donorVal.ok) throw new Error(`Independent donor validation failed: ${donorVal.combined}`);
    gate.donorVal = true;

    printStep(12, 14, 'Start minipc access DU over wg-quectel-f1');
    const duStart = await sshChecked(minipc.host, [
      `test -f ${DU_QUECTEL_CONF}`,
      stopSoftmodemByConfigCmd(DU_QUECTEL_CONF),
      startSoftmodemCmd(`${DU_OAI}/cmake_targets/ran_build/build`, DU_QUECTEL_CONF, DU_QUECTEL_LOG, '--log_config.global_log_level info -E'),
      'sleep 12',
      'pgrep -a nr-softmodem || true',
      `tail -n 260 ${DU_QUECTEL_LOG} 2>/dev/null | grep -Ei "F1|SCTP|GTP|UHD|B200|B210|in service|PRACH|RNTI|error|fail|assert|Setup|sync" || true`,
    ].join('\n'), 60000);
    await showLines(duStart);
    appendEvidence(dir, 'logs/du-quectel.log', duStart);
    const duHasF1Setup = /F1 Setup Response|DU_handle_F1_SETUP_RESPONSE|received F1 Setup Response/i.test(duStart);
    const duHasRadio = /got sync|B210|Detected Device/i.test(duStart);
    if (!duHasF1Setup || !duHasRadio) throw new Error('DU log did not show both F1 setup response and radio sync evidence');
    gate.du = true;

    printStep(13, 14, 'Packet validation: access F1 on tunnel, WireGuard on Quectel, no management F1');
    await validateCagedPacketPlacement(dir, minipc.host, quectel);
    gate.packet = true;

    printStep(14, 14, 'UE/F1-U validation during phone traffic and rollback readiness');
    await validateCagedF1u(dir, minipc.host, 3);
    gate.ueF1u = true;

    await checkSsh(FIRECELL, 'serber-firecell management');
    await checkSsh(minipc.host, 'serber-minipc management');
    appendEvidence(dir, 'measurements/gates.json', JSON.stringify(gate, null, 2));
    printSuccess('PASS: donor DU F1 is local, minipc F1-C/F1-U are on wg-quectel-f1, WireGuard UDP is on the live Quectel interface, and management interfaces carried no minipc F1');
  } catch (err) {
    appendEvidence(dir, 'measurements/gates.json', JSON.stringify(gate, null, 2));
    printError(err.message);
    printWarn('No PASS claimed. Use the rollback action if the lab should return to Ethernet/WiFi baseline state.');
  }

  await prompt('Press Enter to continue');
}

async function validateSingleCuQuectelBackhaul() {
  console.clear();
  printHeader('Validate Single-CU Quectel Backhaul');
  const dir = runDir('caged_quectel_f1_backhaul_validate');
  printInfo(`Evidence directory: ${dir}`);
  const gate = {};
  let minipc = null;
  let quectel = null;
  const apn = await prompt('Quectel APN for live PDU refresh', 'oai');

  try {
    printStep(1, 7, 'Discover live minipc and Quectel PDU');
    minipc = await discoverMinipcTarget();
    printSuccess(`serber-minipc via ${minipc.host}${minipc.mgmtIface ? ` (${minipc.mgmtIface} ${minipc.mgmtIp})` : ''}`);
    appendEvidence(dir, 'system-status/minipc-discovery.txt', minipc.raw);
    quectel = await discoverQuectel(minipc.host, apn);
    await showLines(quectel.raw);
    appendEvidence(dir, 'system-status/quectel-qmi.txt', quectel.raw);
    if (!quectel.settings.ip || !quectel.settings.gateway) throw new Error('Live Quectel PDU did not expose IPv4 address and gateway');
    printSuccess(`Quectel PDU: ${quectel.iface} ${quectel.settings.ip}/${quectel.settings.prefix} via ${quectel.settings.gateway}`);
    gate.quectel = true;

    printStep(2, 7, 'Refresh routes over live Quectel PDU');
    const routes = await ensurePduRoutes(minipc.host, quectel);
    await showLines(routes.minipcOut);
    await showLines(routes.firecellOut);
    appendEvidence(dir, 'system-status/routes.txt', `${routes.minipcOut}\n\n${routes.firecellOut}`);
    gate.routes = true;

    printStep(3, 7, 'Refresh WireGuard tunnel');
    const wg = await ensureWireGuard(minipc.host, quectel);
    await showLines(wg.minipc);
    await showLines(wg.firecell);
    appendEvidence(dir, 'system-status/wireguard.txt', `${wg.minipc}\n\n${wg.firecell}`);
    gate.wireguard = true;

    printStep(4, 7, 'Validate independent donor path via AT commands and ping');
    const donorVal = await execLocal('bash ./scripts/quectel-f1-backhaul/02_validate_independent_donor.sh', 40000);
    await showLines(donorVal.combined);
    if (!donorVal.ok) throw new Error(`Independent donor validation failed: ${donorVal.combined}`);
    gate.donorVal = true;

    printStep(5, 7, 'Confirm running CU, firecell donor DU, and minipc access DU split state');
    const cu = await sshChecked(FIRECELL, `grep -Ei "F1AP_CU_SCTP_REQ|CU_handle_F1_SETUP_REQUEST|GTPU.*2153|SCTP|error|fail" ${CU_QUECTEL_LOG} 2>/dev/null | tail -80 || true`, 15000);
    const donor = await sshChecked(FIRECELL, `grep -Ei "DU_handle_F1_SETUP_RESPONSE|received F1 Setup Response|got sync|B210|SCTP|error|fail" ${FIRECELL_DONOR_DU_LOG} 2>/dev/null | tail -80 || true`, 15000);
    const du = await sshChecked(minipc.host, `grep -Ei "DU_handle_F1_SETUP_RESPONSE|received F1 Setup Response|got sync|B210|SCTP|error|fail" ${DU_QUECTEL_LOG} 2>/dev/null | tail -80 || true`, 15000);
    await showLines(cu);
    await showLines(donor);
    await showLines(du);
    appendEvidence(dir, 'logs/cu-du-running-validation.log', `${cu}\n\n${donor}\n\n${du}`);
    if (!/F1AP_CU_SCTP_REQ|CU_handle_F1_SETUP_REQUEST/i.test(cu)) throw new Error('CU log did not show running F1 evidence');
    if (!/DU_handle_F1_SETUP_RESPONSE|received F1 Setup Response/i.test(donor)) throw new Error('Firecell donor DU log did not show running F1 setup evidence');
    if (!/DU_handle_F1_SETUP_RESPONSE|received F1 Setup Response/i.test(du)) throw new Error('DU log did not show running F1 setup evidence');
    await validateDonorLocalF1(dir);
    gate.cuDu = true;

    printStep(6, 7, 'Packet validation: F1 on tunnel, WireGuard on Quectel, no management F1');
    await validateCagedPacketPlacement(dir, minipc.host, quectel);
    gate.packet = true;

    printStep(7, 7, 'UE/F1-U validation during phone traffic');
    await validateCagedF1u(dir, minipc.host, 3);
    gate.ueF1u = true;

    await checkSsh(FIRECELL, 'serber-firecell management');
    await checkSsh(minipc.host, 'serber-minipc management');
    appendEvidence(dir, 'measurements/gates.json', JSON.stringify(gate, null, 2));
    printSuccess('PASS: donor DU F1 is local, minipc F1-C/F1-U are on wg-quectel-f1, WireGuard UDP is on the live Quectel interface, and management interfaces carried no minipc F1');
  } catch (err) {
    appendEvidence(dir, 'measurements/gates.json', JSON.stringify(gate, null, 2));
    printError(err.message);
    printWarn('No PASS claimed. The split can remain running while the phone attach/APN/user-plane issue is corrected and this validation is retried.');
  }

  await prompt('Press Enter to continue');
}

async function quectelShowcase() {
  console.clear();
  printHeader('Quectel F1 Backhaul Showcase');
  printInfo('Running read-only modem/backhaul checks from the local scripts where available.');
  const scripts = [
    'scripts/quectel-f1-backhaul/00_detect_quectel.sh',
    'scripts/quectel-f1-backhaul/01_check_quectel_connectivity.sh',
    'scripts/quectel-f1-backhaul/04_validate_backhaul_path.sh',
  ];
  for (const script of scripts) {
    console.log(`\n  ${BOLD}${script}${RESET}`);
    const out = await execLocal(`bash ${script}`, 60000);
    if (out.ok) await showLines(out.combined);
    else {
      printWarn('Script did not complete cleanly');
      await showLines(out.combined);
    }
  }
  printWarn('Full Quectel F1 is not a stable baseline unless the Quectel modem is attached through the firecell donor DU.');
  await prompt('Press Enter to continue');
}

async function getRunningConfig() {
  try {
    const proc = await sshLoose(FIRECELL, 'pgrep -a nr-softmodem || true', 3000);
    if (!proc.ok) return 'unknown (unreachable)';
    const out = proc.combined || '';
    if (out.includes('gnb-cu-minipc-quectel-backhaul.conf') || out.includes('gnb-du-firecell-donor-local-f1.conf')) {
      return 'single-CU Quectel backhaul';
    }
    if (out.includes('gnb-cu-minipc.conf')) {
      return 'Ethernet CU/DU split';
    }
    if (out.includes('gnb.sa.band78.fr1.106PRB.usrpb210.conf')) {
      return 'monolithic firecell core + gNB';
    }
    if (out.trim().length > 0) {
      return 'running (unknown config)';
    }
    return 'none';
  } catch (err) {
    return 'unknown (unreachable)';
  }
}

async function mainMenu() {
  while (true) {
    console.clear();
    printHeader('OAI CU/DU Lab Demo Console');
    console.log('\n  Demo targets:');
    console.log(`    Core/CU: ${FIRECELL}`);
    console.log(`    Monolithic reference: ${FIRECELL}`);
    console.log('    DU/USRP: discovered live for Ethernet and caged Quectel');
    console.log('\n  Ethernet and caged Quectel discover the live minipc management path each run.\n');
    const running = await getRunningConfig();
    let statusStr = running;
    if (running === 'none') {
      statusStr = `${GRAY}none${RESET}`;
    } else if (running.startsWith('unknown') || running.startsWith('running')) {
      statusStr = `${YELLOW}${running}${RESET}`;
    } else {
      statusStr = `${GREEN}${BOLD}${running}${RESET}`;
    }
    console.log(`  currently running config: ${statusStr}\n`);
    const action = await choose('What would you like to do?', [
      { name: 'Launch Ethernet CU/DU split: firecell CU + live minipc DU', value: 'start-split' },
      { name: 'Launch monolithic firecell core + gNB', value: 'start-mono' },
      { name: 'Launch single-CU Quectel backhaul', value: 'start-caged-quectel' },
      { name: 'Validate single-CU Quectel backhaul', value: 'validate-caged-quectel' },
      { name: 'Change PWS/SIB8 warning text for all TUI configs', value: 'pws' },
      { name: 'View live host/process/core status', value: 'status' },
      { name: 'View recent OAI logs and milestones', value: 'logs' },
      { name: 'Stop the current config', value: 'stop-all' },
      { name: 'Exit', value: 'exit' },
    ]);
    if (action === 'exit') break;
    if (action === 'start-split') await startEthernetRollback();
    if (action === 'start-mono') await startMonolithic();
    if (action === 'pws') await applyPws();
    if (action === 'status') await statusView();
    if (action === 'logs') await logsView();
    if (action === 'start-caged-quectel') await launchSingleCuQuectelBackhaul();
    if (action === 'validate-caged-quectel') await validateSingleCuQuectelBackhaul();
    if (action === 'stop-all') await stopAllConfigs();
  }
}

async function cli() {
  const arg = process.argv[2];
  if (arg === '--verify') {
    console.clear();
    printHeader('OAI Lab TUI Verification');
    await checkSsh(FIRECELL, 'serber-firecell');
    const minipc = await discoverMinipcTarget();
    printSuccess(`serber-minipc: ${minipc.host}${minipc.mgmtIface ? ` (${minipc.mgmtIface} ${minipc.mgmtIp})` : ''}`);
    process.exit(0);
  }
  if (arg === '--start-ethernet') {
    await startEthernetRollback();
    process.exit(0);
  }
  if (arg === '--start-mono') {
    await startMonolithic();
    process.exit(0);
  }
  if (arg === '--start-caged-quectel') {
    await launchSingleCuQuectelBackhaul();
    process.exit(0);
  }
  if (arg === '--validate-caged-quectel') {
    await validateSingleCuQuectelBackhaul();
    process.exit(0);
  }
  if (arg === '--rollback-caged-quectel') {
    await stopAllConfigs();
    process.exit(0);
  }
  await mainMenu();
  rl.close();
}

cli().catch(async err => {
  printError(err.message);
  rl.close();
  process.exit(1);
});
