#!/usr/bin/env python3
"""Operator TUI for the OAI CU/DU lab.

This is a launch-first TUI. It can start/stop/status the deployed lab modes
using local commands or SSH, while keeping credentials and machine-specific
overrides in ignored local files.
"""

from __future__ import annotations

