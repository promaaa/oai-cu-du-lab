function requestedEnvPath() {
  const envArg = process.argv.slice(2).find(arg => arg.startsWith('--env='));
  const requested = envArg?.slice('--env='.length) || process.env.OAI_LAB_ENV;
  if (requested) return path.resolve(requested);
  const candidates = [
    path.join(REPO, 'conf', 'local', 'lab.env'),
    path.join(REPO, '.env'),
  ];
  return candidates.find(candidate => {
    try {
      accessSync(candidate, fsConstants.R_OK);
      return true;
    } catch {
      return false;
    }
  }) || candidates[0];
}

function stripUnquotedComment(value) {
  let quote = '';
  for (let i = 0; i < value.length; i += 1) {
    const char = value[i];
    if ((char === '"' || char === "'") && (!quote || quote === char)) {
      quote = quote ? '' : char;
    } else if (char === '#' && !quote && (i === 0 || /\s/.test(value[i - 1]))) {
      return value.slice(0, i).trim();
    }
  }
  return value.trim();
}

function parseEnvFile(content) {
  const parsed = {};
  for (const line of content.split(/\r?\n/)) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith('#')) continue;
    const cleanLine = trimmed.replace(/^export\s+/, '');
    const idx = cleanLine.indexOf('=');
    if (idx < 1) continue;
    const key = cleanLine.slice(0, idx).trim();
    if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(key)) continue;
    let value = stripUnquotedComment(cleanLine.slice(idx + 1));
    if ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'"))) {
      value = value.slice(1, -1);
    }
    parsed[key] = value;
  }
  return parsed;
}

const ENV_PATH = requestedEnvPath();
let ENV_FILE_LOADED = false;
try {
  const parsed = parseEnvFile(readFileSync(ENV_PATH, 'utf8'));
  for (const [key, value] of Object.entries(parsed)) {
    if (process.env[key] === undefined) process.env[key] = value;
  }
  ENV_FILE_LOADED = true;
} catch {
  // The doctor/interactive preflight reports a missing environment file.
}

const STATE_ROOT = process.env.OAI_LAB_STATE_DIR
  ? path.resolve(process.env.OAI_LAB_STATE_DIR)
  : path.join(homedir(), '.local', 'state', 'oai-cu-du-lab');
const OPERATOR_LOCK_DIR = path.join(STATE_ROOT, 'operator.lock');
let operatorLockHeld = false;

function processIsAlive(pid) {
  if (!Number.isInteger(pid) || pid <= 0) return false;
  try {
    process.kill(pid, 0);
    return true;
  } catch (err) {
    return err?.code === 'EPERM';
  }
}

function readOperatorLockOwner() {
  try {
    return JSON.parse(readFileSync(path.join(OPERATOR_LOCK_DIR, 'owner.json'), 'utf8'));
  } catch {
    return {};
  }
}

function releaseOperatorLock() {
  if (!operatorLockHeld) return;
  const owner = readOperatorLockOwner();
  if (owner.pid === process.pid) rmSync(OPERATOR_LOCK_DIR, { recursive: true, force: true });
  operatorLockHeld = false;
}

function acquireOperatorLock() {
  mkdirSync(STATE_ROOT, { recursive: true });
  for (let attempt = 0; attempt < 2; attempt += 1) {
    try {
      mkdirSync(OPERATOR_LOCK_DIR);
      operatorLockHeld = true;
      const argv = process.argv.slice(2).map(arg => arg.startsWith('--env=') ? '--env=<private-path>' : arg);
      writeFileSync(path.join(OPERATOR_LOCK_DIR, 'owner.json'), `${JSON.stringify({
        pid: process.pid,
        startedAt: new Date().toISOString(),
        argv,
      }, null, 2)}\n`, { mode: 0o600 });
      process.once('exit', releaseOperatorLock);
      return;
    } catch (err) {
      if (err?.code !== 'EEXIST') throw err;
      const owner = readOperatorLockOwner();
      if (processIsAlive(Number(owner.pid))) {
        const command = Array.isArray(owner.argv) && owner.argv.length ? owner.argv.join(' ') : 'interactive menu';
        throw new Error(
          `Another OAI lab operator console is active (PID ${owner.pid}, started ${owner.startedAt || 'at an unknown time'}, command: ${command}). ` +
          'Close it before starting, stopping, or reconfiguring the lab.'
        );
      }
      rmSync(OPERATOR_LOCK_DIR, { recursive: true, force: true });
    }
  }
  throw new Error('Could not acquire exclusive OAI lab operator ownership.');
}

