        "SSH" + r"PASS=.*[^<]",
        "Private" + r"Key = [A-Za-z0-9+/=]{20,}",
        "BEGIN .*PRIVATE" + " KEY",
        "mysql -u root " + "-p" + r"[^< ]",
        "oai" + "123",
        "encPermanent" + "Key",
        "encOpc" + "Key",
    ]


