    if (out.combined) await showLines(out.combined);
    else printWarn('No log output found');
  }
  await prompt('Press Enter to continue');
}

function sib8Conf(message, serialNumber = 'FF00') {
  const text = message.replace(/[;\r\n]/g, ' ').replace(/\s+/g, ' ').trim();
  return `messageIdentifier=1112;
serialNumber=${serialNumber};
dataCodingScheme=48;
warningType=0000;
text=${text};
mode=0;
`;
}

function writeSib8TargetsCmd(paths, body) {
  return paths.map(target => [
    `if [ -d ${shellQuote(path.dirname(target))} ]; then`,
    `  cat > ${shellQuote(target)} <<'EOF'`,
    body,
    'EOF',
    `  echo ${shellQuote(target)}`,
    'fi',
  ].join('\n')).join('\n');
}

async function updateAllTuiSib8Configs(body) {
  const minipc = await discoverMinipcTarget();
  const targets = [
    {
      label: 'firecell monolithic',
      host: MONO_HOST,
      paths: [
        MONO_SIB8,
        `${MONO_OAI}/cmake_targets/sib8.conf`,
        `${MONO_OAI}/targets/sib8.conf`,
        `${MONO_OAI}/targets/PROJECTS/GENERIC-NR-5GC/CONF/sib8.conf`,
      ],
    },
    {
      label: 'firecell split/caged CU',
      host: FIRECELL,
      paths: [
        CU_SIB8,
        `${CU_OAI}/cmake_targets/sib8.conf`,
        `${CU_OAI}/targets/sib8.conf`,
        `${CU_OAI}/targets/PROJECTS/GENERIC-NR-5GC/CONF/sib8.conf`,
        '/home/serber/cu-du-minipc-backhaul/sib8.conf',
        '/home/serber/cu-du-minipc/source/openairinterface5g/sib8.conf',
        '/home/serber/cu-du-minipc/source/openairinterface5g/cmake_targets/sib8.conf',
        '/home/serber/cu-du-minipc/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/sib8.conf',
        '/home/serber/cu-du-minipc/sib8.conf',
        '/home/serber/cu-du/source/openairinterface5g/sib8.conf',
        '/home/serber/cu-du/source/openairinterface5g/cmake_targets/sib8.conf',
        '/home/serber/cu-du/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/sib8.conf',
        '/home/serber/cu-du/sib8.conf',
        '/home/serber/cu-du/conf/sib8.conf',
      ],
    },
    {
      label: 'live minipc split/caged DU',
      host: minipc.host,
      paths: [
        DU_SIB8,
        `${DU_OAI}/cmake_targets/sib8.conf`,
        `${DU_OAI}/targets/sib8.conf`,
        `${DU_OAI}/targets/PROJECTS/GENERIC-NR-5GC/CONF/sib8.conf`,
        '/home/serber/cu-du/sib8.conf',
        '/home/serber/cu-du/conf/sib8.conf',
        '/home/serber/cu-du-backhaul/source/openairinterface5g/sib8.conf',
        '/home/serber/cu-du-backhaul/source/openairinterface5g/cmake_targets/sib8.conf',
        '/home/serber/cu-du-backhaul/source/openairinterface5g/targets/PROJECTS/GENERIC-NR-5GC/CONF/sib8.conf',
        '/home/serber/cu-du-backhaul/sib8.conf',
        '/home/serber/cu-du-backhaul/conf/sib8.conf',
      ],
    },
  ];

  const results = [];
  for (const target of targets) {
    const out = await sshChecked(target.host, writeSib8TargetsCmd(target.paths, body), 15000);
    results.push({ ...target, written: stripAnsi(out).split('\n').filter(Boolean) });
  }
  return { minipc, results };
}

async function applyPws() {
  console.clear();
  printHeader('PWS / SIB8 Message Manager');
  const dir = runDir('pws_sib8_message_update');
  printInfo(`Evidence directory: ${dir}`);
  const current = await sshLoose(FIRECELL, `cat ${CU_SIB8} 2>/dev/null || cat ${MONO_SIB8} 2>/dev/null || true`, 10000);
  console.log(`\n  ${BOLD}Current representative config${RESET}`);
  await showLines(current.combined || '(empty)');

  let serialNumber = 'FF00';
  const match = current.combined ? current.combined.match(/serialNumber\s*=\s*([0-9A-Fa-f]{4})/) : null;
  if (match) {
    const currentVal = parseInt(match[1], 16);
    let nextVal;
    if (currentVal >= 0xFF00 && currentVal <= 0xFFFF) {
      nextVal = 0xFF00 + ((currentVal - 0xFF00 + 1) % 256);
    } else {
      nextVal = 0xFF00 + ((currentVal + 1) % 256);
    }
    serialNumber = nextVal.toString(16).toUpperCase().padStart(4, '0');
  } else {
    serialNumber = 'FF01';
  }

  const message = await prompt('\n  New warning message', 'KAUST 5G lab test warning');
  if (!message.trim()) {
    printError('Message cannot be empty');
    await prompt('Press Enter to continue');
    return;
  }
  const body = sib8Conf(message.trim(), serialNumber);
  const { minipc, results } = await updateAllTuiSib8Configs(body);
  const evidence = [
    `message=${message.trim()}`,
    `serialNumber=${serialNumber}`,
    `minipc=${minipc.host} ${minipc.mgmtIface || ''} ${minipc.mgmtIp || ''}`,
    '',
    ...results.flatMap(result => [
      `## ${result.label} (${result.host})`,
      ...(result.written.length ? result.written.map(file => `- ${file}`) : ['- <no writable paths>']),
      '',
    ]),
  ].join('\n');
  appendEvidence(dir, 'system-status/sib8-targets-updated.txt', evidence);
  for (const result of results) {
    printSuccess(`${result.label}: ${result.written.length} SIB8 config(s) updated`);
    result.written.slice(0, 6).forEach(file => console.log(`    ${GRAY}${file}${RESET}`));
  }
  printWarn('Restart required for the new warning message to broadcast.');
  const restart = await choose('Restart a scenario now?', [
    { name: 'No restart', value: 'none' },
    { name: 'Ethernet CU/DU rollback baseline', value: 'split' },
    { name: 'Monolithic reference', value: 'mono' },
    { name: 'Caged Quectel F1 Backhaul', value: 'caged' },
  ]);
  if (restart === 'mono') await startMonolithic();
  if (restart === 'split') await startEthernetRollback();
  if (restart === 'caged') await launchSingleCuQuectelBackhaul();
}

