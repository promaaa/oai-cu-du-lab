function runtimeSuffixForBackhaul(profileKey) {
  if (profileKey === 'wifiGre') return 'wifi-gre';
  if (profileKey === 'quectelWg') return 'quectel-wg';
  return 'ethernet';
}

function cuRuntimeConfForDu(runtimeStem, profileKey) {
  if (runtimeStem === 'minipc' && profileKey === 'ethernet') return '/tmp/oai-tui-gnb-cu-ethernet-runtime.conf';
  return `/tmp/oai-tui-gnb-cu-${runtimeStem}-${runtimeSuffixForBackhaul(profileKey)}-runtime.conf`;
}

function selectedDuEnvPrefix(duLabel = activeLabConfig?.duLabel || process.env.DU_LABEL || 'serber-minipc') {
  return duLabel.replace(/^serber-/, '').toUpperCase();
}

function duPathOverride(kind, duLabel = activeLabConfig?.duLabel || process.env.DU_LABEL || 'serber-minipc') {
  const specific = process.env[`${selectedDuEnvPrefix(duLabel)}_${kind}`];
  if (specific) return specific;
  if (!process.env.DU_LABEL || process.env.DU_LABEL === duLabel) return process.env[kind] || '';
  return '';
}

function buildLabConfigForDu(duKey, profileKey = 'ethernet', overrides = {}) {
  const du = KNOWN_DU_CONFIGS[duKey];
  if (!du) throw new Error(`Unknown DU config: ${duKey}`);
  const runtimeSuffix = runtimeSuffixForBackhaul(profileKey);
  return {
    label: `${du.duLabel} + serber-firecell`,
    firecellHost: DEFAULT_FIRECELL_HOST,
    duHost: du.duHost,
    duLabel: du.duLabel,
    duConfName: du.duConfName,
    duRuntimeConf: `/tmp/oai-tui-gnb-${du.runtimeStem}-${runtimeSuffix}-runtime.conf`,
    cuRuntimeConf: cuRuntimeConfForDu(du.runtimeStem, profileKey),
    backhaulProfile: profileKey,
    jumboFrames: profileKey === 'ethernet',
    clampMss: true,
    ...overrides,
  };
}

function setActiveBackhaulProfile(profileKey) {
  const duKey = activeLabConfig.duLabel.replace('serber-', '');
  if (KNOWN_DU_CONFIGS[duKey]) {
    applyLabConfig(buildLabConfigForDu(duKey, profileKey, {
      firecellHost: activeLabConfig.firecellHost,
      duHost: activeLabConfig.duHost,
      label: activeLabConfig.label,
    }));
    return;
  }
  activeLabConfig.backhaulProfile = profileKey;
  activeLabConfig.jumboFrames = profileKey === 'ethernet';
}

