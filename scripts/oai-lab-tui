async function stopAllConfigs(minipcHost = null) {
  console.clear();
  printHeader('Stop Running Configuration');
  printInfo('This action stops every possible running configuration (monolithic, Ethernet split, Quectel split).');

  let target = MINIPC;
  let minipc = null;
  try {
    minipc = await discoverMinipcTarget();
    target = minipc.host;
    printSuccess(`Discovered minipc: ${target}`);
  } catch (err) {
    printWarn('Minipc target not auto-discovered; using default host address for stop commands.');
  }

  const fullStop = await confirm('Stop split 5GC core on firecell as well?', false);
  const totalSteps = fullStop ? 7 : 6;

  // Step 1: Stop monolithic nr-softmodem and containers
  printStep(1, totalSteps, 'Stopping monolithic stack');
  await sshLoose(MONO_HOST, stopSoftmodemByConfigCmd(MONO_CONF), 15000);
  await sshLoose(MONO_HOST, `cd ${MONO_CN} && docker compose down 2>/dev/null || docker-compose down 2>/dev/null || true`, 60000);
  printSuccess('Monolithic stack stopped');

  // Step 2: Stop split softmodems (Ethernet, Quectel)
  printStep(2, totalSteps, 'Stopping all CU/DU/donor DU softmodem processes');
  await hardStopSplit(target);
  printSuccess('All softmodem processes stopped');

  // Step 3: Remove temporary oai-pc F1 block rule if present
  printStep(3, totalSteps, 'Removing F1 blocking rules');
  await unblockOaiPcF1();
  printSuccess('F1 blocking rules removed');

  // Step 4: Query Quectel IP
  let settingsIp = '';
  try {
    const quectel = await discoverQuectel(target, 'oai');
    if (quectel?.settings?.ip) {
      settingsIp = quectel.settings.ip;
    }
  } catch (err) {
    // Ignore discovery errors during stop
  }

  // Step 5: Stop WireGuard and clean Quectel routes/rules
  printStep(4, totalSteps, 'Stopping WireGuard and cleaning Quectel routes');
  await sshLoose(target, `sudo -n systemctl stop wg-quick@${WG_IF} || true`, 15000);
  await sshLoose(FIRECELL, `sudo -n systemctl stop wg-quick@${WG_IF} || true`, 15000);

  const cleanRoutesCmd = [
    'for dev in wwan0 usb0 rmnet_data0; do',
    `  sudo -n ip route del ${FIRECELL_WG_ENDPOINT_IP}/32 dev "$dev" 2>/dev/null || true`,
    'done',
    `sudo -n ip rule del from ${WG_DU_IP} lookup 250 priority 250 2>/dev/null || true`,
    `sudo -n ip rule del from all to ${WG_DU_IP} lookup 9999 2>/dev/null || true`,
    `sudo -n ip rule del from ${WG_DU_IP} lookup 9999 2>/dev/null || true`,
  ].join('\n');
  await sshLoose(target, cleanRoutesCmd, 15000);

  if (settingsIp) {
    await sshLoose(FIRECELL, `sudo -n ip route del ${settingsIp}/32 via ${OAI_UPF_IP} dev ${OAI_CN5G_BRIDGE_IF} 2>/dev/null || true`, 15000);
  }
  printSuccess('WireGuard stopped and Quectel routes cleaned');

  // Clean up UPF TCP MSS Clamping rules if container is running
  try {
    const upfContainer = 'oai-cn5g-minipc-oai-upf-1';
    const isRunning = await sshLoose(FIRECELL, `sudo -n docker ps -q --filter name=${upfContainer}`, 10000);
    if (isRunning.combined.trim()) {
      printInfo('Cleaning up TCP MSS clamping rules inside UPF container...');
      const cleanCmd = [
        `sudo -n docker exec ${upfContainer} sh -lc 'for mss in 1000 1200 1360; do while iptables -t mangle -D FORWARD -o tun0 -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss "$mss" 2>/dev/null; do :; done; while iptables -t mangle -D FORWARD -i tun0 -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss "$mss" 2>/dev/null; do :; done; done'`,
      ].join('\n');
      await sshLoose(FIRECELL, cleanCmd, 15000);
    }
  } catch (err) {
    // Ignore cleanup errors
  }

  // Revert jumbo frames — restore MTU 1500 on both F1 interfaces
  try {
    let minipcIfaceForRevert = null;
    let minipcHostForRevert = null;
    if (minipcHost) {
      const routeInfo = await sshLoose(minipcHost, `ip route get ${FIRECELL.split('@').pop()} 2>/dev/null || true`, 8000);
      minipcIfaceForRevert = parseRouteDevSrc(routeInfo.combined || '').dev || 'enp4s0';
      minipcHostForRevert = minipcHost;
    }
    const firecellRouteForRevert = await sshLoose(FIRECELL, `ip route get ${minipcHost ? (await sshLoose(minipcHost, 'hostname -I | awk \'{ print $1 }\'', 5000)).combined.trim() : '10.76.170.83'} 2>/dev/null || true`, 8000);
    const firecellIfaceForRevert = parseRouteDevSrc(firecellRouteForRevert.combined || '').dev || 'enp6s0';
    await revertJumboFrames(minipcHostForRevert, minipcIfaceForRevert, FIRECELL, firecellIfaceForRevert);
  } catch (err) {
    printWarn(`Jumbo frame revert warning (non-fatal): ${err.message}`);
  }

  let currentStep = 5;
  if (fullStop) {
    printStep(currentStep, totalSteps, 'Stopping split 5GC core on serber-firecell');
    const stopCoreCmd = `cd ${CU_CN_DIR} && (docker compose -f ${CU_CN_COMPOSE} down || docker-compose -f ${CU_CN_COMPOSE} down || true)`;
    const stopCoreOut = await sshLoose(FIRECELL, stopCoreCmd, 60000);
    if (stopCoreOut.combined) await showLines(stopCoreOut.combined);
    printSuccess('Split 5GC core stopped');
    currentStep++;
  }

  // Step 7: Confirm management access
  printStep(currentStep, totalSteps, 'Confirming management access');
  await checkSsh(FIRECELL, 'serber-firecell');
  await checkSsh(target, activeLabConfig.duLabel);
  await prompt('Press Enter to continue');
}

async function launchSingleCuQuectelBackhaul() {
  console.clear();
  printHeader('Launch Caged Quectel F1 Backhaul, Monolithic Donor');
  if (activeLabConfig.duLabel !== 'serber-minipc' && activeLabConfig.duLabel !== 'serber-pi' && activeLabConfig.duLabel !== 'serber-jetson') {
    printError('Caged Quectel F1 backhaul is validated for serber-minipc, serber-pi, and serber-jetson with the Quectel modem.');
    printWarn('Use the configuration screen to select serber-minipc, serber-pi, or serber-jetson + serber-firecell before launching this workflow.');
    await prompt('Press Enter to continue');
    return false;
  }
  const dir = runDir('caged_quectel_f1_backhaul_start');
  printInfo(`Evidence directory: ${dir}`);
  printInfo('This scenario uses one 5GC and one CU on firecell, a monolithic firecell donor gNB for the Quectel modem, and a caged minipc access DU over WireGuard. Machine-side packet gates are necessary but not a full scenario PASS.');

  const gate = {};
  let minipc = null;
  let quectel = null;
  let completed = false;
  const apn = process.env.QUECTEL_APN || await prompt('Quectel APN for firecell monolithic donor gNB', 'oai');
  const configuredQuectelImsi = process.env.QUECTEL_IMSI || '';
  let quectelImsi = configuredQuectelImsi;

  try {
    printStep(1, 14, 'Hardware preflight and live minipc discovery');
    minipc = await discoverMinipcTarget();
    printSuccess(`${activeLabConfig.duLabel} via ${minipc.host}${minipc.mgmtIface ? ` (${minipc.mgmtIface} ${minipc.mgmtIp})` : ''}`);
    appendEvidence(dir, 'system-status/minipc-discovery.txt', minipc.raw);
    await checkSsh(FIRECELL, 'serber-firecell');
    const governors = await Promise.all([
      enforcePerformanceGovernors(FIRECELL, 'serber-firecell'),
      enforcePerformanceGovernors(minipc.host, 'serber-minipc'),
    ]);
    appendEvidence(dir, 'system-status/cpu-governors.txt', governors.join('\n\n'));
    const hw = await sshChecked(minipc.host, [
      'hostname',
      'ip -br link',
      'ip -4 -br addr',
      'ls -l /dev/cdc-wdm* /dev/ttyUSB* 2>/dev/null || true',
      'if command -v tcpdump >/dev/null; then echo "tcpdump=ready"; else echo "tcpdump=missing"; fi',
      `if pgrep -x nr-softmodem >/dev/null; then echo "USRP check skipped: nr-softmodem owns the radio"; else uhd_find_devices --args serial=${ACCESS_B210_SERIAL} 2>&1 || sudo -n uhd_find_devices --args serial=${ACCESS_B210_SERIAL} 2>&1 || true; fi`,
      'pgrep -a nr-softmodem || true',
    ].join('\n'), 30000);
    await showLines(hw);
    appendEvidence(dir, 'system-status/hardware-preflight.txt', hw);
    if (!/\/dev\/cdc-wdm|\/dev\/ttyUSB/i.test(hw)) throw new Error('Quectel control devices were not visible on minipc');
    if (!/B210|USRP check skipped/i.test(hw)) throw new Error(`B210 serial ${ACCESS_B210_SERIAL} was not visible and no running softmodem explained radio ownership`);
    if (!/tcpdump=ready/.test(hw)) throw new Error(`${activeLabConfig.duLabel} is missing tcpdump, which is required for the F1/WireGuard packet evidence gate`);
    await tuneSelectedDuForB210HighRate(minipc, dir);
    const imsiEvidence = [
      `configured_imsi_present=${/^[0-9]{14,16}$/.test(configuredQuectelImsi || '')}`,
    ];
    try {
      const modemImsi = await readQuectelModemImsi(minipc.host);
      const modemValid = /^[0-9]{14,16}$/.test(modemImsi.imsi || '');
      const configuredMatches = modemValid && configuredQuectelImsi === modemImsi.imsi;
      imsiEvidence.push(`modem_imsi_detected=${modemValid}`);
      imsiEvidence.push(`modem_at_port=${modemImsi.atPort || 'unknown'}`);
      imsiEvidence.push(`modem_imsi_attempts=${modemImsi.attempts || 1}`);
      imsiEvidence.push(`configured_matches_modem=${configuredMatches}`);
      if (modemValid) {
        quectelImsi = modemImsi.imsi;
        imsiEvidence.push('effective_imsi_source=live_modem');
      } else {
        imsiEvidence.push('effective_imsi_source=configured');
      }
    } catch (err) {
      imsiEvidence.push('modem_imsi_detected=false');
      if (/^[0-9]{14,16}$/.test(configuredQuectelImsi || '')) {
        imsiEvidence.push('effective_imsi_source=configured_fallback');
      } else {
        imsiEvidence.push('effective_imsi_source=none');
        appendEvidence(dir, 'system-status/quectel-imsi-check.txt', imsiEvidence.join('\n'));
        throw new Error(`Could not read live Quectel IMSI and no valid QUECTEL_IMSI fallback is configured (${err.message})`);
      }
    }
    appendEvidence(dir, 'system-status/quectel-imsi-check.txt', imsiEvidence.join('\n'));
    gate.hardware = true;

    printStep(2, 14, 'Stop stale softmodems and start firecell 5GC');
    await hardStopSplit(minipc.host);
    const coreStart = await sshChecked(FIRECELL, restartSplitCoreCmd(), 120000);
    appendEvidence(dir, 'logs/core-compose-start.log', coreStart);
    const core = await waitForSplitCoreReady();
    await showLines(core);
    appendEvidence(dir, 'logs/core-start.log', core);
    if (!/192\.168\.71\.129/i.test(core) || !/192\.168\.71\.140/i.test(core) || !/healthy|Up/i.test(core)) {
      throw new Error('Firecell 5GC did not show expected bridge/container evidence');
    }
    gate.core = true;

    printStep(3, 14, 'Provision Quectel subscriber in active split core');
    const seed = await provisionQuectelSubscriber(quectelImsi);
    await showLines(seed);
    appendEvidence(dir, 'system-status/quectel-subscriber-seed.log', seed);
    const phoneSeed = await provisionLabPhoneSubscriber(dir);
    await showLines(phoneSeed);
    await applyUpfMssClamping();
    await ensureUpfRoutingAndNat(minipc);
    gate.subscriber = true;

    printStep(4, 14, 'Generate WireGuard CU and access-DU configs');
    const configs = await prepareCagedSplitConfigs(minipc.host);
    await showLines(configs.firecell);
    await showLines(configs.minipc);
    appendEvidence(dir, 'system-status/generated-caged-configs.txt', `${configs.firecell}\n\n${configs.minipc}`);
    if (!configs.firecell.includes(WG_CU_IP) || !configs.minipc.includes(ACCESS_DU_ID) || !configs.minipc.includes(WG_DU_IP)) {
      throw new Error('Generated config evidence did not show WireGuard CU/access DU identity and F1 addresses');
    }
    gate.configs = true;

    printStep(5, 14, 'Start firecell monolithic donor gNB');
    const donorConfig = await prepareMonolithicDonorRuntimeConfig(dir);
    await showLines(donorConfig);
    const donorStart = await sshChecked(FIRECELL, [
      stopSoftmodemByConfigCmd(FIRECELL_DONOR_GNB_RUNTIME_CONF),
      stopSoftmodemByConfigCmd(FIRECELL_DONOR_PROD_CONF),
      startSoftmodemCmd(`${MONO_OAI}/cmake_targets/ran_build/build`, FIRECELL_DONOR_GNB_RUNTIME_CONF, FIRECELL_DONOR_GNB_LOG, '-E --continuous-tx --log_config.global_log_level info'),
      'sleep 8',
      'pgrep -a nr-softmodem || true',
      `grep -Ei "NGSetup|in service|Cell ID|UHD|B200|B210|got sync|PRACH|RNTI|error|fail|assert" ${FIRECELL_DONOR_GNB_LOG} 2>/dev/null | tail -120 || true`,
    ].join('\n'), 45000);
    await showLines(donorStart);
    appendEvidence(dir, 'logs/firecell-monolithic-donor-gnb-start.log', donorStart);
    await validateMonolithicDonorInService(dir);
    gate.donorGnb = true;

    printStep(6, 14, 'Quectel donor registration reset through firecell monolithic donor gNB');
    let registration = '';
    try {
      registration = await resetQuectelRegistration(minipc.host);
    } catch (err) {
      if (err.evidence) {
        await showLines(err.evidence);
        appendEvidence(dir, 'system-status/quectel-registration.log', err.evidence);
        appendEvidence(dir, 'measurements/failing-hop.txt', [
          'Failing hop: Quectel donor registration before PDU setup.',
          'Expected: modem camps on firecell monolithic donor gNB PCI=1/TAC=2 and reports NR5G packet attach.',
          'Observed: see system-status/quectel-registration.log.',
        ].join('\n'));
      }
      throw err;
    }
    await showLines(registration);
    appendEvidence(dir, 'system-status/quectel-registration.log', registration);
    gate.registration = true;

    printStep(7, 14, 'Quectel QMI/PDU session on minipc');
    quectel = await discoverQuectel(minipc.host, apn);
    await showLines(quectel.raw);
    appendEvidence(dir, 'system-status/quectel-qmi.txt', quectel.raw);
    if (!quectel.iface || !quectel.settings.ip || !quectel.settings.gateway || !quectel.settings.stableConnected) {
      throw new Error('Quectel PDU did not reach a stable connected state with live QMI IP/gateway settings');
    }
    printSuccess(`Quectel PDU: ${quectel.iface} ${quectel.settings.ip}/${quectel.settings.prefix} via ${quectel.settings.gateway}`);
    gate.quectel = true;

    printStep(8, 14, 'Routes over live Quectel PDU');
    const routes = await ensurePduRoutes(minipc.host, quectel);
    await showLines(routes.minipcOut);
    await showLines(routes.firecellOut);
    appendEvidence(dir, 'system-status/quectel-routes.txt', `${routes.minipcOut}\n\n${routes.firecellOut}`);
    if (!routes.minipcOut.includes(quectel.iface) || !routes.firecellOut.includes(quectel.settings.ip)) throw new Error('Route evidence did not match the live Quectel path');
    gate.routes = true;

    printStep(9, 14, 'WireGuard tunnel');
    const wg = await ensureWireGuard(minipc.host, quectel);
    await showLines(wg.minipc);
    await showLines(wg.firecell);
    appendEvidence(dir, 'system-status/wireguard.txt', `${wg.minipc}\n\n${wg.firecell}`);
    gate.wireguard = true;

    printStep(10, 14, 'Validate independent donor path via AT commands and ping');
    const donorVal = await execLocal(`CU_HOST=${shellQuote(FIRECELL)} DU_HOST=${shellQuote(minipc.host)} bash ${shellQuote(path.join(QUECTEL_SCRIPT_DIR, '02_validate_independent_donor.sh'))}`, 40000);
    await showLines(donorVal.combined);
    if (!donorVal.ok) throw new Error(`Independent donor validation failed: ${donorVal.combined}`);
    gate.donorVal = true;

    printStep(11, 14, 'Start firecell CU bound to wg-quectel-f1');
    const cuStart = await sshChecked(FIRECELL, [
      `test -f ${CU_QUECTEL_CONF}`,
      stopSoftmodemByConfigCmd(CU_QUECTEL_CONF),
      startSoftmodemCmd(`${CU_OAI}/cmake_targets/ran_build/build`, CU_QUECTEL_CONF, CU_QUECTEL_LOG, '--log_config.global_log_level info'),
      'sleep 8',
      'pgrep -a nr-softmodem || true',
      `tail -n 180 ${CU_QUECTEL_LOG} 2>/dev/null | grep -Ei "NGSetup|F1|SCTP|GTP|2153|38472|10.250.0.1|error|fail" || true`,
    ].join('\n'), 45000);
    await showLines(cuStart);
    appendEvidence(dir, 'logs/cu-quectel.log', cuStart);
    const cuHasSctp = /F1AP_CU_SCTP_REQ|SCTP|10\.250\.0\.1/i.test(cuStart);
    const cuHasGtpu = /Initializing UDP|GTP|2153|10\.250\.0\.1/i.test(cuStart);
    if (!cuHasSctp || !cuHasGtpu) throw new Error('CU log did not show both F1 SCTP and GTP-U binding evidence on the WireGuard CU side');
    gate.cu = true;

    printStep(12, 14, `Start ${activeLabConfig.duLabel} access DU over wg-quectel-f1`);
    const duExtraArgs = [
      selectedDuStartExtraArgs(),
      activeLabConfig.duLabel === 'serber-jetson' ? '' : '--continuous-tx',
    ].filter(Boolean).join(' ');
    const duStart = await sshChecked(minipc.host, [
      `test -f ${DU_QUECTEL_CONF}`,
      stopSoftmodemByConfigCmd(DU_QUECTEL_CONF),
      `: > ${DU_QUECTEL_LOG}`,
      startSoftmodemCmd(
        `${DU_OAI}/cmake_targets/ran_build/build`,
        DU_QUECTEL_CONF,
        DU_QUECTEL_LOG,
        duExtraArgs,
        selectedDuLauncher()
      ),
      'pgrep -a nr-softmodem || true',
    ].join('\n'), 60000);
    const duMilestones = await waitForRemoteLogMilestones(
      minipc.host,
      DU_QUECTEL_LOG,
      'F1|SCTP|GTP|UHD|B200|B210|in service|PRACH|RNTI|error|fail|assert|Setup|sync|PWS|SIB8',
      [/F1 Setup Response|DU_handle_F1_SETUP_RESPONSE|received F1 Setup Response/i, /got sync|B210|Detected Device/i],
      60000,
      3000
    );
    const duEvidence = `${duStart}\n${duMilestones}`.trim();
    await showLines(duEvidence);
    appendEvidence(dir, 'logs/du-quectel.log', duEvidence);
    const duHasF1Setup = /F1 Setup Response|DU_handle_F1_SETUP_RESPONSE|received F1 Setup Response/i.test(duEvidence);
    const duHasRadio = /got sync|B210|Detected Device/i.test(duEvidence);
    if (!duHasF1Setup || !duHasRadio) throw new Error('DU log did not show both F1 setup response and radio sync evidence after waiting for startup milestones');
    gate.du = true;

    printStep(13, 14, 'Packet validation: access F1 on tunnel, WireGuard on Quectel, no management F1');
    const sourceIdentity = await validateCagedAccessSourceIdentity(dir, minipc.host);
    await showLines(sourceIdentity);
    await validateCagedPacketPlacement(dir, minipc.host, quectel);
    gate.packet = true;

    printStep(14, 14, 'UE/F1-U validation during phone traffic and rollback readiness');
    await validateCagedF1u(dir, minipc.host, 3);
    gate.ueF1u = true;

    await checkSsh(FIRECELL, 'serber-firecell management');
    await checkSsh(minipc.host, 'serber-minipc management');
    appendEvidence(dir, 'measurements/gates.json', JSON.stringify(gate, null, 2));
    printSuccess('Caged Quectel machine-side packet gate passed: donor service, F1-C/F1-U placement, WireGuard outer UDP, and management-path isolation were observed');
    printWarn('PARTIAL: no full scenario PASS is claimed until phone-visible PWS, registration, PDU session, internet, and throughput are recorded separately.');
    completed = true;
  } catch (err) {
    if (err.evidence) appendEvidence(dir, err.evidenceFile || 'measurements/failing-hop.txt', err.evidence);
    appendEvidence(dir, 'measurements/gates.json', JSON.stringify(gate, null, 2));
    printError(err.message);
    printWarn('No PASS claimed. Use the rollback action if the lab should return to Ethernet/WiFi baseline state.');
  }

  await prompt('Press Enter to continue');
  return completed;
}

async function validateSingleCuQuectelBackhaul() {
  console.clear();
  printHeader('Validate Caged Quectel F1 Backhaul, Monolithic Donor');
  if (activeLabConfig.duLabel !== 'serber-minipc' && activeLabConfig.duLabel !== 'serber-pi' && activeLabConfig.duLabel !== 'serber-jetson') {
    printError('Caged Quectel F1 backhaul validation is available for serber-minipc, serber-pi, and serber-jetson with the Quectel modem.');
    printWarn('Use the configuration screen to select serber-minipc, serber-pi, or serber-jetson + serber-firecell before validating this workflow.');
    await prompt('Press Enter to continue');
    return false;
  }
  const dir = runDir('caged_quectel_f1_backhaul_validate');
  printInfo(`Evidence directory: ${dir}`);
  const gate = {};
  let minipc = null;
  let quectel = null;
  let completed = false;
  const apn = process.env.QUECTEL_APN || await prompt('Quectel APN for live PDU refresh', 'oai');

  try {
    printStep(1, 7, 'Discover live minipc and Quectel PDU');
    minipc = await discoverMinipcTarget();
    printSuccess(`serber-minipc via ${minipc.host}${minipc.mgmtIface ? ` (${minipc.mgmtIface} ${minipc.mgmtIp})` : ''}`);
    appendEvidence(dir, 'system-status/minipc-discovery.txt', minipc.raw);
    const governors = await Promise.all([
      enforcePerformanceGovernors(FIRECELL, 'serber-firecell'),
      enforcePerformanceGovernors(minipc.host, 'serber-minipc'),
    ]);
    appendEvidence(dir, 'system-status/cpu-governors.txt', governors.join('\n\n'));
    quectel = await discoverQuectel(minipc.host, apn);
    await showLines(quectel.raw);
    appendEvidence(dir, 'system-status/quectel-qmi.txt', quectel.raw);
    if (!quectel.settings.ip || !quectel.settings.gateway || !quectel.settings.stableConnected) {
      throw new Error('Live Quectel PDU did not stay connected with IPv4 address and gateway');
    }
    printSuccess(`Quectel PDU: ${quectel.iface} ${quectel.settings.ip}/${quectel.settings.prefix} via ${quectel.settings.gateway}`);
    gate.quectel = true;

    printStep(2, 7, 'Refresh routes over live Quectel PDU');
    const routes = await ensurePduRoutes(minipc.host, quectel);
    await showLines(routes.minipcOut);
    await showLines(routes.firecellOut);
    appendEvidence(dir, 'system-status/routes.txt', `${routes.minipcOut}\n\n${routes.firecellOut}`);
    gate.routes = true;

    printStep(3, 7, 'Refresh WireGuard tunnel');
    const wg = await ensureWireGuard(minipc.host, quectel, { restart: false });
    await showLines(wg.minipc);
    await showLines(wg.firecell);
    appendEvidence(dir, 'system-status/wireguard.txt', `${wg.minipc}\n\n${wg.firecell}`);
    gate.wireguard = true;

    printStep(4, 7, 'Validate monolithic donor gNB and independent donor path');
    await validateMonolithicDonorInService(dir);
    const donorVal = await execLocal(`CU_HOST=${shellQuote(FIRECELL)} DU_HOST=${shellQuote(minipc.host)} bash ${shellQuote(path.join(QUECTEL_SCRIPT_DIR, '02_validate_independent_donor.sh'))}`, 40000);
    await showLines(donorVal.combined);
    if (!donorVal.ok) throw new Error(`Independent donor validation failed: ${donorVal.combined}`);
    const phoneSeed = await provisionLabPhoneSubscriber(dir);
    await showLines(phoneSeed);
    gate.donorVal = true;

    printStep(5, 7, 'Confirm running CU and minipc access DU split state');
    const sourceIdentity = await validateCagedAccessSourceIdentity(dir, minipc.host);
    await showLines(sourceIdentity);
    const cu = await sshChecked(FIRECELL, `grep -Ei "F1AP_CU_SCTP_REQ|CU_handle_F1_SETUP_REQUEST|GTPU.*2153|SCTP|error|fail" ${CU_QUECTEL_LOG} 2>/dev/null | tail -80 || true`, 15000);
    const du = await sshChecked(minipc.host, `grep -Ei "DU_handle_F1_SETUP_RESPONSE|received F1 Setup Response|got sync|B210|SCTP|error|fail" ${DU_QUECTEL_LOG} 2>/dev/null | tail -80 || true`, 15000);
    await showLines(cu);
    await showLines(du);
    appendEvidence(dir, 'logs/cu-du-running-validation.log', `${cu}\n\n${du}`);
    if (!/F1AP_CU_SCTP_REQ|CU_handle_F1_SETUP_REQUEST/i.test(cu)) throw new Error('CU log did not show running F1 evidence');
    if (!/DU_handle_F1_SETUP_RESPONSE|received F1 Setup Response/i.test(du)) throw new Error('DU log did not show running F1 setup evidence');
    gate.cuDu = true;

    printStep(6, 7, 'Packet validation: F1 on tunnel, WireGuard on Quectel, no management F1');
    await validateCagedPacketPlacement(dir, minipc.host, quectel);
    gate.packet = true;

    printStep(7, 7, 'UE/F1-U validation during phone traffic');
    await validateCagedF1u(dir, minipc.host, 3);
    gate.ueF1u = true;

    await checkSsh(FIRECELL, 'serber-firecell management');
    await checkSsh(minipc.host, 'serber-minipc management');
    appendEvidence(dir, 'measurements/gates.json', JSON.stringify(gate, null, 2));
    printSuccess('Caged Quectel machine-side packet gate passed: donor service, F1-C/F1-U placement, WireGuard outer UDP, and management-path isolation were observed');
    printWarn('PARTIAL: no full scenario PASS is claimed until phone-visible PWS, registration, PDU session, internet, and throughput are recorded separately.');
    completed = true;
  } catch (err) {
    if (err.evidence) appendEvidence(dir, err.evidenceFile || 'measurements/failing-hop.txt', err.evidence);
    appendEvidence(dir, 'measurements/gates.json', JSON.stringify(gate, null, 2));
    printError(err.message);
    printWarn('No PASS claimed. The split can remain running while the phone attach/APN/user-plane issue is corrected and this validation is retried.');
  }

  await prompt('Press Enter to continue');
  return completed;
}

async function quectelShowcase() {
  console.clear();
  printHeader('Quectel F1 Backhaul Showcase');
  printInfo('Running read-only modem/backhaul checks from the local scripts where available.');
  const scripts = [
    'scripts/quectel-f1-backhaul/00_detect_quectel.sh',
    'scripts/quectel-f1-backhaul/01_check_quectel_connectivity.sh',
    'scripts/quectel-f1-backhaul/04_validate_backhaul_path.sh',
  ];
  for (const script of scripts) {
    console.log(`\n  ${BOLD}${script}${RESET}`);
    const out = await execLocal(`bash ${script}`, 60000);
    if (out.ok) await showLines(out.combined);
    else {
      printWarn('Script did not complete cleanly');
      await showLines(out.combined);
    }
  }
  printWarn('Full Quectel F1 is not a stable baseline unless the Quectel modem is attached through the firecell monolithic donor gNB.');
  await prompt('Press Enter to continue');
}

async function suppressQuectelForB210Experiment(minipcHost) {
  const cmd = [
    'set -euo pipefail',
    `sudo -n systemctl stop wg-quick@${WG_IF} 2>/dev/null || true`,
    `sudo -n ip link set ${WG_IF} down 2>/dev/null || true`,
    `sudo -n ip route del ${FIRECELL_WG_ENDPOINT_IP}/32 2>/dev/null || true`,
    `sudo -n ip route del ${WG_CU_IP}/32 2>/dev/null || true`,
    `sudo -n ip route del ${WG_DU_IP}/32 2>/dev/null || true`,
    `sudo -n ip rule del from ${WG_DU_IP} lookup 250 priority 250 2>/dev/null || true`,
    `sudo -n ip rule del from all to ${WG_DU_IP} lookup 9999 2>/dev/null || true`,
    `sudo -n ip rule del from ${WG_DU_IP} lookup 9999 2>/dev/null || true`,
    'for dev in wwan0 usb0 rmnet_data0; do',
    '  if ip link show "$dev" >/dev/null 2>&1; then',
    '    sudo -n ip route flush dev "$dev" 2>/dev/null || true',
    '    sudo -n ip link set "$dev" down 2>/dev/null || true',
    '  fi',
    'done',
    'echo "--- Quectel interfaces after suppression ---"',
    'ip -br addr show wwan0 usb0 rmnet_data0 2>/dev/null || true',
    'echo "--- WireGuard state after suppression ---"',
    `ip -br addr show ${WG_IF} 2>/dev/null || true`,
    `sudo -n wg show ${WG_IF} 2>/dev/null || true`,
    'echo "--- residual routes/rules ---"',
    `ip route show | grep -E '${WG_IF}|wwan0|usb0|rmnet|${FIRECELL_WG_ENDPOINT_IP}|${WG_CU_IP}|${WG_DU_IP}' || true`,
    `ip rule show | grep -E '${WG_DU_IP}|250|9999' || true`,
    'echo "--- Quectel control devices still physically present, not used ---"',
    'ls -l /dev/cdc-wdm* /dev/ttyUSB* 2>/dev/null || true',
  ].join('\n');
  const [minipc, firecell] = await Promise.all([
    sshLoose(minipcHost, cmd, 25000),
    sshLoose(FIRECELL, [
      `sudo -n systemctl stop wg-quick@${WG_IF} 2>/dev/null || true`,
      `sudo -n ip link set ${WG_IF} down 2>/dev/null || true`,
      `sudo -n ip route del ${WG_DU_IP}/32 2>/dev/null || true`,
      `ip -br addr show ${WG_IF} 2>/dev/null || true`,
      `sudo -n wg show ${WG_IF} 2>/dev/null || true`,
      `ip route show | grep -E '${WG_IF}|${WG_DU_IP}' || true`,
    ].join('\n'), 20000),
  ]);
  return sanitizeCapture([
    '=== minipc Quectel/WireGuard suppression ===',
    minipc.combined || '<no minipc output>',
    '=== firecell WireGuard suppression ===',
    firecell.combined || '<no firecell output>',
  ].join('\n'));
}

async function probeB210ExperimentHardware(minipcHost) {
  const cmd = [
    'set -euo pipefail',
    'hostname',
    'date -Is',
    `cd ${DU_OAI} && git rev-parse HEAD 2>/dev/null || true`,
    'pgrep -a nr-softmodem || true',
    'if pgrep -x nr-softmodem >/dev/null; then',
    '  echo "uhd_probe_skipped=nr-softmodem owns the radio"',
    'else',
    `  (uhd_find_devices --args serial=${ACCESS_B210_SERIAL} 2>&1 || sudo -n uhd_find_devices --args serial=${ACCESS_B210_SERIAL} 2>&1 || true)`,
    `  (uhd_usrp_probe --args serial=${ACCESS_B210_SERIAL} 2>&1 || sudo -n uhd_usrp_probe --args serial=${ACCESS_B210_SERIAL} 2>&1 || true) | sed -n '1,260p'`,
    'fi',
    'echo "--- local candidate configs ---"',
    `find ${DU_OAI}/targets/PROJECTS/GENERIC-NR-5GC/CONF -maxdepth 1 -type f \\( -name '*b210*' -o -name '*du*' -o -name '*nrue*' -o -name '*sa*' \\) 2>/dev/null | sort | head -80`,
    'echo "--- access DU config RF/F1 lines ---"',
    `grep -En 'gNB_ID|gNB_DU_ID|tracking_area_code|physCellId|nr_cellid|sdr_addrs|tx_num_channels|rx_num_channels|nb_tx|nb_rx|num_cc|att_tx|att_rx|local_n_address|remote_n_address|local_n_if_name' ${DU_CONF} 2>/dev/null | head -100 || true`,
  ].join('\n');
  const out = await sshLoose(minipcHost, cmd, 45000);
  return sanitizeCapture(out.combined || '');
}

function analyzeB210ExperimentReadiness(probeText) {
  const text = stripAnsi(probeText);
  const detected = /B210|B200|type:\s*b200|serial:\s*8002816/i.test(text) || /uhd_probe_skipped=nr-softmodem owns the radio/i.test(text);
  const twoTx = /TX Frontend 0|TX Channel: 0|Num TX channels:\s*2|2 tx/i.test(text) && /TX Frontend 1|TX Channel: 1|Num TX channels:\s*2|2 tx/i.test(text);
  const twoRx = /RX Frontend 0|RX Channel: 0|Num RX channels:\s*2|2 rx/i.test(text) && /RX Frontend 1|RX Channel: 1|Num RX channels:\s*2|2 rx/i.test(text);
  const oaiCommitPinned = text.includes('102965a669b9444857c27843ec8ce62780bf9d37');
  return {
    b210DetectedOrOwned: detected,
    twoTxChainsVisible: twoTx,
    twoRxChainsVisible: twoRx,
    oaiCommitPinned,
    hardBlocker: 'A USRP B210 provides two TX and two RX RF chains on one UHD device. That is enough for 2x2 MIMO, but it is not evidence that OAI can run an independent RF backhaul cell and an access DU cell at the same time on the same B210.',
  };
}

async function validateB210NoQuectelPacketPlacement(dir, minipcHost, minipcMgmtIface, minipcMgmtIp) {
  const firecellRoute = minipcMgmtIp ? await sshLoose(FIRECELL, `ip route get ${minipcMgmtIp}`, 10000) : { combined: '' };
  const firecellEth = parseRouteDevSrc(firecellRoute.combined || '').dev || 'enp6s0';
  const [minipcWg, firecellWg, minipcQuectel, minipcMgmt, firecellMgmt] = await Promise.all([
    capturePacketGate(minipcHost, WG_IF, 'sctp or udp port 2153', 8, 5),
    capturePacketGate(FIRECELL, WG_IF, 'sctp or udp port 2153', 8, 5),
    capturePacketGate(minipcHost, 'wwan0', `udp port ${WG_PORT} or sctp or udp port 2153`, 8, 5),
    minipcMgmtIface ? capturePacketGate(minipcHost, minipcMgmtIface, `host ${firecellAddress()} and (sctp or udp port 2153)`, 8, 5) : Promise.resolve(''),
    minipcMgmtIp ? capturePacketGate(FIRECELL, firecellEth, `host ${minipcMgmtIp} and (sctp or udp port 2153)`, 8, 5) : Promise.resolve(''),
  ]);
  const evidence = [
    `=== minipc ${WG_IF} no-F1 capture ===`, minipcWg || '<no packets>',
    `=== firecell ${WG_IF} no-F1 capture ===`, firecellWg || '<no packets>',
    '=== minipc wwan0 no-Quectel-backhaul capture ===', minipcQuectel || '<no packets>',
    `=== minipc ${minipcMgmtIface || '<unknown>'} management capture ===`, minipcMgmt || '<no packets>',
    `=== firecell ${firecellEth} management capture ===`, firecellMgmt || '<no packets>',
  ].join('\n');
  appendEvidence(dir, 'measurements/experimental-no-quectel-packet-check.txt', evidence);
  return {
    evidence,
    noWireGuardF1: !hasPacketLines(minipcWg) && !hasPacketLines(firecellWg),
    noQuectelTraffic: !hasPacketLines(minipcQuectel),
  };
}

async function experimentalB210Mode() {
  console.clear();
  printHeader('Experimental Mode: Single B210 RF Backhaul');
  if (activeLabConfig.duLabel !== 'serber-minipc') {
    printWarn('Experimental single-B210 mode is scoped to serber-minipc; switching this action to the default minipc lab config.');
    applyLabConfig(DEFAULT_LAB_CONFIGS.minipc);
  }

  const dir = runDir('experimental_single_b210_rf_backhaul');
  printInfo(`Evidence directory: ${dir}`);
  printWarn('This is not a rollback baseline. It suppresses Quectel/WireGuard and proves only the gates it can measure.');
  const gate = {};
  let minipc = null;

  try {
    printStep(1, 7, 'Discover live minipc and preserve rollback context');
    minipc = await discoverSerberMinipcOnly();
    printSuccess(`serber-minipc via ${minipc.host}${minipc.mgmtIface ? ` (${minipc.mgmtIface} ${minipc.mgmtIp})` : ''}`);
    appendEvidence(dir, 'system-status/minipc-discovery.txt', minipc.raw);
    const rollback = [
      'rollback_target=Ethernet CU/DU with SIB8',
      `cu_host=${FIRECELL}`,
      `du_host=${minipc.host}`,
      `ethernet_du_config=${DU_CONF}`,
      `ethernet_du_runtime=${DU_ETHERNET_RUNTIME_CONF}`,
      `rollback_command=./scripts/oai-lab-tui --rollback-caged-quectel or Stop the current config, then Launch Ethernet CU/DU split`,
    ].join('\n');
    appendEvidence(dir, 'system-status/rollback-context.txt', rollback);
    gate.discovery = true;

    printStep(2, 7, 'Stop stale softmodems and suppress Quectel/WireGuard paths');
    await hardStopSplit(minipc.host);
    const suppression = await suppressQuectelForB210Experiment(minipc.host);
    await showLines(suppression);
    appendEvidence(dir, 'system-status/quectel-suppression.txt', suppression);
    gate.quectelSuppressed = true;

    printStep(3, 7, 'Record OAI commit and B210 RF-channel capability');
    const probe = await probeB210ExperimentHardware(minipc.host);
    await showLines(probe);
    appendEvidence(dir, 'system-status/b210-probe.txt', probe);
    const readiness = analyzeB210ExperimentReadiness(probe);
    appendEvidence(dir, 'system-status/architecture-readiness.json', JSON.stringify(readiness, null, 2));
    if (!readiness.b210DetectedOrOwned) throw new Error(`B210 serial ${ACCESS_B210_SERIAL} was not detected and no running softmodem explained ownership`);
    gate.b210 = true;
    if (!readiness.oaiCommitPinned) {
      printWarn('Could not confirm the DU OAI tree is at the pinned rollback commit from this probe.');
    }

    printStep(4, 7, 'Write temporary experimental runtime marker only');
    const marker = [
      '# Experimental single-B210 RF-backhaul/access marker',
      '# Generated under /tmp by the TUI; not a production OAI config.',
      '# Goal: prove whether one B210 can replace Quectel for backhaul while also serving the phone.',
      `# Source rollback DU config: ${DU_CONF}`,
      `# B210 serial: ${ACCESS_B210_SERIAL}`,
      '# Status: launch blocked until an OAI-supported dual-role RF config is proven.',
      '',
    ].join('\n');
    const markerOut = await sshChecked(minipc.host, `cat > ${EXPERIMENTAL_B210_RUNTIME_CONF} <<'EOF'\n${marker}EOF\nls -l ${EXPERIMENTAL_B210_RUNTIME_CONF}\ncat ${EXPERIMENTAL_B210_RUNTIME_CONF}`, 10000);
    appendEvidence(dir, 'system-status/experimental-runtime-marker.txt', markerOut);
    gate.runtimeMarker = true;

    printStep(5, 7, 'Packet gate: confirm no Quectel/WireGuard F1 path is active');
    const packet = await validateB210NoQuectelPacketPlacement(dir, minipc.host, minipc.mgmtIface, minipc.mgmtIp);
    await showLines(packet.evidence);
    if (!packet.noWireGuardF1 || !packet.noQuectelTraffic) {
      throw new Error('Quectel suppression gate failed: WireGuard or wwan0 still showed F1/backhaul packets');
    }
    gate.packetNoQuectel = true;

    printStep(6, 7, 'Architecture gate for requested RF backhaul plus access split');
    const architectureNote = [
      'requested_topology=single B210 on serber-minipc, Quectel suppressed, one RF pair for backhaul and one RF pair for Nothing Phone access',
      'observed_hardware=B210 is one UHD device with two TX/RX chains, suitable for 2x2 MIMO evidence but not by itself proof of two independent simultaneous OAI roles',
      'gate_result=blocked_pending_OAI_dual_role_config',
      `hard_blocker=${readiness.hardBlocker}`,
      'next_action=create a feature-separated OAI patch/config experiment that can instantiate and validate the backhaul endpoint and access DU without sharing incompatible UHD ownership',
    ].join('\n');
    appendEvidence(dir, 'measurements/architecture-gate.txt', architectureNote);
    await showLines(architectureNote);
    gate.architectureProven = false;

    printStep(7, 7, 'Leave lab in safe stopped state');
    await hardStopSplit(minipc.host);
    await checkSsh(FIRECELL, 'serber-firecell management');
    await checkSsh(minipc.host, 'serber-minipc management');
    appendEvidence(dir, 'measurements/gates.json', JSON.stringify(gate, null, 2));
    printWarn('No PASS claimed. Experimental mode is installed, Quectel was suppressed for the probe, and the requested single-B210 dual-role launch remains blocked until the OAI RF architecture is proven.');
  } catch (err) {
    appendEvidence(dir, 'measurements/gates.json', JSON.stringify(gate, null, 2));
    printError(err.message);
    printWarn('No PASS claimed. Use Stop the current config or Ethernet CU/DU rollback before continuing demos.');
  }

  await prompt('Press Enter to continue');
}

async function getRunningConfig() {
  try {
    const proc = await sshLoose(FIRECELL, 'pgrep -a nr-softmodem || true', 3000);
    if (!proc.ok) return 'unknown (unreachable)';
    const out = proc.combined || '';
    if (out.includes('gnb-cu-minipc-quectel-backhaul.conf') || out.includes('oai-tui-firecell-donor-monolithic-runtime.conf') || out.includes('gnb-firecell-donor-single-core-51prb.conf')) {
      return 'caged Quectel F1 backhaul, monolithic donor';
    }
    if (out.includes(CU_RUNTIME_CONF) || out.includes('gnb-cu-minipc.conf')) {
      return `${selectedBackhaulProfile().label} CU/DU config`;
    }
    if (out.includes(EXPERIMENTAL_B210_RUNTIME_CONF)) {
      return 'experimental single-B210 RF backhaul';
    }
    if (out.includes('gnb.sa.band78.fr1.106PRB.usrpb210.conf')) {
      return 'monolithic firecell core + gNB';
    }
    if (out.trim().length > 0) {
      return 'running (unknown config)';
    }
    return 'none';
  } catch (err) {
    return 'unknown (unreachable)';
  }
}

async function configureLabBeforeMenu({ allowKeepCurrent = true } = {}) {
  console.clear();
  printHeader('Lab Configuration');
  console.log('\n  Current config:');
  console.log(`    ${formatLabConfig()}`);
  const running = await getRunningConfig();
  console.log(`\n  Detected running OAI config on firecell: ${running}`);

  if (allowKeepCurrent && await confirm('Use current config?', true)) return;

  const duSelection = await choose('Choose DU host:', [
    { name: 'serber-minipc', value: 'minipc' },
    { name: 'serber-pi', value: 'pi' },
    { name: 'serber-jetson', value: 'jetson' },
    { name: 'Custom DU target', value: 'custom' },
  ]);

  const profile = await choose('Choose shared CU/DU F1 config:', [
    { name: 'Ethernet F1', value: 'ethernet' },
    { name: 'Wi-Fi GRE F1', value: 'wifiGre' },
    { name: 'Quectel 5G/WireGuard F1', value: 'quectelWg' },
  ]);

  if (duSelection === 'custom') {
    const firecellIp = await prompt('serber-firecell IP address', firecellAddress() || '10.76.170.38');
    const duLabel = await choose('Custom DU type:', [
      { name: 'serber-minipc-compatible', value: 'serber-minipc' },
      { name: 'serber-pi-compatible', value: 'serber-pi' },
      { name: 'serber-jetson-compatible', value: 'serber-jetson' },
    ]);
    const defaultIp = duLabel === 'serber-pi' ? DEFAULT_PI_IP : duLabel === 'serber-jetson' ? DEFAULT_JETSON_IP : DEFAULT_MINIPC_HOST.split('@').pop();
    const duIp = await prompt(`${duLabel} SSH target or IP address`, defaultIp);
    const runtimeStem = duLabel.replace('serber-', '');
    const runtimeSuffix = runtimeSuffixForBackhaul(profile);
    applyLabConfig({
      label: `custom ${duLabel} + serber-firecell`,
      firecellHost: sshTargetFromAddress(firecellIp),
      duHost: sshTargetFromAddress(duIp),
      duLabel,
      duConfName: `gnb-${runtimeStem}.conf`,
      duRuntimeConf: `/tmp/oai-tui-gnb-${runtimeStem}-${runtimeSuffix}-runtime.conf`,
      cuRuntimeConf: cuRuntimeConfForDu(runtimeStem, profile),
      backhaulProfile: profile,
      jumboFrames: profile === 'ethernet',
      clampMss: true,
    });
  } else {
    applyLabConfig(buildLabConfigForDu(duSelection, profile));
  }

  console.log('\n  Selected config:');
  console.log(`    ${formatLabConfig()}`);
  await prompt('Press Enter to continue');
}

async function mainMenu() {
  while (true) {
    console.clear();
    printHeader('OAI CU/DU Lab Demo Console');
    console.log('\n  Demo targets:');
    console.log(`    Core/CU: ${FIRECELL}`);
    console.log(`    Monolithic reference: ${FIRECELL}`);
    console.log(`    DU/USRP: ${activeLabConfig.duLabel} (${MINIPC}), discovered live at launch`);
    console.log(`    Shared F1 config: ${selectedBackhaulProfile().label}`);
    console.log('\n  The selected CU/DU launch discovers the DU each run. Caged Quectel launch/validation remains evidence-gated.\n');
    const running = await getRunningConfig();
    let statusStr = running;
    if (running === 'none') {
      statusStr = `${GRAY}none${RESET}`;
    } else if (running.startsWith('unknown') || running.startsWith('running')) {
      statusStr = `${YELLOW}${running}${RESET}`;
    } else {
      statusStr = `${GREEN}${BOLD}${running}${RESET}`;
    }
    console.log(`  currently running config: ${statusStr}\n`);
    const action = await choose('What would you like to do?', [
      { name: `Launch selected CU/DU config: ${selectedBackhaulProfile().label} + ${activeLabConfig.duLabel}`, value: 'start-split' },
      { name: 'Change selected DU/config', value: 'change-config' },
      { name: 'Launch monolithic firecell core + gNB', value: 'start-mono' },
      { name: 'Launch caged Quectel F1 backhaul, monolithic donor', value: 'start-caged-quectel' },
      { name: 'Validate caged Quectel F1 backhaul, monolithic donor', value: 'validate-caged-quectel' },
      { name: `Toggle Jumbo Frames MTU 9000 (currently: ${activeLabConfig.jumboFrames ? 'Enabled' : 'Disabled'})`, value: 'toggle-jumbo' },
      { name: `Toggle TCP MSS Clamping (currently: ${activeLabConfig.clampMss ? 'Enabled' : 'Disabled'})`, value: 'toggle-mss' },
      { name: `Toggle Forced Scheduler Tuning (currently: ${activeLabConfig.forceMcs ? 'Enabled' : 'Disabled'})`, value: 'toggle-mcs' },
      { name: 'Change PWS/SIB8 warning text for all TUI configs', value: 'pws' },
      { name: 'View live host/process/core status', value: 'status' },
      { name: 'View recent OAI logs and milestones', value: 'logs' },
      { name: 'Stop the current config', value: 'stop-all' },
      { name: 'Exit', value: 'exit' },
    ]);
    if (action === 'exit') break;
    if (action === 'change-config') {
      await configureLabBeforeMenu({ allowKeepCurrent: false });
      continue;
    }
    if (action === 'toggle-jumbo') {
      activeLabConfig.jumboFrames = !activeLabConfig.jumboFrames;
      continue;
    }
    if (action === 'toggle-mss') {
      activeLabConfig.clampMss = !activeLabConfig.clampMss;
      continue;
    }
    if (action === 'toggle-mcs') {
      activeLabConfig.forceMcs = !activeLabConfig.forceMcs;
      continue;
    }
    if (action === 'start-split') await startEthernetRollback();
    if (action === 'start-mono') await startMonolithic();
    if (action === 'pws') await applyPws();
    if (action === 'status') await statusView();
    if (action === 'logs') await logsView();
    if (action === 'start-caged-quectel') await launchSingleCuQuectelBackhaul();
    if (action === 'validate-caged-quectel') await validateSingleCuQuectelBackhaul();
    if (action === 'stop-all') await stopAllConfigs();
  }
}

const CLI_ACTION_FLAGS = [
  '--doctor',
  '--verify',
  '--start-ethernet',
  '--start-wifi-gre',
  '--start-quectel-wg',
  '--start-mono',
  '--start-caged-quectel',
  '--validate-caged-quectel',
  '--rollback-caged-quectel',
  '--status',
  '--logs',
];

const CLI_EXACT_FLAGS = new Set([
  '--help', '-h',
  ...CLI_ACTION_FLAGS,
  '--pi-ethernet', '--pi-wifi-gre', '--pi-quectel-wg',
  '--minipc-ethernet', '--minipc-wifi-gre', '--minipc-quectel-wg',
  '--jetson-ethernet', '--jetson-wifi-gre', '--jetson-quectel', '--jetson-quectel-wg',
  '--no-jumbo-frames', '--no-clamp-mss', '--force-mcs',
]);

function cliHelp() {
  return `Usage: ./oai-lab [configuration] [action]

Without arguments, opens the interactive operator menu.

Configuration:
  --env=/path/to/lab.env
  --du=serber-minipc|serber-pi|serber-jetson
  --backhaul=ethernet|wifi-gre|quectel-wg
  --pi-ethernet | --pi-wifi-gre | --pi-quectel-wg
  --minipc-ethernet | --minipc-wifi-gre | --minipc-quectel-wg
  --jetson-ethernet | --jetson-wifi-gre | --jetson-quectel-wg
  --no-jumbo-frames  --no-clamp-mss  --force-mcs

Read-only actions:
  --doctor             Check this Mac and environment file; no lab contact
  --status             Show live host, process, and core status
  --logs               Show recent OAI logs and milestones
  --verify             Check SSH/discovery only; contacts configured lab hosts

Mutating actions (require exclusive lab ownership):
  --start-ethernet | --start-wifi-gre | --start-quectel-wg
  --start-mono | --start-caged-quectel | --validate-caged-quectel
  --rollback-caged-quectel

  --help, -h           Show this help and exit

Static checks are not live acceptance. Scenario PASS requires separate evidence
for machine-side F1/RF, phone PWS, registration, PDU session, internet, and throughput.`;
}

function validateCliArgs(args) {
  const unknown = args.filter(arg => !CLI_EXACT_FLAGS.has(arg) && !arg.startsWith('--env=') && !arg.startsWith('--du=') && !arg.startsWith('--backhaul='));
  if (unknown.length) throw new Error(`Unsupported option: ${unknown[0]}. Use --help for supported options.`);
  const actions = CLI_ACTION_FLAGS.filter(flag => args.includes(flag));
  if (actions.length > 1) throw new Error(`Choose exactly one action flag; received: ${actions.join(', ')}`);
  return actions[0] || '';
}

async function doctor() {
  printHeader('OAI Lab Local Doctor');
  let ok = true;
  const nodeMajor = Number(process.versions.node.split('.')[0]);
  if (nodeMajor >= 18) printSuccess(`Node.js ${process.versions.node}`);
  else {
    printError(`Node.js 18 or newer is required; found ${process.versions.node}`);
    ok = false;
  }
  const sshCheck = await execLocal('command -v ssh && ssh -V', 5000);
  if (sshCheck.ok) printSuccess(`OpenSSH available: ${sshCheck.combined.split('\n').at(-1)}`);
  else {
    printError('OpenSSH client not found');
    ok = false;
  }
  if (ENV_FILE_LOADED) {
    printSuccess(`Environment loaded from ${ENV_PATH}`);
    try {
      const mode = statSync(ENV_PATH).mode & 0o777;
      if ((mode & 0o077) !== 0) printWarn(`Environment file permissions are ${mode.toString(8)}; run: chmod 600 ${shellQuote(ENV_PATH)}`);
      else printSuccess(`Environment file permissions are private (${mode.toString(8)})`);
    } catch {
      printWarn('Could not inspect environment file permissions');
    }
  } else {
    printError(`Environment file not found or unreadable: ${ENV_PATH}`);
    printInfo('Copy your private file to conf/local/lab.env, .env, or pass --env=/path/to/lab.env');
    ok = false;
  }
  try {
    mkdirSync(STATE_ROOT, { recursive: true });
    accessSync(STATE_ROOT, fsConstants.W_OK);
    printSuccess(`Private run state is writable: ${STATE_ROOT}`);
  } catch {
    printError(`Private run state is not writable: ${STATE_ROOT}`);
    ok = false;
  }
  for (const [name, value] of [
    ['CU_HOST', FIRECELL],
    ['DU_HOST', MINIPC],
    ['CU_OAI_DIR', CU_OAI],
    ['DU_OAI_DIR', DU_OAI],
  ]) {
    if (value) printSuccess(`${name} is configured`);
    else {
      printError(`${name} is empty`);
      ok = false;
    }
  }
  for (const [name, fallback] of [
    ['MINIPC_HOST', DEFAULT_MINIPC_HOST],
    ['PI_HOST', DEFAULT_PI_HOST],
    ['JETSON_HOST', DEFAULT_JETSON_HOST],
  ]) {
    if (process.env[name]) continue;
    printWarn(`${name} is not set; configuration switching will use the documented fallback ${fallback}`);
  }
  console.log(`\n  Selected configuration:\n    ${formatLabConfig()}`);
  printInfo('No SSH connection or lab mutation was attempted.');
  return ok;
}

async function cli() {
  const args = process.argv.slice(2);
  if (args.includes('--help') || args.includes('-h')) {
    console.log(cliHelp());
    rl.close();
    return;
  }
  const cliAction = validateCliArgs(args);
  const duArg = process.argv.find(arg => arg.startsWith('--du='));
  if (duArg) {
    const value = duArg.split('=')[1];
    const duKey = value?.replace(/^serber-/, '');
    if (!KNOWN_DU_CONFIGS[duKey]) throw new Error(`Unsupported --du value: ${value}. Use serber-minipc, serber-pi, or serber-jetson.`);
    applyLabConfig(buildLabConfigForDu(duKey, activeLabConfig.backhaulProfile));
  }
  const backhaulArg = process.argv.find(arg => arg.startsWith('--backhaul='));
  if (backhaulArg) {
    const value = backhaulArg.split('=')[1];
    const aliases = {
      ethernet: 'ethernet',
      'wifi-gre': 'wifiGre',
      wifiGre: 'wifiGre',
      quectel: 'quectelWg',
      'quectel-wg': 'quectelWg',
      quectelWg: 'quectelWg',
    };
    const profileKey = aliases[value];
    if (!profileKey) throw new Error(`Unsupported --backhaul value: ${value}. Use ethernet, wifi-gre, or quectel-wg.`);
    setActiveBackhaulProfile(profileKey);
  }
  if (process.argv.includes('--pi-ethernet')) {
    applyLabConfig(buildLabConfigForDu('pi', 'ethernet'));
  }
  if (process.argv.includes('--pi-wifi-gre')) {
    applyLabConfig(buildLabConfigForDu('pi', 'wifiGre'));
  }
  if (process.argv.includes('--pi-quectel-wg')) {
    applyLabConfig(buildLabConfigForDu('pi', 'quectelWg'));
  }
  if (process.argv.includes('--minipc-ethernet')) {
    applyLabConfig(buildLabConfigForDu('minipc', 'ethernet'));
  }
  if (process.argv.includes('--jetson-ethernet')) {
    applyLabConfig(buildLabConfigForDu('jetson', 'ethernet'));
  }
  if (process.argv.includes('--minipc-wifi-gre')) {
    applyLabConfig(buildLabConfigForDu('minipc', 'wifiGre'));
  }
  if (process.argv.includes('--minipc-quectel-wg')) {
    applyLabConfig(buildLabConfigForDu('minipc', 'quectelWg'));
  }
  if (process.argv.includes('--jetson-wifi-gre')) {
    applyLabConfig(buildLabConfigForDu('jetson', 'wifiGre'));
  }
  if (process.argv.includes('--jetson-quectel')) {
    applyLabConfig(buildLabConfigForDu('jetson', 'quectelWg'));
  }
  if (process.argv.includes('--jetson-quectel-wg')) {
    applyLabConfig(buildLabConfigForDu('jetson', 'quectelWg'));
  }
  if (process.argv.includes('--no-jumbo-frames')) {
    activeLabConfig.jumboFrames = false;
  }
  if (process.argv.includes('--no-clamp-mss')) {
    activeLabConfig.clampMss = false;
  }
  if (process.argv.includes('--force-mcs')) {
    activeLabConfig.forceMcs = true;
  }
  if (ISOLATED_TEST_MODE && cliAction) {
    console.log(`[isolated-test] dispatch=${cliAction}`);
    console.log('[isolated-test] ssh=mocked prompts=scripted sleeps=mocked external_commands=blocked');
    if (process.env.OAI_TUI_TEST_FAIL_ACTION === '1') {
      printError(`Mocked prerequisite failed for ${cliAction}`);
      printWarn('No PASS claimed.');
      process.exit(1);
    }
    process.exit(0);
  }
  if (process.argv.includes('--doctor')) {
    process.exit(await doctor() ? 0 : 1);
  }
  if (!ENV_FILE_LOADED) {
    throw new Error(`Private environment file is required. Copy it to conf/local/lab.env, .env, or pass --env=/path/to/lab.env. Checked: ${ENV_PATH}`);
  }
  if (process.argv.includes('--verify')) {
    console.clear();
    printHeader('OAI Lab TUI Verification');
    if (!await checkSsh(FIRECELL, 'serber-firecell')) throw new Error('serber-firecell SSH failed');
    const minipc = await discoverMinipcTarget();
    printSuccess(`${activeLabConfig.duLabel}: ${minipc.host}${minipc.mgmtIface ? ` (${minipc.mgmtIface} ${minipc.mgmtIp})` : ''}`);
    process.exit(0);
  }
  if (process.argv.includes('--status')) {
    await statusView();
    process.exit(0);
  }
  if (process.argv.includes('--logs')) {
    await logsView();
    process.exit(0);
  }
  if (!ISOLATED_TEST_MODE) acquireOperatorLock();
  if (process.argv.includes('--start-ethernet')) {
    setActiveBackhaulProfile('ethernet');
    process.exit(await startEthernetRollback() ? 0 : 1);
  }
  if (process.argv.includes('--start-wifi-gre')) {
    setActiveBackhaulProfile('wifiGre');
    process.exit(await startEthernetRollback() ? 0 : 1);
  }
  if (process.argv.includes('--start-quectel-wg')) {
    setActiveBackhaulProfile('quectelWg');
    process.exit(await startEthernetRollback() ? 0 : 1);
  }
  if (process.argv.includes('--start-mono')) {
    process.exit(await startMonolithic() ? 0 : 1);
  }
  if (process.argv.includes('--start-caged-quectel')) {
    process.exit(await launchSingleCuQuectelBackhaul() ? 0 : 1);
  }
  if (process.argv.includes('--validate-caged-quectel')) {
    process.exit(await validateSingleCuQuectelBackhaul() ? 0 : 1);
  }
  if (process.argv.includes('--rollback-caged-quectel')) {
    await stopAllConfigs();
    process.exit(0);
  }
  await configureLabBeforeMenu();
  await mainMenu();
  rl.close();
}

export const tuiTestApi = {
  BACKHAUL_PROFILES,
  KNOWN_DU_CONFIGS,
  analyzeB210ExperimentReadiness,
  buildLabConfigForDu,
  cliHelp,
  close: () => rl.close(),
  maskIpv4ToPrefix,
  parseEnvFile,
  parseQmiSettings,
  parseRouteDevSrc,
  runtimeSuffixForBackhaul,
  sanitizeCapture,
  selectedF1Addresses,
  validateCliArgs,
};

if (process.argv[1] && path.resolve(process.argv[1]) === __filename) {
  cli().catch(async err => {
    printError(err.message);
    rl.close();
    process.exit(1);
  });
}
