#!/usr/bin/env node

import { exec } from 'child_process';
import { createInterface } from 'readline/promises';
import { stdin as input, stdout as output } from 'process';
import { mkdirSync, readFileSync, writeFileSync } from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const REPO = path.resolve(__dirname, '..');
const QUECTEL_SCRIPT_DIR = path.join(REPO, 'scripts', 'quectel-f1-backhaul');

// Load environment variables from conf/local/lab.env if it exists
try {
  const envPath = path.resolve(REPO, 'conf', 'local', 'lab.env');
  const content = readFileSync(envPath, 'utf8');
  content.split(/\r?\n/).forEach(line => {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith('#')) return;
    // Strip inline comments
    let cleanLine = trimmed;
    const commentIdx = trimmed.indexOf('#');
    if (commentIdx >= 0) {
      cleanLine = trimmed.slice(0, commentIdx).trim();
    }
    const idx = cleanLine.indexOf('=');
    if (idx > 0) {
      const key = cleanLine.slice(0, idx).trim();
      let val = cleanLine.slice(idx + 1).trim();
      if ((val.startsWith('"') && val.endsWith('"')) || (val.startsWith("'") && val.endsWith("'"))) {
        val = val.slice(1, -1);
      }
      // Trim quotes/spaces again in case of inline comment separation
      val = val.trim();
      if ((val.startsWith('"') && val.endsWith('"')) || (val.startsWith("'") && val.endsWith("'"))) {
        val = val.slice(1, -1);
      }
      process.env[key] = val;
    }
  });
} catch (err) {
  // ignore if file does not exist or cannot be read
}

